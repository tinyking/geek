---
import '../styles/global.css';
import portraitImg from '../assets/portrait.jpg';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  robots?: string;
  bodyClass?: string;
  noAds?: boolean;
}

const {
  title = '语霖·执笔为语，心落成霖',
  description = '语霖的个人博客 — 记录技术探索、产品思考与生活感悟',
  ogType = 'website',
  ogImage,
  robots = 'index, follow',
  bodyClass = '',
  noAds = false,
} = Astro.props;

const siteName = '语霖·执笔为语，心落成霖';
const authorName = '语霖';
const siteURL = Astro.site ?? new URL('https://www.wangjianchao.cn');
const siteDescription = '语霖的个人博客 — 记录技术探索、产品思考与生活感悟';
const canonicalURL = new URL(Astro.url.pathname, siteURL).href;
const defaultOGImage = new URL('/og/default.svg', siteURL).href;
const finalOGImage = ogImage ?? defaultOGImage;

const isDossier = bodyClass.includes('dossier');
const bodyClasses = isDossier
  ? bodyClass
  : ["min-h-full flex flex-col antialiased", bodyClass].filter(Boolean).join(' ');

// 全站 WebSite 结构化数据（使用固定描述，而非页面级 description）
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteName,
  "url": siteURL.href,
  "inLanguage": "zh-CN",
  "description": siteDescription,
  "publisher": {
    "@type": "Person",
    "name": authorName,
    "url": siteURL.href
  }
};

// 博主 Person 结构化数据
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": authorName,
  "alternateName": "Wang Jianchao",
  "url": siteURL.href,
  "image": new URL(portraitImg.src, siteURL).href,
  "jobTitle": "全栈工程师 / Life OS 架构师",
  "description": siteDescription,
  "sameAs": [
    "https://github.com/tinyking",
    "https://x.com/tinyking86",
    siteURL.href
  ]
};
---
<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="author" content={authorName} />
		<meta name="robots" content={robots} />
		<meta name="theme-color" content="#c13a2b" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="manifest" href="/manifest.json" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="alternate" type="application/rss+xml" title={`${siteName} RSS`} href="/rss.xml" />

		<!-- 字体 preconnect 优化 -->
		<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
		<link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />

		<!-- Dossier fonts (Noto Serif SC / Ma Shan Zheng / IBM Plex Mono) -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/noto-serif-sc@latest/700.css" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/noto-serif-sc@latest/900.css" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/ma-shan-zheng@latest/400.css" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/ibm-plex-mono@latest/400.css" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/ibm-plex-mono@latest/600.css" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/noto-sans-sc@latest/400.css" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/noto-sans-sc@latest/500.css" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/noto-sans-sc@latest/700.css" />

		<!-- Open Graph -->
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="zh_CN" />
		<meta property="og:image" content={finalOGImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={finalOGImage} />

		<title>{title}</title>
		{/* Google AdSense — 首页禁用，其他页面保留 */}
		{!noAds && (
			<script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9508321495212724" crossorigin="anonymous"></script>
		)}

		<!-- JSON-LD: WebSite & Person -->
		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		<slot name="head" />

		<!-- 夜案暗色模式：在首屏绘制前确定主题，避免闪烁 -->
		<script is:inline>
			(function () {
				try {
					var t = localStorage.getItem('theme');
					var root = document.documentElement;
					if (t === 'dark') { root.classList.add('night'); root.classList.remove('light'); }
					else if (t === 'light') { root.classList.add('light'); root.classList.remove('night'); }
					else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) { root.classList.add('night'); }
				} catch (e) {}
			})();
		</script>
	</head>
	<body class={bodyClasses}>
		<slot />

		<!-- 全站代码块一键复制与语言标签增强脚本 -->
		<script is:inline>
			(function() {
				function enhanceCodeBlocks() {
					var preBlocks = document.querySelectorAll('.prose pre, .prose-code');
					preBlocks.forEach(function(pre) {
						if (pre.closest('.code-block-wrapper')) return;

						var codeEl = pre.querySelector('code') || pre;
						var classNames = (codeEl.className || pre.className || '').split(' ');
						
						var lang = 'CODE';
						for (var i = 0; i < classNames.length; i++) {
							var cls = classNames[i];
							if (cls.indexOf('language-') === 0) {
								lang = cls.replace('language-', '').toUpperCase();
								break;
							} else if (cls.indexOf('lang-') === 0) {
								lang = cls.replace('lang-', '').toUpperCase();
								break;
							}
						}

						var langMap = {
							'JS': 'JAVASCRIPT',
							'TS': 'TYPESCRIPT',
							'PY': 'PYTHON',
							'SH': 'BASH',
							'SHELL': 'BASH',
							'MD': 'MARKDOWN',
							'YML': 'YAML'
						};
						lang = langMap[lang] || lang;

						var wrapper = document.createElement('div');
						wrapper.className = 'code-block-wrapper';

						var header = document.createElement('div');
						header.className = 'code-block-header';

						var langSpan = document.createElement('span');
						langSpan.className = 'code-lang';
						langSpan.textContent = lang;

						var copyBtn = document.createElement('button');
						copyBtn.className = 'code-copy-btn';
						copyBtn.type = 'button';
						copyBtn.setAttribute('aria-label', '复制代码内容');
						copyBtn.innerHTML = '<svg viewBox="0 0 24 24"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg><span>复制</span>';

						copyBtn.addEventListener('click', function() {
							var textToCopy = codeEl.innerText || codeEl.textContent || '';
							if (navigator.clipboard && navigator.clipboard.writeText) {
								navigator.clipboard.writeText(textToCopy).then(function() {
									copyBtn.innerHTML = '<span>✅ 已复制</span>';
									setTimeout(function() {
										copyBtn.innerHTML = '<svg viewBox="0 0 24 24"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg><span>复制</span>';
									}, 2000);
								}).catch(function(err) {
									console.error('复制失败:', err);
								});
							} else {
								var textArea = document.createElement('textarea');
								textArea.value = textToCopy;
								document.body.appendChild(textArea);
								textArea.select();
								try {
									document.execCommand('copy');
									copyBtn.innerHTML = '<span>✅ 已复制</span>';
									setTimeout(function() {
										copyBtn.innerHTML = '<svg viewBox="0 0 24 24"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg><span>复制</span>';
									}, 2000);
								} catch (e) {
									console.error('复制失败:', e);
								}
								document.body.removeChild(textArea);
							}
						});

						header.appendChild(langSpan);
						header.appendChild(copyBtn);

						pre.parentNode.insertBefore(wrapper, pre);
						wrapper.appendChild(header);
						wrapper.appendChild(pre);
					});
				}

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', enhanceCodeBlocks);
				} else {
					enhanceCodeBlocks();
				}

				// ==========================================
				// 1. 全站顶部阅读进度条逻辑
				// ==========================================
				function setupReadingProgress() {
					var pb = document.getElementById('global-reading-progress');
					if (!pb) {
						pb = document.createElement('div');
						pb.id = 'global-reading-progress';
						document.body.appendChild(pb);
					}
					
					function updateProgress() {
						var totalHeight = document.documentElement.scrollHeight - window.innerHeight;
						if (totalHeight <= 0) {
							pb.style.width = '0%';
							return;
						}
						var current = window.scrollY || window.pageYOffset;
						var pct = Math.min(100, Math.max(0, (current / totalHeight) * 100));
						pb.style.width = pct + '%';
					}

					window.addEventListener('scroll', updateProgress, { passive: true });
					updateProgress();
				}

				// ==========================================
				// 2. 文章图片点击 Lightbox 放大预览逻辑
				// ==========================================
				function setupLightbox() {
					var images = document.querySelectorAll('.prose img, .article-body img, .article img, article img');
					if (!images || images.length === 0) return;

					var backdrop = document.querySelector('.lightbox-backdrop');
					if (!backdrop) {
						backdrop = document.createElement('div');
						backdrop.className = 'lightbox-backdrop';
						backdrop.innerHTML = '<button class="lightbox-close-btn" type="button" aria-label="关闭预览">&times;</button>' +
							'<div class="lightbox-img-wrapper">' +
								'<img class="lightbox-image" src="" alt="" />' +
								'<div class="lightbox-caption"></div>' +
							'</div>';
						document.body.appendChild(backdrop);
					}

					var imgEl = backdrop.querySelector('.lightbox-image');
					var capEl = backdrop.querySelector('.lightbox-caption');
					var closeBtn = backdrop.querySelector('.lightbox-close-btn');

					function closeLightbox() {
						backdrop.classList.remove('active');
					}

					closeBtn.addEventListener('click', closeLightbox);
					backdrop.addEventListener('click', function(e) {
						if (e.target === backdrop || e.target === closeBtn) {
							closeLightbox();
						}
					});

					document.addEventListener('keydown', function(e) {
						if (e.key === 'Escape' && backdrop.classList.contains('active')) {
							closeLightbox();
						}
					});

					images.forEach(function(img) {
						img.addEventListener('click', function(e) {
							e.stopPropagation();
							var src = img.getAttribute('src');
							if (!src) return;
							var altText = img.getAttribute('alt') || img.getAttribute('title') || '';
							imgEl.src = src;
							imgEl.alt = altText;
							if (altText) {
								capEl.textContent = altText;
								capEl.style.display = 'block';
							} else {
								capEl.style.display = 'none';
							}
							backdrop.classList.add('active');
						});
					});
				}

				// ==========================================
				// 3. 文章 TOC 悬浮目录与高亮监听逻辑
				// ==========================================
				function setupTOC() {
					var articleContainer = document.querySelector('.prose, .article-body, .article');
					if (!articleContainer) return;

					var headings = articleContainer.querySelectorAll('h1, h2, h3, h4, .prose-h2, .prose-h3');
					if (!headings || headings.length < 2) return;

					var tocItems = [];
					headings.forEach(function(heading, idx) {
						if (!heading.id) {
							var cleanText = (heading.textContent || '').trim().replace(/\s+/g, '-').replace(/[^\w\u4e00-\u9fa5\-]/g, '').toLowerCase();
							heading.id = cleanText || ('toc-heading-' + idx);
						}
						var level = 2;
						var tagName = heading.tagName.toLowerCase();
						if (tagName === 'h1') level = 1;
						else if (tagName === 'h2' || heading.classList.contains('prose-h2')) level = 2;
						else if (tagName === 'h3' || heading.classList.contains('prose-h3')) level = 3;
						else if (tagName === 'h4') level = 4;

						var displayText = heading.textContent ? heading.textContent.replace(/^ARTICLE\s*·\s*/i, '').trim() : '';
						if (displayText) {
							tocItems.push({
								id: heading.id,
								text: displayText,
								level: level,
								element: heading
							});
						}
					});

					if (tocItems.length < 2) return;

					// 桌面端 Floating Sidebar
					var sidebar = document.createElement('aside');
					sidebar.className = 'toc-floating-sidebar';
					
					var headerDiv = document.createElement('div');
					headerDiv.className = 'toc-floating-header';
					headerDiv.innerHTML = '<span class="toc-title-badge">目录</span><div style="display:flex;align-items:center;gap:6px;"><span>TOC</span><button class="toc-collapse-btn" type="button" aria-label="收起/展开目录" title="折叠或展开目录">▾</button></div>';

					var collapseBtn = headerDiv.querySelector('.toc-collapse-btn');
					if (collapseBtn) {
						collapseBtn.addEventListener('click', function() {
							sidebar.classList.toggle('is-collapsed');
						});
					}

					var ul = document.createElement('ul');
					ul.className = 'toc-list';

					tocItems.forEach(function(item) {
						var li = document.createElement('li');
						li.className = 'toc-item level-' + item.level;

						var a = document.createElement('a');
						a.className = 'toc-link';
						a.href = '#' + item.id;
						a.textContent = item.text;
						a.setAttribute('data-target-id', item.id);

						a.addEventListener('click', function(e) {
							e.preventDefault();
							var targetEl = document.getElementById(item.id);
							if (targetEl) {
								targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
								if (window.history && window.history.pushState) {
									window.history.pushState(null, '', '#' + item.id);
								}
							}
						});

						li.appendChild(a);
						ul.appendChild(li);
					});

					sidebar.appendChild(headerDiv);
					sidebar.appendChild(ul);
					document.body.appendChild(sidebar);

					// 移动端 FAB 悬浮按钮 + Drawer 抽屉
					var mobileFab = document.createElement('button');
					mobileFab.className = 'toc-mobile-fab';
					mobileFab.type = 'button';
					mobileFab.innerHTML = '<span>📖 目录</span>';

					var mobileDrawer = document.createElement('div');
					mobileDrawer.className = 'toc-mobile-drawer';
					mobileDrawer.innerHTML = '<div class="toc-mobile-panel">' +
						'<div class="toc-floating-header" style="margin-bottom:16px;">' +
							'<span class="toc-title-badge">文章目录</span>' +
							'<button class="close-mobile-toc" type="button" style="background:none;border:none;font-size:20px;cursor:pointer;color:#171310;">&times;</button>' +
						'</div>' +
						'<div class="toc-mobile-list-container"></div>' +
					'</div>';

					var mobileListContainer = mobileDrawer.querySelector('.toc-mobile-list-container');
					var mobileUl = ul.cloneNode(true);
					
					mobileUl.querySelectorAll('a.toc-link').forEach(function(a) {
						var id = a.getAttribute('data-target-id');
						a.addEventListener('click', function(e) {
							e.preventDefault();
							mobileDrawer.classList.remove('open');
							var targetEl = document.getElementById(id);
							if (targetEl) {
								targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
							}
						});
					});

					mobileListContainer.appendChild(mobileUl);
					document.body.appendChild(mobileFab);
					document.body.appendChild(mobileDrawer);

					mobileFab.addEventListener('click', function() {
						mobileDrawer.classList.add('open');
					});
					var closeBtn = mobileDrawer.querySelector('.close-mobile-toc');
					if (closeBtn) {
						closeBtn.addEventListener('click', function() {
							mobileDrawer.classList.remove('open');
						});
					}
					mobileDrawer.addEventListener('click', function(e) {
						if (e.target === mobileDrawer) {
							mobileDrawer.classList.remove('open');
						}
					});

					// 4. 滚动高亮 IntersectionObserver
					if ('IntersectionObserver' in window) {
						var currentActiveId = '';
						function setActiveLink(id) {
							if (!id || id === currentActiveId) return;
							currentActiveId = id;
							document.querySelectorAll('.toc-link').forEach(function(link) {
								if (link.getAttribute('data-target-id') === id) {
									link.classList.add('active');
								} else {
									link.classList.remove('active');
								}
							});
						}

						var observer = new IntersectionObserver(function(entries) {
							entries.forEach(function(entry) {
								if (entry.isIntersecting) {
									setActiveLink(entry.target.id);
								}
							});
						}, { rootMargin: '-10% 0px -70% 0px', threshold: 0 });

						tocItems.forEach(function(item) {
							observer.observe(item.element);
						});
					}
				}

		setupReadingProgress();
		setupLightbox();
		setupTOC();
		})();
	</script>

	<!-- 夜案暗色模式：手动切换 + 跟随系统（仅当用户未手动选择时） -->
	<script is:inline>
		(function () {
			var root = document.documentElement;
			function apply(theme) {
				if (theme === 'dark') { root.classList.add('night'); root.classList.remove('light'); }
				else { root.classList.add('light'); root.classList.remove('night'); }
				try { localStorage.setItem('theme', theme); } catch (e) {}
			}
			function toggle() {
				apply(root.classList.contains('night') ? 'light' : 'dark');
			}
			document.querySelectorAll('.theme-toggle').forEach(function (btn) {
				btn.addEventListener('click', toggle);
			});
			if (window.matchMedia) {
				var mq = window.matchMedia('(prefers-color-scheme: dark)');
				var onChange = function (e) {
					try { if (localStorage.getItem('theme')) return; } catch (err) {}
					if (e.matches) { root.classList.add('night'); root.classList.remove('light'); }
					else { root.classList.add('light'); root.classList.remove('night'); }
				};
				if (mq.addEventListener) mq.addEventListener('change', onChange);
				else if (mq.addListener) mq.addListener(onChange);
			}
		})();
	</script>
	</body>
</html>
