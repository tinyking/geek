---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DossierTopbar from '../../components/DossierTopbar.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const tagSet = new Set<string>();
  for (const post of posts) {
    for (const tag of post.data.tags) tagSet.add(tag);
  }
  return [...tagSet].map((tag) => {
    const matched = posts
      .filter((p) => p.data.tags.includes(tag))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
    return {
      params: { tag },
      props: { tag, posts: matched },
    };
  });
}

interface Props {
  tag: string;
  posts: Awaited<ReturnType<typeof getCollection<'posts'>>>;
}
const { tag, posts } = Astro.props;

const siteBase = Astro.site ?? new URL('https://www.wangjianchao.cn');
const canonicalURL = new URL(Astro.url.pathname, siteBase).href;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "首页", "item": siteBase.href },
    { "@type": "ListItem", "position": 2, "name": "标签索引", "item": new URL('/tags', siteBase).href },
    { "@type": "ListItem", "position": 3, "name": `#${tag}`, "item": canonicalURL },
  ],
};

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `标签：${tag}`,
  "description": `标签「${tag}」下的全部文章，共 ${posts.length} 篇。`,
  "url": canonicalURL,
  "inLanguage": "zh-CN",
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": posts.length,
    "itemListElement": posts.map((post, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": post.data.title,
      "url": new URL(`/posts/${post.id}`, siteBase).href,
    })),
  },
};
---

<BaseLayout
  title={`#${tag} | 语霖·执笔为语，心落成霖`}
  description={`标签「${tag}」下的全部文章，共 ${posts.length} 篇。`}
  bodyClass="dossier"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  </Fragment>

  <div class="grid-bg"></div>
  <div class="noise"></div>
  <div class="wm"><span class="a">又</span><span class="b">见</span></div>

  <DossierTopbar fileNo="TAG" />

  <main class="dossier-main">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="面包屑导航">
        <ol class="breadcrumb-list">
          <li><a href="/">首页</a></li>
          <li class="sep">/</li>
          <li><a href="/tags">标签索引</a></li>
          <li class="sep">/</li>
          <li class="active" aria-current="page">#{tag}</li>
        </ol>
      </nav>

      <header class="page-head">
        <div class="stamp">TAG · 标签</div>
        <h1 class="page-title">#{tag}</h1>
        <div class="rule"></div>
        <p class="page-sub">共 <b>{posts.length}</b> 篇文章，按时间倒序排列</p>
      </header>

      <div class="folder-list">
        {posts.map((post, i) => (
          <a class="folder" href={`/posts/${post.id}`}>
            <div class="folder-no">NO. {String(i + 1).padStart(3, '0')}</div>
            <div class="folder-body">
              <div class="folder-meta">
                <time>{post.data.date.toLocaleDateString('zh-CN')}</time>
                <span class="sep">·</span>
                <span>{post.data.readingTime} 分钟阅读</span>
              </div>
              <h2 class="folder-title">{post.data.title}</h2>
              <p class="folder-excerpt">{post.data.excerpt}</p>
              <div class="folder-tags">
                {post.data.tags.map((t) => (
                  <a class="tag" href={`/tags/${encodeURIComponent(t)}`}>{t}</a>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>

  <style is:global>
    .breadcrumb-nav {
      margin-bottom: 24px;
      font-family: var(--los-mono, 'IBM Plex Mono', monospace);
      font-size: 13px;
    }
    .breadcrumb-list {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      list-style: none;
      padding: 0;
      margin: 0;
      color: var(--text-secondary, #6b6b6b);
    }
    .breadcrumb-list a {
      color: var(--ink, #171310);
      text-decoration: none;
      transition: color 0.2s;
    }
    .breadcrumb-list a:hover {
      color: var(--red, #c13a2b);
      text-decoration: underline;
    }
    .breadcrumb-list .sep { color: var(--border, #c9bea3); }
    .breadcrumb-list .active { color: var(--red, #c13a2b); font-weight: 600; }

    .grid-bg {
      background-image:
        linear-gradient(to right, rgba(27,19,16,.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(27,19,16,.04) 1px, transparent 1px);
      background-size: 48px 48px;
    }
    .noise {
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='180' height='180' filter='url(%23n)'/></svg>");
      opacity: .06;
      mix-blend-mode: multiply;
    }
    .grid-bg, .noise, .wm { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
    .wm { overflow: hidden; }
    .wm span {
      position: absolute;
      font-family: 'Noto Serif SC', serif;
      font-weight: 900;
      font-size: 46vw;
      color: transparent;
      -webkit-text-stroke: 1.5px rgba(27,19,16,.06);
      user-select: none;
      line-height: .8;
    }
    .wm .a { top: -12%; left: -7%; }
    .wm .b { bottom: -22%; right: -9%; }

    .dossier-main {
      position: relative;
      z-index: 1;
      padding: 56px 24px 100px;
    }
    .container {
      width: min(880px, 100%);
      margin: 0 auto;
    }

    .page-head { margin-bottom: 48px; }
    .stamp {
      display: inline-block;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      letter-spacing: 3px;
      padding: 5px 12px;
      background: var(--ink);
      color: var(--paper);
      border-radius: 2px;
      margin-bottom: 20px;
      transform: rotate(-1deg);
    }
    .page-title {
      font-family: 'Noto Serif SC', serif;
      font-weight: 900;
      font-size: clamp(32px, 5vw, 48px);
      letter-spacing: 2px;
      color: var(--ink);
      line-height: 1.2;
      margin-bottom: 16px;
    }
    .rule {
      width: 60px;
      height: 3px;
      background: var(--red);
      margin-bottom: 16px;
    }
    .page-sub {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12px;
      letter-spacing: .1em;
      color: var(--text-secondary);
    }
    .page-sub b { color: var(--red); font-weight: 700; }

    .folder-list {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    .folder {
      display: block;
      text-decoration: none;
      color: inherit;
      background: var(--paper-3);
      border: 1.5px solid var(--ink);
      box-shadow: 6px 6px 0 var(--ink);
      padding: 24px 28px;
      position: relative;
      transition: transform .2s, box-shadow .2s;
    }
    .folder:hover {
      transform: translate(-3px, -3px);
      box-shadow: 9px 9px 0 var(--red);
    }
    .folder-no {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      letter-spacing: .15em;
      color: var(--text-secondary);
      margin-bottom: 12px;
    }
    .folder-meta {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      color: var(--text-secondary);
      margin-bottom: 10px;
      letter-spacing: .05em;
    }
    .folder-meta .sep { margin: 0 8px; }
    .folder-title {
      font-family: 'Noto Serif SC', serif;
      font-weight: 700;
      font-size: 22px;
      color: var(--ink);
      line-height: 1.35;
      margin-bottom: 10px;
    }
    .folder-excerpt {
      font-size: 14px;
      color: var(--text-secondary);
      line-height: 1.7;
      margin-bottom: 14px;
    }
    .folder-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .tag {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      letter-spacing: .1em;
      color: var(--ink-2);
      background: var(--paper-2);
      border: 1px solid var(--border);
      padding: 3px 8px;
      text-transform: uppercase;
      text-decoration: none;
      transition: all .15s;
    }
    .tag:hover {
      background: var(--ink);
      color: var(--paper);
      border-color: var(--ink);
    }
  </style>
</BaseLayout>
