</style>

<script>
(function () {
  'use strict';

  // 阅读进度线
  var pb = document.getElementById('pb');
  if (pb) {
    var onScroll = function () {
      var h = document.documentElement;
      var denom = h.scrollHeight - h.clientHeight;
      pb.style.width = (denom > 0 ? (h.scrollTop / denom) * 100 : 0) + '%';
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // 显现动画 + 宣言动画
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.15 });
  document.querySelectorAll('.rv,.manifesto').forEach(function (el) { io.observe(el); });

  // 目录轨 scrollspy
  var secs = Array.prototype.slice.call(document.querySelectorAll('section[id]'));
  var rails = Array.prototype.slice.call(document.querySelectorAll('.rail a'));
  function spy() {
    var y = scrollY + innerHeight * 0.4;
    var cur = secs.length ? secs[0].id : '';
    secs.forEach(function (s) { if (s.offsetTop <= y) cur = s.id; });
    rails.forEach(function (a) {
      a.classList.toggle('on', a.getAttribute('href') === '#' + cur);
    });
  }
  addEventListener('scroll', spy, { passive: true });
  spy();

  // 公众号二维码弹窗（保留原交互）
  var wechatBtn = document.getElementById('wechatColBtn');
  var qrOverlay = document.getElementById('qrOverlay');
  var qrClose = document.getElementById('qrClose');
  if (qrOverlay) {
    var openQr = function () {
      qrOverlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    };
    var closeQr = function () {
      qrOverlay.classList.remove('open');
      document.body.style.overflow = '';
    };
    if (wechatBtn) wechatBtn.addEventListener('click', function (e) { e.preventDefault(); openQr(); });
    if (qrClose) qrClose.addEventListener('click', closeQr);
    qrOverlay.addEventListener('click', function (e) { if (e.target === qrOverlay) closeQr(); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && qrOverlay.classList.contains('open')) closeQr();
    });
  }
})();
</script>
