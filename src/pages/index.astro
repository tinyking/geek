---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SERIES, STATUS_CLASS } from '../data/series';

// 跨系列按日期倒序的扁平文章流，还原 #007/#006/#005 那种单卷连续节奏
const flatArticles = SERIES.flatMap((s) =>
  s.articles.map((a) => ({
    series: s,
    article: a,
    date: a.date.replace(/\./g, '-')
  }))
).sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0));

const STATUS_EN: Record<string, string> = {
  '连载中': 'ONGOING',
  '已完结': 'COMPLETED',
  '不定期更新': 'IRREGULAR'
};
---

<BaseLayout
  title="语霖 · 人生 Debug · 把人生当程序，重构一次"
  description="一个 40 岁程序员重新设计人生系统的长期实验。用工程思维审视职业、认知与成长，在 AI 时代寻找第二增长曲线。"
  bodyClass="dossier dossier-home"
>
  <!-- 阅读进度线 -->
  <div id="pb"></div>

  <!-- 章节目录轨 -->
  <aside class="rail">
    <a href="#hero" data-sec="hero">00</a>
    <a href="#origin" data-sec="origin">01</a>
    <a href="#research" data-sec="research">02</a>
    <a href="#system" data-sec="system">03</a>
    <a href="#projects" data-sec="projects">04</a>
    <a href="#about" data-sec="about">05</a>
  </aside>

  <!-- 页眉 -->
  <header class="topbar-home">
    <div class="wrap bar">
      <a class="brand" href="#hero">
        <span class="seal-s">语</span>
        <span class="brand-name">语霖</span>
      </a>
      <nav>
        <a href="#research">研究</a>
        <a href="#system">系统</a>
        <a href="#projects">项目</a>
        <a href="#about">关于</a>
      </nav>
    </div>
  </header>

  <main>
    <!-- ============ 00 HERO ============ -->
    <section class="hero wrap" id="hero">
      <div class="kicker">LIFE OS · V1.0 — <b>RUNNING</b> — BEIJING · UPTIME 40Y</div>
      <h1>把人生当程序，<br>重构一次<span class="dot">。</span></h1>
      <p class="lede">一个 40 岁程序员重新设计人生系统的长期实验。用工程思维，重新审视职业、认知、成长和个人价值，在 AI 时代寻找第二增长曲线。</p>
      <div class="cta-row">
        <a class="cta" href="#origin">开始阅读</a>
        <span class="scroll-hint">SCROLL — 01 / 起源</span>
      </div>
      <aside class="side">
        <div class="vertical">执笔为语 · 心落成霖</div>
        <div class="seal-square" role="img" aria-label="语霖之印">
          <span>语</span><span>霖</span><span>之</span><span>印</span>
        </div>
      </aside>
    </section>

    <!-- 数据读出条 -->
    <div class="wrap readout rv">
      <div><b>20</b><span>年工程经验</span></div>
      <div><b>17</b><span>篇 DEBUG 日志</span></div>
      <div><b>13</b><span>个认知模型</span></div>
      <div><b>02</b><span>套运行系统</span></div>
    </div>

    <!-- ============ 01 起源 ============ -->
    <section id="origin">
      <div class="wrap">
        <div class="ch-head">
          <span class="ch-no">01</span>
          <h2>起源</h2>
          <span class="ch-en">ORIGIN</span>
          <i class="ch-line"></i>
        </div>
        <div class="origin-grid">
          <aside class="o-note">中年不是危机，是一次重构</aside>
          <div class="manifesto">
            <p class="m-lead"><span>为什么开始 <em>Debug</em> 自己的人生？</span></p>
            <p class="m-body"><span>过去 20 年，我一直相信：只要技术足够强，问题就可以解决。后来我发现：代码可以重构，系统可以优化，但人生也存在大量<em>历史遗留问题</em>——职业瓶颈、能力错配、认知限制、环境变化。这些问题不会因为技术强就自动消失。所以我开始了一场人生 Debug。</span></p>
            <p class="m-core"><span>寻找问题。分析原因。<br>建立模型。持续迭代。</span></p>
            <p class="m-tail"><span>不装，不卷，不内耗。只走自己的路，守自己的山。</span></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 02 写作专栏 ============ -->
    <section id="research">
      <div class="wrap">
        <div class="ch-head">
          <span class="ch-no">02</span>
          <h2>写作专栏</h2>
          <span class="ch-en">SERIES</span>
          <i class="ch-line"></i>
        </div>
        <div class="split">
          <div class="left rv">
            <h3>不是文章分类，<br>是<em>持续连载的专栏</em>。</h3>
            <p>三个长期专栏，分别用 Debug、考据、共读三种方式，把人生当作系统来研究。已更新 {flatArticles.length} 篇，仍在连载。</p>
            <div class="series-meta-sum">
              <span><b>{SERIES.length}</b>专栏</span>
              <span><b>{flatArticles.length}</b>篇</span>
              <span><b class="on">连载中</b></span>
            </div>
          </div>
          <div class="right">
            {SERIES.map((s, i) => {
              const stampClass = STATUS_CLASS[s.status] || 'run';
              const statusEn = STATUS_EN[s.status] || 'ONGOING';
              const latest = s.articles[s.articles.length - 1];
              return (
                <a class="r-item rv series-card" href={`/series/${s.id}`}>
                  <div class="r-top">
                    <span class="r-no">{String(i + 1).padStart(2, '0')}</span>
                    <h4>{s.title}</h4>
                    <span class={`r-stamp ${stampClass}`}>{s.status}</span>
                    <span class="r-pct">{s.articles.length}<small>篇</small></span>
                  </div>
                  <p>{s.desc}</p>
                  <div class="r-foot">
                    <span class="r-latest">
                      <i>最新</i>
                      <b>#{latest.no}</b>
                      <em>{latest.title}</em>
                    </span>
                    <span class="r-latest-date">{latest.date}</span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 03 我的系统 ============ -->
    <section id="system">
      <div class="wrap">
        <div class="ch-head">
          <span class="ch-no">03</span>
          <h2>我的系统</h2>
          <span class="ch-en">LIFE OS / CMS</span>
          <i class="ch-line"></i>
        </div>
        <p class="pipe-title" style="margin-top:0">人生操作系统 · <em>每天在运行</em></p>
        <div class="sys-grid rv">
          <div class="sys"><div class="no">SYS.01</div><h4>认知系统</h4><p>抓主要矛盾，对抗一地鸡毛</p></div>
          <div class="sys"><div class="no">SYS.02</div><h4>输入系统</h4><p>信息捕获、过滤与分级</p></div>
          <div class="sys"><div class="no">SYS.03</div><h4>输出系统</h4><p>写作与表达、内容发布</p></div>
          <div class="sys"><div class="no">SYS.04</div><h4>行动系统</h4><p>每天挖一箕土，山总会矮一点</p></div>
          <div class="sys"><div class="no">SYS.05</div><h4>复盘系统</h4><p>逐日誊抄，按周归档</p></div>
          <div class="sys"><div class="no">SYS.06</div><h4>成长系统</h4><p>模型孵化，系统迭代</p></div>
        </div>
        <p class="pipe-title">CMS 知识管理 · <em>八层流转</em></p>
        <div class="pipe rv">
          <span><b>00</b><i>Inbox</i><small>原始捕获</small></span><em>→</em>
          <span><b>10</b><i>Journal</i><small>每日观察</small></span><em>→</em>
          <span><b>20</b><i>Models</i><small>认知模型</small></span><em>→</em>
          <span><b>30</b><i>Systems</i><small>可执行系统</small></span><em>→</em>
          <span><b>40</b><i>Radar</i><small>环境扫描</small></span><em>→</em>
          <span><b>50</b><i>Domains</i><small>长期主题</small></span><em>→</em>
          <span><b>60</b><i>Content</i><small>知识发布</small></span>
        </div>
        <div class="link-line rv"><a href="#projects">深入了解 CMS 方法论 →</a></div>
      </div>
    </section>

    <!-- ============ 04 项目 ============ -->
    <section id="projects">
      <div class="wrap">
        <div class="ch-head">
          <span class="ch-no">04</span>
          <h2>项目作品</h2>
          <span class="ch-en">BUILDS</span>
          <i class="ch-line"></i>
        </div>
        <div class="proj rv">
          <div class="p-text">
            <div class="p-kick">PRJ.01 — KNOWLEDGE</div>
            <h3>CMS · 认知建模系统</h3>
            <p>一套基于 Obsidian 的个人知识管理系统。从原始捕获到知识发布，八层流转，让零散信息变成可复用的认知资产。已运行半年，产出 17 篇文章、13 个认知模型、2 套可执行系统。</p>
            <div class="p-tags">OBSIDIAN / MARKDOWN / GIT</div>
            <a href="#system">了解 CMS 方法论 →</a>
          </div>
          <div class="fig">
            <div class="fig-bar">FIG.01 — CMS KNOWLEDGE PIPELINE</div>
            <div class="fig-body">
              <div class="mini-pipe"><span>00</span><i></i><span>20</span><i></i><span>30</span><i></i><span>60</span></div>
            </div>
          </div>
        </div>
        <div class="proj alt rv">
          <div class="p-text">
            <div class="p-kick">PRJ.02 — WEB</div>
            <h3>个人品牌官网</h3>
            <p>从「程序员博客」升级为「人生系统实验室」。用工程思维设计信息架构，让网站成为个人思想的公开展示层。内容与 CMS 知识系统直接打通。</p>
            <div class="p-tags">ASTRO / TAILWIND / MDX / VERCEL</div>
            <a href="#hero">查看网站 →</a>
          </div>
          <div class="fig">
            <div class="fig-bar">FIG.02 — WANGJIANCHAO.CN</div>
            <div class="fig-body">
              <div class="web-sk">
                <div class="sk sk1"></div>
                <div class="sk sk2"></div>
                <div class="sk sk3"></div>
                <div class="sk sk4"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 05 关于 ============ -->
    <section id="about">
      <div class="wrap">
        <div class="ch-head">
          <span class="ch-no">05</span>
          <h2>关于我</h2>
          <span class="ch-en">STORY</span>
          <i class="ch-line"></i>
        </div>
        <div class="tl">
          <div class="tl-item rv">
            <span class="t-v">v1.0</span><span class="t-stage">过去 · PAST</span>
            <h3>20 年技术经历</h3>
            <p>从一行 Java 代码写起，做过计费、风控等核心系统，带过团队，主导过传统企业数字化转型。见过不少「赋能闭环」，也开过不少没有结论的会。</p>
          </div>
          <div class="tl-item rv">
            <span class="t-v">v2.0</span><span class="t-stage">转折 · TURN</span>
            <h3>发现技术之外的问题</h3>
            <p>人到中年，发现技术强并不能解决所有问题。职业瓶颈、能力错配、认知限制——这些是人生的技术债，不会因为代码写得好就消失。</p>
          </div>
          <div class="tl-item rv">
            <span class="t-v">v3.0</span><span class="t-stage">现在 · NOW</span>
            <h3>研究技术人的长期成长</h3>
            <p>重读毛选学战略思维，认真学 AI 当倍增器，用 CMS 管理认知资产，写「人生 Debug」记录清醒与笨拙。在公众号和这个网站上持续输出。</p>
          </div>
          <div class="tl-item rv">
            <span class="t-v">v4.0</span><span class="t-stage">未来 · NEXT</span>
            <h3>建立技术人的人生操作系统</h3>
            <p>把个人经验沉淀成可复用的模型、系统和方法论，帮助更多 35-45 岁的技术人找到第二增长曲线。前途是光明的，道路是曲折的，但每天挖一箕土，山总会矮一点。</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- 落款 -->
  <footer class="end-footer">
    <div class="wrap end">
      <div class="seal-square seal-lg" role="img" aria-label="语霖之印">
        <span>语</span><span>霖</span><span>之</span><span>印</span>
      </div>
      <p class="f-motto">执笔为语 · 心落成霖</p>
      <div class="f-meta">
        <span>© 2026 语霖 · WANGJIANCHAO.CN</span>
        <a href="#hero">回到卷首 ↑</a>
      </div>
    </div>
  </footer>

  <!-- 公众号二维码弹窗 -->
  <div class="qr-overlay" id="qrOverlay" role="dialog" aria-modal="true" aria-label="公众号二维码">
    <div class="qr-card">
      <button class="qr-close" id="qrClose" aria-label="关闭">×</button>
      <div class="qr-title">公众号 · 语霖</div>
      <img class="qr-img" src="/images/wechat-qr.jpg" alt="公众号二维码" width="240" height="240" />
      <div class="qr-tip">扫一扫，关注这个还在中年突围的普通人</div>
    </div>
  </div>
</BaseLayout>

<style is:global>
/* ===========================================================
   首页 Life OS · 编辑风格（页面特有样式）
   共享设计系统（tokens / topbar / 印章 / 章头 / 落款 / 动画）
   已移至 src/styles/global.css 的 body.dossier-home 作用域，
   供首页与系列详情页等共用。
   依赖 body.dossier 的 token：--paper / --paper-2 / --paper-3
   --ink / --ink-soft / --red / --red-deep / --line / --hard
   字体由 BaseLayout 全局注入，不再重复声明。
   =========================================================== */

/* ---------- 目录轨（首页专用） ---------- */
body.dossier-home .rail {
  position: fixed; right: 26px; top: 50%;
  transform: translateY(-50%);
  display: flex; flex-direction: column; gap: 16px;
  z-index: 90;
}
body.dossier-home .rail a {
  font-family: var(--los-mono);
  font-size: 10px; letter-spacing: .2em;
  color: var(--los-ink2);
  transition: color .3s;
  position: relative;
}
body.dossier-home .rail a.on { color: var(--los-seal); }
body.dossier-home .rail a.on::before {
  content: ""; position: absolute;
  right: calc(100% + 8px); top: 50%;
  width: 14px; height: 1px; background: var(--los-seal);
}
@media (max-width: 1100px) { body.dossier-home .rail { display: none; } }

/* ---------- 00 Hero ---------- */
body.dossier-home .hero { position: relative; padding: 110px 0 120px; }
body.dossier-home .kicker {
  font-family: var(--los-mono);
  font-size: 11px; letter-spacing: .45em;
  text-transform: uppercase;
  color: var(--los-ink2);
  margin-bottom: 44px;
}
body.dossier-home .kicker b { color: var(--los-seal); font-weight: 500; }
body.dossier-home h1 {
  font-family: var(--los-serif);
  font-size: clamp(44px, 7.6vw, 104px);
  font-weight: 900; line-height: 1.18;
  letter-spacing: .015em;
  color: var(--los-ink);
}
body.dossier-home h1 .dot { color: var(--los-seal); }
body.dossier-home .lede {
  max-width: 640px;
  margin-top: 44px;
  font-size: 17px; line-height: 2.1;
  color: var(--los-ink2);
}
body.dossier-home .cta-row {
  display: flex; align-items: center; gap: 40px;
  margin-top: 64px; flex-wrap: wrap;
}
body.dossier-home .cta {
  display: inline-block;
  padding: 16px 46px;
  border: 1px solid var(--los-ink);
  font-size: 15px; letter-spacing: .3em;
  color: var(--los-ink);
  transition: background .35s, border-color .35s, color .35s;
}
body.dossier-home .cta:hover {
  background: var(--los-seal);
  border-color: var(--los-seal);
  color: var(--los-paper);
}
body.dossier-home .scroll-hint {
  font-family: var(--los-mono);
  font-size: 11px; letter-spacing: .35em;
  color: var(--los-ink2);
}
body.dossier-home .side {
  position: absolute; right: 32px; top: 110px;
  display: flex; flex-direction: column; align-items: center; gap: 30px;
}
body.dossier-home .vertical {
  writing-mode: vertical-rl;
  letter-spacing: .6em;
  font-size: 14px; color: var(--los-ink2);
  border-right: 1px solid var(--los-line);
  padding-right: 22px;
  height: 300px;
}
@media (max-width: 900px) { body.dossier-home .side { display: none; } }

body.dossier-home .readout {
  border-top: 1px solid var(--los-line);
  border-bottom: 1px solid var(--los-line);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}
body.dossier-home .readout div {
  padding: 30px 8px; text-align: center;
  border-left: 1px solid var(--los-line);
}
body.dossier-home .readout div:first-child { border-left: none; }
body.dossier-home .readout b {
  display: block;
  font-family: var(--los-mono);
  font-size: 30px; font-weight: 500;
  color: var(--los-ink);
}
body.dossier-home .readout span {
  font-size: 11px; letter-spacing: .3em;
  color: var(--los-ink2);
}
@media (max-width: 860px) {
  body.dossier-home .readout { grid-template-columns: 1fr 1fr; }
  body.dossier-home .readout div { border-top: 1px solid var(--los-line); }
  body.dossier-home .readout div:nth-child(-n+2) { border-top: none; }
  body.dossier-home .readout div:nth-child(3) { border-left: none; }
}

/* ---------- 01 起源 · 宣言体 ---------- */
body.dossier-home #origin { padding: 120px 0 110px; }
body.dossier-home .origin-grid {
  display: grid;
  grid-template-columns: 1fr 3.2fr;
  gap: 64px;
}
body.dossier-home .o-note {
  writing-mode: vertical-rl;
  letter-spacing: .5em;
  font-size: 12px;
  color: var(--los-ink2);
  border-right: 1px solid var(--los-line);
  padding-right: 18px;
  height: 250px;
}
body.dossier-home .manifesto { max-width: 700px; }
body.dossier-home .manifesto p { overflow: hidden; }
body.dossier-home .manifesto p > span {
  display: block;
  transform: translateY(112%);
  transition: transform .9s cubic-bezier(.2, .7, .2, 1);
}
body.dossier-home .manifesto.in p > span { transform: none; }
body.dossier-home .manifesto p:nth-child(2) > span { transition-delay: .12s; }
body.dossier-home .manifesto p:nth-child(3) > span { transition-delay: .24s; }
body.dossier-home .manifesto p:nth-child(4) > span { transition-delay: .36s; }
body.dossier-home .m-lead {
  font-family: var(--los-serif);
  font-size: clamp(22px, 3vw, 32px);
  font-weight: 900; line-height: 1.9;
  margin-bottom: 1.2em;
  color: var(--los-ink);
}
body.dossier-home .m-body {
  font-size: 16px; font-weight: 400;
  color: var(--los-ink2); line-height: 2.25;
  margin-bottom: 1.7em;
}
body.dossier-home .m-core {
  font-family: var(--los-serif);
  font-size: clamp(20px, 2.6vw, 30px);
  font-weight: 900; line-height: 1.9;
  letter-spacing: .02em;
  margin-bottom: 1.7em;
  color: var(--los-ink);
}
body.dossier-home .m-tail {
  font-size: 14px; color: var(--los-ink2);
  letter-spacing: .12em; line-height: 2;
  border-left: 2px solid var(--los-seal);
  padding-left: 16px;
}
@media (max-width: 820px) {
  body.dossier-home .origin-grid { grid-template-columns: 1fr; gap: 28px; }
  body.dossier-home .o-note {
    writing-mode: horizontal-tb; height: auto;
    border-right: none; border-bottom: 1px solid var(--los-line);
    padding: 0 0 12px;
  }
}

/* ---------- 02 研究领域 · sticky 双栏 ---------- */
body.dossier-home #research { padding: 120px 0; }
body.dossier-home .split {
  display: grid;
  grid-template-columns: 5fr 7fr;
  gap: 72px;
}
body.dossier-home .split .left {
  position: sticky; top: 120px; align-self: start;
}
body.dossier-home .split .left h3 {
  font-family: var(--los-serif);
  font-size: clamp(26px, 3.4vw, 40px);
  font-weight: 900; line-height: 1.5;
  margin-bottom: 20px;
  color: var(--los-ink);
}
body.dossier-home .split .left p { color: var(--los-ink2); }

/* 左侧汇总 */
body.dossier-home .series-meta-sum {
  margin-top: 28px;
  display: flex; flex-wrap: wrap; gap: 22px;
  font-family: var(--los-mono);
  font-size: 11px; letter-spacing: .18em;
  color: var(--los-ink2);
