---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="个人身份档案 · PERSONAL DOSSIER" description="一份可实时编辑的个人身份档案 — 封面、陈述、技能矩阵、项目卷宗、履历年表与传讯。" bodyClass="dossier">
  <div class="grid-bg"></div>
  <div class="noise"></div>
  <div class="wm"><span class="a">档</span><span class="b">案</span></div>

  <div class="app">

    <!-- TOPBAR -->
    <header class="topbar">
      <div class="topbar-in">
        <div class="logo">档</div>
        <div class="brand">
          <b>个人身份档案</b>
          <small>PERSONAL DOSSIER</small>
        </div>
        <div class="topbar-right">
          <span class="meta"><span class="dot"></span><span id="statusTop">在册</span></span>
          <span class="meta" id="dossierNo">NO. ——</span>
          <span class="meta" id="today">——</span>
        </div>
      </div>
    </header>

    <!-- SIDE NAV -->
    <nav class="side-nav" id="sideNav">
      <a href="#cover" data-sec="cover"><span class="sq"></span>00 封面</a>
      <a href="#statement" data-sec="statement"><span class="sq"></span>01 陈述</a>
      <a href="#skills" data-sec="skills"><span class="sq"></span>02 技能</a>
      <a href="#projects" data-sec="projects"><span class="sq"></span>03 卷宗</a>
      <a href="#timeline" data-sec="timeline"><span class="sq"></span>04 年表</a>
      <a href="#contact" data-sec="contact"><span class="sq"></span>05 传讯</a>
    </nav>

    <main>
      <!-- COVER -->
      <section class="cover" id="cover">
        <div class="container">
          <div class="spread">
            <div class="cover-left">
              <div class="kicker">卷宗 VOL.2026 · 持证人 CARD HOLDER</div>
              <div class="name-block">
                <div class="vname" data-bind="name">建朝</div>
                <div class="vseal" id="nameSeal">建朝之印</div>
              </div>
              <div class="pinyin" data-bind="pinyin">JIAN&nbsp;&nbsp;CHAO</div>
              <div class="role" data-bind="role">独立开发者 · 数字产品设计师</div>
              <p class="motto" data-bind="motto">把复杂留给系统，把简单留给人。</p>
            </div>

            <div class="card-wrap">
              <svg class="paperclip" width="34" height="64" viewBox="0 0 34 64" fill="none">
                <path d="M9 14 V44 a8 8 0 0 0 16 0 V10 a5 5 0 0 0 -10 0 V42 a2 2 0 0 0 4 0 V14" stroke="#1b2738" stroke-width="2.4" fill="none" stroke-linecap="round"/>
              </svg>
              <div class="id-card">
                <div class="id-head"><span>身份卡 · IDENTITY CARD</span><span class="slot"></span></div>
                <div class="id-body">
                  <div class="photo">
                    <img src="/images/portrait.jpg" alt="持证人肖像" />
                    <span class="c tl"></span><span class="c tr"></span><span class="c bl"></span><span class="c br"></span>
                  </div>
                  <div class="fields">
                    <div class="field"><span class="lbl">姓名</span><span class="val" data-bind="name">建朝</span></div>
                    <div class="field"><span class="lbl">代号</span><span class="val" data-bind="pinyin">JIAN CHAO</span></div>
                    <div class="field"><span class="lbl">身份</span><span class="val" data-bind="role">独立开发者</span></div>
                    <div class="field"><span class="lbl">坐标</span><span class="val" data-bind="city">杭州 · 中国</span></div>
                    <div class="field"><span class="lbl">状态</span><span class="val status" data-bind="status">在册 · 可接洽新项目</span></div>
                  </div>
                </div>
                <div class="id-foot">
                  <div class="barcode" id="barcode"></div>
                  <div class="bcode-num" id="barcodeNum">0000 0000 0000</div>
                </div>
                <div class="card-seal" id="cardSeal">核验</div>
              </div>
            </div>
          </div>
        </div>

        <div class="ticker">
          <div class="ticker-track" id="tickerTrack"></div>
        </div>
      </section>

      <!-- STATEMENT -->
      <section id="statement">
        <div class="container">
          <div class="sec-head reveal">
            <div class="sec-num">01</div>
            <div class="sec-title"><h2>陈述书</h2><small>STATEMENT OF SELF</small></div>
            <div class="sec-rule"></div>
            <div class="sec-sq"></div>
          </div>
          <div class="statement">
            <div class="reveal">
              <p>我是一名游走于<mark>工程与设计</mark>之间的独立创作者。过去数年，我把代码当作表达工具，把界面当作叙事媒介，致力于让复杂的系统在人面前显得<mark>安静而克制</mark>。</p>
              <p>我相信好的产品不是功能的堆叠，而是<mark>对注意力的尊重</mark>。从一行样式到一个完整产品，我习惯先问“它是否值得存在”，再问“它该如何存在”。</p>
              <p>工作之外，我用脚步丈量城市，用咖啡续命，用开源回馈社区。这份档案由本人持有，并保留随时修订的权利。</p>
            </div>
            <aside class="reveal">
              <div class="note">
                <p>本档案所有字段均可由持证人通过右侧编辑台实时改写，无需触碰任何代码。修改将即时反映于封面、身份卡与传讯栏。</p>
              </div>
              <div class="stats">
                <div class="stat"><b data-count="7" data-suffix="+" data-key="years">0</b><span>从业年限 YEARS</span></div>
                <div class="stat"><b data-count="48" data-suffix="">0</b><span>交付项目 PROJECTS</span></div>
                <div class="stat"><b data-count="21" data-suffix="">0</b><span>合作伙伴 PARTNERS</span></div>
                <div class="stat"><b data-count="3200" data-suffix="+" data-format="k">0</b><span>开源 STAR</span></div>
              </div>
            </aside>
          </div>
        </div>
      </section>

      <!-- SKILLS -->
      <section id="skills">
        <div class="container">
          <div class="sec-head reveal">
            <div class="sec-num">02</div>
            <div class="sec-title"><h2>技能矩阵</h2><small>COMPETENCY MATRIX</small></div>
            <div class="sec-rule"></div>
            <div class="sec-sq"></div>
          </div>
          <div class="skills-grid">
            <div class="reveal" id="skillBars">
              <div class="skill-row"><span class="idx">01</span><span class="nm">前端工程</span><span class="bar"><i data-level="92"></i></span><span class="pct">92</span></div>
              <div class="skill-row"><span class="idx">02</span><span class="nm">交互设计</span><span class="bar"><i data-level="86"></i></span><span class="pct">86</span></div>
              <div class="skill-row"><span class="idx">03</span><span class="nm">数据可视化</span><span class="bar"><i data-level="80"></i></span><span class="pct">80</span></div>
              <div class="skill-row"><span class="idx">04</span><span class="nm">产品设计</span><span class="bar"><i data-level="74"></i></span><span class="pct">74</span></div>
              <div class="skill-row"><span class="idx">05</span><span class="nm">动效设计</span><span class="bar"><i data-level="68"></i></span><span class="pct">68</span></div>
            </div>
            <div class="reveal">
              <div class="chips-title">工具链 & 语言 / TOOLCHAIN</div>
              <div class="chips">
                <span class="chip">TypeScript</span><span class="chip">Vue</span><span class="chip">React</span>
                <span class="chip">Node.js</span><span class="chip">D3.js</span><span class="chip">Three.js</span>
                <span class="chip">Figma</span><span class="chip">SQLite</span><span class="chip">Rust · 学习中</span><span class="chip">Docker</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- PROJECTS -->
      <section id="projects">
        <div class="container">
          <div class="sec-head reveal">
            <div class="sec-num">03</div>
            <div class="sec-title"><h2>项目卷宗</h2><small>CASE FILES</small></div>
            <div class="sec-rule"></div>
            <div class="sec-sq"></div>
          </div>
          <div class="proj-grid">
            <div class="folder reveal">
              <div class="folder-tab">FILE 01</div>
              <span class="stamp ok">已解密</span>
              <div class="pid">PRJ-001</div>
              <h3>「山海」可视化引擎</h3>
              <div class="ptags">D3.js / WebGL / Canvas</div>
              <div class="folder-details"><div class="inner">面向大规模地理与关系数据的渲染引擎，支持百万级节点流畅交互。客户：<span class="redact">某研究院</span>。已开源核心模块。</div><span class="toggle">[ 收起 COLLAPSE ]</span></div>
            </div>
            <div class="folder reveal">
              <div class="folder-tab">FILE 02</div>
              <span class="stamp run">进行中</span>
              <div class="pid">PRJ-002</div>
              <h3>「纸间」知识管理</h3>
              <div class="ptags">Electron / SQLite / Markdown</div>
              <div class="folder-details"><div class="inner">本地优先的双链笔记工具，强调离线可用与数据主权。当前处于内测阶段，<span class="redact">预计 Q4 公测</span>。</div><span class="toggle">[ 收起 COLLAPSE ]</span></div>
            </div>
            <div class="folder reveal">
              <div class="folder-tab">FILE 03</div>
              <span class="stamp ok">已解密</span>
              <div class="pid">PRJ-003</div>
              <h3>「巷弄」漫步生成器</h3>
              <div class="ptags">Mapbox / Vue / 算法</div>
              <div class="folder-details"><div class="inner">根据心情与时间自动生成城市漫步路线的小工具，已收录 12 座城市的隐藏路线。周末使用率最高。</div><span class="toggle">[ 收起 COLLAPSE ]</span></div>
            </div>
            <div class="folder reveal">
              <div class="folder-tab">FILE 04</div>
              <span class="stamp maint">长期维护</span>
              <div class="pid">PRJ-004</div>
              <h3>「回声」组件库</h3>
              <div class="ptags">TypeScript / 无障碍 / 主题</div>
              <div class="folder-details"><div class="inner">一套克制、可访问、零依赖的 UI 组件库，GitHub <span class="redact">3.2k</span> Star，被多个团队用于生产环境。</div><span class="toggle">[ 收起 COLLAPSE ]</span></div>
            </div>
          </div>
        </div>
      </section>

      <!-- TIMELINE -->
      <section id="timeline">
        <div class="container">
          <div class="sec-head reveal">
            <div class="sec-num">04</div>
            <div class="sec-title"><h2>履历年表</h2><small>CHRONOLOGICAL LEDGER</small></div>
            <div class="sec-rule"></div>
            <div class="sec-sq"></div>
          </div>
          <div class="timeline">
            <div class="tl-row reveal"><div class="yr">2019</div><div class="tl-rail"><div class="tl-dot"></div></div><div class="tl-card"><b>入行 · 前端开发工程师</b><span>于某互联网公司，从一行 console.log 开始。</span></div></div>
            <div class="tl-row reveal"><div class="yr">2021</div><div class="tl-rail"><div class="tl-dot"></div></div><div class="tl-card"><b>转向产品设计</b><span>主导 10+ 项目，学会在“能做”与“该做”之间取舍。</span></div></div>
            <div class="tl-row reveal"><div class="yr">2023</div><div class="tl-rail"><div class="tl-dot"></div></div><div class="tl-card"><b>成立个人工作室</b><span>成为独立开发者，把日程表交还给自己。</span></div></div>
            <div class="tl-row reveal"><div class="yr">2025</div><div class="tl-rail"><div class="tl-dot"></div></div><div class="tl-card"><b>开源获 3k+ Star</b><span>「回声」组件库被社区看见，开始长期维护。</span></div></div>
            <div class="tl-row reveal"><div class="yr">2026</div><div class="tl-rail"><div class="tl-dot"></div></div><div class="tl-card"><b>持续探索中…</b><span>下一份卷宗，正在书写。</span></div></div>
          </div>
        </div>
      </section>

      <!-- CONTACT -->
      <section id="contact">
        <div class="container">
          <div class="sec-head reveal">
            <div class="sec-num">05</div>
            <div class="sec-title"><h2>传讯</h2><small>TRANSMISSION CHANNELS</small></div>
            <div class="sec-rule"></div>
            <div class="sec-sq"></div>
          </div>
          <div class="contact">
            <div class="reveal">
              <div class="crow"><span class="clbl">邮箱</span><span class="cval" data-bind="email">hi@chenyu.studio</span><button class="copy" data-copy="email">复制</button></div>
              <div class="crow"><span class="clbl">微信</span><span class="cval" data-bind="wechat">chenyu_dev</span><button class="copy" data-copy="wechat">复制</button></div>
              <div class="crow"><span class="clbl">GitHub</span><span class="cval" data-bind="github">github.com/chenyu</span><button class="copy" data-copy="github">复制</button></div>
              <div class="crow"><span class="clbl">坐标</span><span class="cval" data-bind="city">杭州 · 中国</span><button class="copy" data-copy="city">复制</button></div>
              <div style="margin-top:24px"><a class="btn btn-red" id="mailtoBtn" href="#">发送传讯 →</a></div>
            </div>
            <div class="stamp-pad reveal" id="stampPad">
              <div class="big-seal" id="bigSeal"><span>核</span><span>验</span><span>通</span><span>过</span></div>
              <h3>身份核验台</h3>
              <p>点击下方按钮，为这份档案盖下属于你的印章。</p>
              <button class="btn" id="stampBtn">盖章核验身份</button>
              <div class="verify">累计核验次数 · <b id="verifyCount">0</b></div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container">
        <div class="foot-in">
          <div class="end">档案终 · <b>END OF FILE</b></div>
          <div class="foot-bar" id="footBar"></div>
          <div class="foot-meta">本档案内容经本人核验<br/>更新于 2026.07 · 持证人保留一切权利</div>
        </div>
      </div>
    </footer>
  </div>

  <!-- EDITOR -->
  <div class="backdrop" id="backdrop"></div>
  <aside class="editor" id="editor" aria-label="档案编辑台">
    <div class="editor-head">
      <h3>档案编辑台<small>EDIT YOUR DOSSIER</small></h3>
      <button class="x" id="closeEditor" aria-label="关闭">×</button>
    </div>
    <div class="editor-body" id="editorBody">
      <div class="ef"><label>姓名 NAME</label><input data-key="name" /></div>
      <div class="ef"><label>拼音 / 英文名 PINYIN</label><input data-key="pinyin" /></div>
      <div class="ef"><label>身份头衔 ROLE</label><input data-key="role" /></div>
      <div class="ef"><label>坐标城市 CITY</label><input data-key="city" /></div>
      <div class="ef"><label>当前状态 STATUS</label><input data-key="status" /></div>
      <div class="ef"><label>个人宣言 MOTTO</label><textarea data-key="motto" rows="2"></textarea></div>
      <div class="ef"><label>关键词 KEYWORDS（逗号分隔）</label><input data-key="keywords" /></div>
      <div class="ef"><label>从业年限 YEARS</label><input data-key="years" type="number" min="0" /></div>
      <div class="ef"><label>邮箱 EMAIL</label><input data-key="email" /></div>
      <div class="ef"><label>微信 WECHAT</label><input data-key="wechat" /></div>
      <div class="ef"><label>GITHUB</label><input data-key="github" /></div>
    </div>
    <div class="editor-foot">
      <button class="btn btn-ghost" id="resetBtn">恢复默认</button>
      <button class="btn btn-red" id="doneBtn">完成 ✓</button>
    </div>
  </aside>
</BaseLayout>

<style is:global>
/* Component tokens are inherited from body.dossier (see global.css).
   Use `is:global` so rules also match elements created at runtime by
   the inline <script> (ticker-group, barcode bars, foot-bar bars, ...),
   which would otherwise lack the `data-astro-cid-…` attribute and fail
   to match the scoped selector. */
.app {
  position: relative;
  z-index: 1;
}

/* ambient layers */
.grid-bg,.noise,.wm{position:fixed;inset:0;pointer-events:none;z-index:0}
.grid-bg{background-image:
  repeating-linear-gradient(0deg,transparent 0 55px,var(--line) 55px 56px),
  repeating-linear-gradient(90deg,transparent 0 55px,var(--line) 55px 56px);
  opacity:.5}
.noise{background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='180' height='180' filter='url(%23n)'/></svg>");opacity:.06;mix-blend-mode:multiply}
.wm{overflow:hidden}
.wm span{position:absolute;font-family:'Noto Serif SC',serif;font-weight:900;font-size:46vw;color:transparent;-webkit-text-stroke:1.5px rgba(27,39,56,.06);user-select:none;line-height:.8}
.wm .a{top:-12%;left:-7%;animation:drift 14s ease-in-out infinite alternate}
.wm .b{bottom:-22%;right:-9%;animation:drift 17s ease-in-out infinite alternate-reverse}
@keyframes drift{to{transform:translateY(26px) rotate(-2deg)}}

/* topbar */
.topbar{position:sticky;top:0;z-index:40;background:var(--paper);border-bottom:2px solid var(--ink);backdrop-filter:none}
.topbar-in{width:min(1240px,94vw);margin:0 auto;display:flex;align-items:center;gap:16px;padding:11px 0}
.logo{width:38px;height:38px;background:var(--red);color:var(--paper);display:grid;place-items:center;font-family:'Ma Shan Zheng',serif;font-size:24px;box-shadow:var(--hard);flex:none}
.brand{display:flex;flex-direction:column;line-height:1.1}
.brand b{font-family:'Noto Serif SC',serif;font-weight:700;font-size:15px;letter-spacing:.04em}
.brand small{font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:.22em;color:var(--ink-soft);text-transform:uppercase}
.brand small i{color:var(--red);font-style:normal}
.topbar-right{margin-left:auto;display:flex;align-items:center;gap:14px}
.meta{font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.12em;color:var(--ink-soft);text-transform:uppercase;display:flex;align-items:center;gap:8px}
.meta:hover{color:var(--ink)}
.dot{width:8px;height:8px;border-radius:50%;background:var(--red);box-shadow:0 0 0 0 rgba(197,61,35,.6);animation:pulse 2.2s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(197,61,35,.55)}70%{box-shadow:0 0 0 8px rgba(197,61,35,0)}100%{box-shadow:0 0 0 0 rgba(197,61,35,0)}}
.btn{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;padding:9px 14px;border:2px solid var(--ink);background:var(--paper);color:var(--ink);box-shadow:var(--hard);cursor:pointer;transition:transform .12s,box-shadow .12s,background .12s,color .12s;white-space:nowrap}
.btn:hover{transform:translate(-2px,-2px);box-shadow:6px 6px 0 var(--ink)}
.btn:active{transform:translate(0,0);box-shadow:2px 2px 0 var(--ink)}
.btn-red{background:var(--red);color:var(--paper)}
.btn-ghost{box-shadow:none}
.btn-ghost:hover{background:var(--ink);color:var(--paper);transform:translate(-1px,-1px);box-shadow:3px 3px 0 var(--red)}

.container{width:min(1240px,94vw);margin:0 auto}

/* side nav */
.side-nav{position:fixed;left:24px;top:50%;transform:translateY(-50%);z-index:30;display:flex;flex-direction:column;gap:13px}
.side-nav a{display:flex;align-items:center;gap:9px;font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.1em;color:var(--ink-soft);text-decoration:none;text-transform:uppercase;transition:color .2s}
.side-nav a .sq{width:9px;height:9px;border:1.5px solid var(--ink-soft);transition:.2s}
.side-nav a:hover{color:var(--ink)}
.side-nav a.active{color:var(--red)}
.side-nav a.active .sq{background:var(--red);border-color:var(--red);transform:rotate(45deg)}

/* cover */
.cover{padding:54px 0 0}
.spread{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:54px;align-items:center}
.kicker{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--red);display:flex;align-items:center;gap:10px;margin-bottom:18px}
.kicker::before{content:'';width:34px;height:2px;background:var(--red)}
.name-block{display:flex;gap:18px;align-items:flex-start}
.vname{writing-mode:vertical-rl;text-orientation:upright;font-family:'Noto Serif SC',serif;font-weight:900;font-size:clamp(70px,11vw,148px);line-height:.92;letter-spacing:.06em}
.vseal{writing-mode:vertical-rl;font-family:'Ma Shan Zheng',serif;color:var(--red);border:3px solid var(--red);outline:2px solid var(--red);outline-offset:3px;padding:14px 7px;font-size:24px;letter-spacing:.18em;mix-blend-mode:multiply;align-self:flex-start;animation:stampIn .7s .9s both cubic-bezier(.34,1.56,.64,1)}
@keyframes stampIn{0%{transform:scale(2.6) rotate(-16deg);opacity:0}60%{transform:scale(.92) rotate(2deg);opacity:1}100%{transform:scale(1) rotate(0)}}
.pinyin{font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:.34em;text-transform:uppercase;color:var(--ink-soft);margin:20px 0 6px}
.role{font-family:'Noto Serif SC',serif;font-weight:700;font-size:clamp(20px,2.4vw,28px);display:flex;align-items:center;gap:10px}
.role::before{content:'/';color:var(--red);font-weight:900}
.motto{margin-top:16px;border-left:3px solid var(--red);padding-left:14px;color:var(--ink-soft);font-size:15px;max-width:34ch}
.hint{margin-top:22px;font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.08em;color:var(--ink-soft)}
.hint b{color:var(--red);cursor:pointer;border-bottom:1px dashed var(--red)}

/* id card */
.card-wrap{position:relative;display:flex;justify-content:center}
.paperclip{position:absolute;top:-16px;left:50%;transform:translateX(-50%) rotate(8deg);z-index:3}
.id-card{width:min(440px,100%);background:var(--paper-3);border:2px solid var(--ink);box-shadow:8px 8px 0 var(--ink);transform:rotate(-1.4deg);transition:transform .35s ease,box-shadow .35s ease;position:relative;overflow:hidden}
.id-card:hover{transform:rotate(0) translateY(-4px);box-shadow:12px 12px 0 var(--ink)}
.id-head{background:var(--ink);color:var(--paper);display:flex;justify-content:space-between;align-items:center;padding:8px 14px;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.18em;text-transform:uppercase}
.id-head .slot{width:42px;height:6px;border-radius:6px;background:var(--paper);opacity:.35}
.id-body{display:grid;grid-template-columns:128px 1fr;gap:16px;padding:18px 16px 14px}
.photo{position:relative;width:128px;height:152px;border:2px solid var(--ink);overflow:hidden;background:var(--paper-2)}
.photo img{width:100%;height:100%;object-fit:cover;filter:saturate(.92) contrast(1.04)}
.photo::after{content:'';position:absolute;left:0;right:0;height:38%;top:-45%;background:linear-gradient(180deg,transparent,rgba(197,61,35,.22),transparent);animation:scan 3.6s linear infinite}
@keyframes scan{0%{top:-45%}100%{top:110%}}
.photo .c{position:absolute;width:12px;height:12px;border:2px solid var(--red)}
.photo .c.tl{top:4px;left:4px;border-right:0;border-bottom:0}
.photo .c.tr{top:4px;right:4px;border-left:0;border-bottom:0}
.photo .c.bl{bottom:4px;left:4px;border-right:0;border-top:0}
.photo .c.br{bottom:4px;right:4px;border-left:0;border-top:0}
.fields{display:grid;gap:9px;align-content:start}
.field{display:grid;grid-template-columns:54px 1fr;gap:8px;align-items:baseline}
.field .lbl{font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:.14em;color:var(--ink-soft);text-transform:uppercase}
.field .val{font-family:'Noto Serif SC',serif;font-weight:700;font-size:13.5px;line-height:1.3}
.field .val.status{color:var(--red)}
.id-foot{border-top:1.5px dashed var(--line);padding:10px 16px 14px;display:flex;align-items:flex-end;gap:14px}
.barcode{display:flex;align-items:stretch;height:34px;gap:2px;flex:1}
.barcode i{background:var(--ink);display:block}
.bcode-num{font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:.2em;color:var(--ink-soft);text-align:right;line-height:1.3}
.card-seal{position:absolute;right:14px;bottom:54px;width:88px;height:88px;border:3px solid var(--red);outline:2px solid var(--red);outline-offset:3px;display:grid;place-items:center;writing-mode:vertical-rl;font-family:'Ma Shan Zheng',serif;color:var(--red);font-size:20px;letter-spacing:.12em;transform:rotate(-9deg);mix-blend-mode:multiply;animation:stampIn .7s 1.2s both cubic-bezier(.34,1.56,.64,1)}

/* ticker */
.ticker{margin-top:46px;border-block:2px solid var(--ink);background:var(--paper-2);overflow:hidden}
.ticker-track{display:flex;width:max-content;animation:marq 30s linear infinite}
.ticker:hover .ticker-track{animation-play-state:paused}
.ticker-group{display:flex;align-items:center}
.ticker-group span{font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.16em;text-transform:uppercase;padding:11px 0;white-space:nowrap}
.ticker-group i{color:var(--red);font-style:normal;padding:0 18px;font-size:10px}
@keyframes marq{to{transform:translateX(-50%)}}

/* section header */
section{padding:96px 0}
.sec-head{display:grid;grid-template-columns:auto auto 1fr auto;align-items:end;gap:18px;border-bottom:2px solid var(--ink);padding-bottom:14px;margin-bottom:46px}
.sec-num{font-family:'Noto Serif SC',serif;font-weight:900;font-size:clamp(54px,7vw,86px);line-height:.8;color:transparent;-webkit-text-stroke:2px var(--ink)}
.sec-title h2{font-family:'Noto Serif SC',serif;font-weight:900;font-size:clamp(26px,3.4vw,40px);line-height:1}
.sec-title small{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--red);display:block;margin-top:6px}
.sec-rule{height:2px;background:repeating-linear-gradient(90deg,var(--ink) 0 8px,transparent 8px 14px);align-self:center;margin-bottom:8px}
.sec-sq{width:12px;height:12px;background:var(--red);margin-bottom:6px}

/* statement */
.statement{display:grid;grid-template-columns:1.6fr 1fr;gap:48px}
.statement p{margin-bottom:18px;font-size:16px;color:#2a3648}
.statement p:first-of-type::first-letter{font-family:'Noto Serif SC',serif;font-weight:900;font-size:62px;float:left;line-height:.78;padding:6px 12px 0 0;color:var(--red)}
.statement mark{background:linear-gradient(transparent 58%,rgba(197,61,35,.32) 0);color:inherit;padding:0 2px}
.note{border:2px solid var(--ink);background:var(--paper-3);padding:18px 20px;box-shadow:var(--hard);position:relative}
.note::before{content:'附注 NOTE';position:absolute;top:-11px;left:14px;background:var(--paper);padding:0 8px;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.16em;color:var(--red)}
.note p{font-size:13.5px;color:var(--ink-soft)}
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:24px}
.stat{border:2px solid var(--ink);padding:14px 16px;background:var(--paper-3);transition:transform .2s}
.stat:hover{transform:translateY(-3px) rotate(-.6deg)}
.stat b{font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:38px;line-height:1;display:block;color:var(--ink)}
.stat span{font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft);display:block;margin-top:6px}

/* skills */
.skills-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:48px}
.skill-row{display:grid;grid-template-columns:30px 120px 1fr 50px;gap:14px;align-items:center;padding:11px 0;border-bottom:1px solid var(--line)}
.skill-row .idx{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--red)}
.skill-row .nm{font-family:'Noto Serif SC',serif;font-weight:700;font-size:15px}
.bar{height:11px;border:1.5px solid var(--ink);background:var(--paper-2);position:relative;overflow:hidden}
.bar i{position:absolute;inset:0;width:0;background:repeating-linear-gradient(45deg,var(--red) 0 7px,var(--red-deep) 7px 14px);transition:width 1.1s cubic-bezier(.22,1,.36,1)}
.skill-row .pct{font-family:'IBM Plex Mono',monospace;font-size:12px;text-align:right}
.chips-title{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:16px}
.chips{display:flex;flex-wrap:wrap;gap:9px}
.chip{font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.04em;border:1.6px solid var(--ink);padding:7px 12px;cursor:default;transition:.16s}
.chip:hover{background:var(--ink);color:var(--paper);transform:translate(-2px,-2px);box-shadow:3px 3px 0 var(--red)}

/* projects */
.proj-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(330px,1fr));gap:30px}
.folder{position:relative;background:var(--manila);border:2px solid var(--ink);box-shadow:6px 6px 0 var(--ink);padding:34px 22px 22px;cursor:pointer;transition:transform .25s,box-shadow .25s}
.folder:hover{transform:translateY(-6px) rotate(-.4deg);box-shadow:10px 10px 0 var(--ink)}
.folder-tab{position:absolute;top:-15px;left:18px;background:var(--manila-d);border:2px solid var(--ink);border-bottom:0;border-radius:7px 7px 0 0;padding:3px 16px;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.12em;color:var(--ink)}
.folder .pid{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.14em;color:var(--red-deep)}
.folder h3{font-family:'Noto Serif SC',serif;font-weight:900;font-size:22px;margin:6px 0 4px}
.folder .ptags{font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:var(--ink-soft);letter-spacing:.04em}
.folder .stamp{position:absolute;top:14px;right:14px;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;border:2.5px double currentColor;padding:4px 8px;transform:rotate(7deg)}
.folder .stamp.ok{color:var(--red)}
.folder .stamp.run{color:var(--blue)}
.folder .stamp.maint{color:var(--ink)}
.folder .redact{background:var(--ink);color:transparent;user-select:none;padding:0 4px;border-radius:1px}
.folder-details{max-height:0;overflow:hidden;transition:max-height .5s ease}
.folder.open .folder-details{max-height:260px}
.folder-details .inner{border-top:1.5px dashed var(--ink);margin-top:16px;padding-top:14px;font-size:13.5px;color:#3a3320}
.folder-details .toggle{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--red-deep);margin-top:12px;display:inline-block}

/* timeline */
.timeline{position:relative;padding-left:0}
.tl-row{display:grid;grid-template-columns:120px 28px 1fr;gap:0;align-items:start;padding-bottom:34px;position:relative}
.tl-row .yr{font-family:'Noto Serif SC',serif;font-weight:900;font-size:30px;line-height:1;text-align:right;padding-right:18px}
.tl-rail{position:relative;display:flex;justify-content:center}
.tl-rail::before{content:'';position:absolute;top:0;bottom:-34px;width:2px;background:var(--ink)}
.tl-row:last-child .tl-rail::before{bottom:50%}
.tl-dot{width:13px;height:13px;background:var(--red);transform:rotate(45deg);margin-top:8px;position:relative;z-index:1;border:2px solid var(--ink)}
.tl-card{border:2px solid var(--ink);background:var(--paper-3);padding:14px 18px;box-shadow:var(--hard);transition:transform .2s}
.tl-card:hover{transform:translateX(4px)}
.tl-card b{font-family:'Noto Serif SC',serif;font-weight:700;font-size:16px;display:block}
.tl-card span{font-size:13px;color:var(--ink-soft)}

/* contact */
.contact{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:start}
.crow{display:grid;grid-template-columns:78px 1fr auto;gap:14px;align-items:center;padding:14px 0;border-bottom:1.5px solid var(--line)}
.crow .clbl{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft)}
.crow .cval{font-family:'Noto Serif SC',serif;font-weight:700;font-size:16px;word-break:break-all}
.copy{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.1em;border:1.5px solid var(--ink);background:var(--paper);padding:5px 9px;cursor:pointer;transition:.15s}
.copy:hover{background:var(--ink);color:var(--paper)}
.copy.done{background:var(--red);color:var(--paper);border-color:var(--red)}
.stamp-pad{border:2px dashed var(--ink);background:var(--paper-3);padding:30px 26px;text-align:center;position:relative;min-height:280px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:16px}
.stamp-pad h3{font-family:'Noto Serif SC',serif;font-weight:900;font-size:22px}
.stamp-pad p{font-size:13px;color:var(--ink-soft);max-width:26ch}
.verify{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft)}
.verify b{color:var(--red)}
.big-seal{position:absolute;width:130px;height:130px;border:4px solid var(--red);outline:3px solid var(--red);outline-offset:4px;display:grid;grid-template-columns:1fr 1fr;place-items:center;font-family:'Ma Shan Zheng',serif;color:var(--red);font-size:30px;mix-blend-mode:multiply;opacity:0;pointer-events:none}
.big-seal.slam{animation:slam .55s cubic-bezier(.34,1.56,.64,1) forwards}
@keyframes slam{0%{transform:scale(2.6) rotate(-18deg);opacity:0}55%{transform:scale(.9) rotate(8deg);opacity:.95}72%{transform:scale(1.08) rotate(6deg)}100%{transform:scale(1) rotate(7deg);opacity:.92}}
.stamp-pad.shake{animation:shake .4s}
@keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-5px)}40%{transform:translateX(5px)}60%{transform:translateX(-3px)}80%{transform:translateX(3px)}}

/* footer */
footer{border-top:3px double var(--ink);padding:40px 0 60px;margin-top:30px}
.foot-in{display:grid;grid-template-columns:1fr auto 1fr;gap:24px;align-items:center}
.foot-in .end{font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:.18em;text-transform:uppercase}
.foot-in .end b{color:var(--red)}
.foot-bar{display:flex;align-items:stretch;height:30px;gap:2px;justify-content:center}
.foot-bar i{background:var(--ink);display:block}
.foot-meta{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.1em;color:var(--ink-soft);text-align:right;text-transform:uppercase}

/* reveal */
.reveal{opacity:0;transform:translateY(28px);transition:opacity .7s cubic-bezier(.22,1,.36,1),transform .7s cubic-bezier(.22,1,.36,1)}
.reveal.in{opacity:1;transform:none}

/* editor */
.backdrop{position:fixed;inset:0;background:rgba(27,39,56,.4);z-index:60;opacity:0;visibility:hidden;transition:.35s}
.backdrop.open{opacity:1;visibility:visible}
.editor{position:fixed;top:0;right:0;height:100%;width:min(390px,100%);background:var(--paper);border-left:2px solid var(--ink);z-index:70;transform:translateX(105%);transition:transform .45s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column;box-shadow:-12px 0 0 rgba(27,39,56,.06)}
.editor.open{transform:translateX(0)}
.editor-head{display:flex;align-items:center;justify-content:space-between;padding:18px 22px;border-bottom:2px solid var(--ink)}
.editor-head h3{font-family:'Noto Serif SC',serif;font-weight:900;font-size:20px}
.editor-head h3 small{display:block;font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:.18em;color:var(--red);text-transform:uppercase;margin-top:3px}
.x{font-family:'IBM Plex Mono',monospace;font-size:18px;border:2px solid var(--ink);width:34px;height:34px;background:var(--paper);cursor:pointer;line-height:1;transition:.15s}
.x:hover{background:var(--red);color:var(--paper)}
.editor-body{padding:22px;overflow-y:auto;flex:1}
.ef{margin-bottom:18px}
.ef label{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft);display:block;margin-bottom:6px}
.ef input,.ef textarea{width:100%;background:transparent;border:0;border-bottom:2px solid var(--ink);padding:8px 2px;font-family:'Noto Sans SC',sans-serif;font-size:15px;color:var(--ink);resize:vertical;transition:border-color .2s}
.ef input:focus,.ef textarea:focus{outline:none;border-color:var(--red)}
.editor-foot{padding:16px 22px;border-top:2px solid var(--ink);display:flex;gap:10px}
.editor-foot .btn{flex:1;text-align:center}
.edge-tab{position:fixed;right:0;top:50%;transform:translateY(-50%);z-index:50;writing-mode:vertical-rl;background:var(--red);color:var(--paper);border:2px solid var(--ink);border-right:0;padding:16px 9px;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.16em;cursor:pointer;box-shadow:-4px 4px 0 var(--ink);transition:transform .2s}
.edge-tab:hover{transform:translateY(-50%) translateX(-5px)}

@media (max-width:1080px){.side-nav{display:none}}
@media (max-width:920px){
  .spread{grid-template-columns:1fr;gap:40px}
  .vname{writing-mode:horizontal-tb;text-orientation:mixed}
  .vseal{writing-mode:horizontal-tb;display:inline-block}
  .name-block{flex-direction:column;gap:14px}
  .statement,.skills-grid,.contact{grid-template-columns:1fr;gap:30px}
  .topbar-right .meta{display:none}
  .skill-row{grid-template-columns:26px 96px 1fr 42px;gap:10px}
}
@media (max-width:560px){
  .stats{grid-template-columns:1fr 1fr}
  .foot-in{grid-template-columns:1fr;text-align:center;gap:14px}
  .foot-meta{text-align:center}
  .sec-head{grid-template-columns:auto 1fr auto}
  .sec-rule{display:none}
  .id-body{grid-template-columns:104px 1fr}
  .photo{width:104px;height:128px}
}
@media print{
  .topbar,.side-nav,.edge-tab,.editor,.backdrop,.ticker,.btn{display:none!important}
  body{background:#fff}.grid-bg,.noise,.wm{display:none}
  .reveal{opacity:1!important;transform:none!important}
}
</style>

<script>
(function(){
  "use strict";
  var DEFAULT_PROFILE = {
    name:"建朝", pinyin:"JIAN CHAO",
    role:"独立开发者 · 数字产品设计师",
    city:"北京·中国",
    status:"在册 · 可接洽新项目",
    motto:"把复杂留给系统，把简单留给人。",
    keywords:["前端工程","交互设计","数据可视化","开源","咖啡","城市漫游"],
    years:7, email:"tinyking86@gmail.com", wechat:"tinyking86", github:"github.com/tinyking"
  };
  var STORE="dossier-profile-v1", STAMP_STORE="dossier-stamps-v1";
  var profile = load();

  function load(){
    try{ var s=localStorage.getItem(STORE); if(s){ return Object.assign({},DEFAULT_PROFILE,JSON.parse(s)); } }catch(e){}
    return Object.assign({},DEFAULT_PROFILE,{keywords:DEFAULT_PROFILE.keywords.slice()});
  }
  function save(){ try{ localStorage.setItem(STORE,JSON.stringify(profile)); }catch(e){} }

  function hashStr(str){ var h=2166136261>>>0; for(var i=0;i<str.length;i++){ h^=str.charCodeAt(i); h=Math.imul(h,16777619)>>>0; } return h>>>0; }

  function buildBarcode(el, seed){
    el.innerHTML="";
    var h=hashStr(seed||"x");
    for(var i=0;i<46;i++){
      h=(Math.imul(h,1103515245)+12345)>>>0;
      var w=((h>>13)%4)+1;
      var bar=document.createElement("i");
      bar.style.width=(w*1.3+0.6)+"px";
      if(((h>>7)%5)===0){ bar.style.opacity="0"; }
      el.appendChild(bar);
    }
    var digits="";
    var h2=hashStr(seed+"d");
    for(var j=0;j<12;j++){ h2=(Math.imul(h2,48271)+1)>>>0; digits+=(h2%10); if(j===3||j===7) digits+=" "; }
    return digits;
  }

  function buildTicker(){
    var track=document.getElementById("tickerTrack");
    var kw=Array.isArray(profile.keywords)&&profile.keywords.length?profile.keywords:["—"];
    var html="";
    for(var g=0;g<2;g++){
      html+='<div class="ticker-group">';
      for(var k=0;k<kw.length;k++){ html+='<span>'+escapeHtml(kw[k])+'</span><i>◆</i>'; }
      html+='</div>';
    }
    track.innerHTML=html;
  }
  function escapeHtml(s){ return String(s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }

  function buildSeal(){
    var n=String(profile.name||"").trim();
    var chars = n.length>=2 ? n.slice(0,2)+"之印" : (n? n+"印" : "印");
    document.getElementById("nameSeal").textContent=chars;
    document.getElementById("cardSeal").textContent = n.length>=2 ? n.slice(0,2) : (n||"印");
  }

  function buildDossierNo(){
    var num = 1000 + (hashStr((profile.name||"")+(profile.pinyin||""))%9000);
    document.getElementById("dossierNo").textContent = "NO. 2026-"+num;
  }

  function bindProfile(){
    var nodes=document.querySelectorAll("[data-bind]");
    nodes.forEach(function(el){
      var key=el.getAttribute("data-bind");
      if(key==="keywords") return;
      var v = (profile[key]!==undefined && profile[key]!==null) ? profile[key] : "";
      if(key==="pinyin"){ el.innerHTML = String(v).replace(/\s+/g,"&nbsp;&nbsp;"); }
      else { el.textContent = v; }
    });
    var yEl=document.querySelector('[data-key="years"]');
    if(yEl){
      yEl.setAttribute("data-count", profile.years||0);
      if(yEl.getAttribute("data-done")){ yEl.textContent = formatNum(profile.years||0, yEl.getAttribute("data-format"), yEl.getAttribute("data-suffix")||""); }
    }
    document.getElementById("mailtoBtn").setAttribute("href","mailto:"+profile.email);
    buildTicker(); buildSeal(); buildDossierNo();
    var bcNum = buildBarcode(document.getElementById("barcode"), (profile.name||"")+(profile.pinyin||""));
    document.getElementById("barcodeNum").textContent = bcNum;
    buildBarcode(document.getElementById("footBar"), (profile.name||"")+"foot");
    document.title = (profile.name||"档案")+" · 个人身份档案";
    syncEditorInputs();
  }

  function formatNum(v, fmt, suffix){
    suffix = suffix||"";
    if(fmt==="k" && v>=1000){ return (v/1000).toFixed(1)+"k"+suffix; }
    return v+suffix;
  }

  function syncEditorInputs(){
    document.querySelectorAll("#editorBody [data-key]").forEach(function(inp){
      var key=inp.getAttribute("data-key");
      if(key==="keywords"){ inp.value = (profile.keywords||[]).join("，"); }
      else { inp.value = (profile[key]!==undefined?profile[key]:""); }
    });
  }

  function parseKeywords(str){
    return String(str).split(/[,，、\s]+/).map(function(s){return s.trim();}).filter(Boolean);
  }

  var editor=document.getElementById("editor"), backdrop=document.getElementById("backdrop");
  function openEditor(){ editor.classList.add("open"); backdrop.classList.add("open"); }
  function closeEditor(){ editor.classList.remove("open"); backdrop.classList.remove("open"); }
  document.getElementById("closeEditor").addEventListener("click",closeEditor);
  document.getElementById("doneBtn").addEventListener("click",closeEditor);
  backdrop.addEventListener("click",closeEditor);
  document.addEventListener("keydown",function(e){
    if(e.key==="Escape"){ closeEditor(); }
  });

  document.querySelectorAll("#editorBody [data-key]").forEach(function(inp){
    inp.addEventListener("input",function(){
      var key=inp.getAttribute("data-key");
      if(key==="keywords"){ profile.keywords = parseKeywords(inp.value); }
      else if(key==="years"){ profile.years = parseInt(inp.value,10)||0; }
      else { profile[key]=inp.value; }
      save(); bindProfile();
    });
  });
  document.getElementById("resetBtn").addEventListener("click",function(){
    profile = Object.assign({},DEFAULT_PROFILE,{keywords:DEFAULT_PROFILE.keywords.slice()});
    try{ localStorage.removeItem(STORE); }catch(e){}
    bindProfile();
  });

  document.querySelectorAll(".copy").forEach(function(btn){
    btn.addEventListener("click",function(){
      var key=btn.getAttribute("data-copy");
      var val = profile[key]!==undefined ? String(profile[key]) : "";
      var done=function(){ btn.classList.add("done"); var old=btn.textContent; btn.textContent="已复制✓"; setTimeout(function(){ btn.classList.remove("done"); btn.textContent=old; },1300); };
      if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(val).then(done).catch(fallback); }
      else { fallback(); }
      function fallback(){ var t=document.createElement("textarea"); t.value=val; document.body.appendChild(t); t.select(); try{document.execCommand("copy");}catch(e){} document.body.removeChild(t); done(); }
    });
  });

  var stampCount = (function(){ try{ return parseInt(localStorage.getItem(STAMP_STORE),10)||0; }catch(e){ return 0; } })();
  var vc=document.getElementById("verifyCount"); vc.textContent=stampCount;
  document.getElementById("stampBtn").addEventListener("click",function(){
    var seal=document.getElementById("bigSeal"), pad=document.getElementById("stampPad");
    seal.classList.remove("slam"); void seal.offsetWidth; seal.classList.add("slam");
    pad.classList.remove("shake"); void pad.offsetWidth; pad.classList.add("shake");
    stampCount++; vc.textContent=stampCount;
    try{ localStorage.setItem(STAMP_STORE,String(stampCount)); }catch(e){}
  });

  document.querySelectorAll(".folder").forEach(function(f){
    f.addEventListener("click",function(e){
      if(e.target.classList.contains("copy")) return;
      var open=f.classList.toggle("open");
      var tg=f.querySelector(".toggle");
      if(tg){ tg.textContent = open ? "[ 收起 COLLAPSE ]" : "[ 展开 EXPAND ]"; }
    });
  });
  document.querySelectorAll(".folder .toggle").forEach(function(t){ t.textContent="[ 展开 EXPAND ]"; });

  function animateCount(el){
    var target=parseInt(el.getAttribute("data-count"),10)||0;
    var fmt=el.getAttribute("data-format"), suffix=el.getAttribute("data-suffix")||"";
    var start=null, dur=1200;
    function step(ts){
      if(!start) start=ts;
      var p=Math.min((ts-start)/dur,1);
      var eased=1-Math.pow(1-p,3);
      var cur=Math.round(target*eased);
      el.textContent=formatNum(cur,fmt,suffix);
      if(p<1){ requestAnimationFrame(step); } else { el.setAttribute("data-done","1"); el.textContent=formatNum(target,fmt,suffix); }
    }
    requestAnimationFrame(step);
  }

  var io=new IntersectionObserver(function(entries){
    entries.forEach(function(en){
      if(en.isIntersecting){
        en.target.classList.add("in");
        en.target.querySelectorAll && en.target.querySelectorAll(".bar i").forEach(function(b){ b.style.width=(b.getAttribute("data-level")||0)+"%"; });
        en.target.querySelectorAll && en.target.querySelectorAll("[data-count]").forEach(function(c){ if(!c.getAttribute("data-done")) animateCount(c); });
        io.unobserve(en.target);
      }
    });
  },{threshold:0.18});
  document.querySelectorAll(".reveal").forEach(function(el){ io.observe(el); });

  var navLinks=document.querySelectorAll("#sideNav a");
  var spy=new IntersectionObserver(function(entries){
    entries.forEach(function(en){
      if(en.isIntersecting){
        var id=en.target.id;
        navLinks.forEach(function(a){ a.classList.toggle("active", a.getAttribute("data-sec")===id); });
      }
    });
  },{rootMargin:"-45% 0px -50% 0px"});
  ["cover","statement","skills","projects","timeline","contact"].forEach(function(id){ var s=document.getElementById(id); if(s) spy.observe(s); });

  (function(){
    var d=new Date();
    var wk=["日","一","二","三","四","五","六"][d.getDay()];
    var pad=function(n){return n<10?"0"+n:n;};
    document.getElementById("today").textContent = d.getFullYear()+"."+pad(d.getMonth()+1)+"."+pad(d.getDate())+" · 周"+wk;
  })();

  bindProfile();
})();
</script>
