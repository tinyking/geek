---
import BaseLayout from '../layouts/BaseLayout.astro';

const categories = [
  {
    name: '工程实践',
    items: [
      {
        title: 'Harness 工程学习',
        desc: '系统学习 Harness 持续交付平台',
        href: 'https://walkinglabs.github.io/learn-harness-engineering/zh/',
      },
      {
        title: 'Engineering AI Agents',
        desc: 'AI Agents 工程实践指南，涵盖上下文管理、授权、成本控制等核心决策',
        href: 'https://agents.siddhantkhare.com/preface/',
      },
    ],
  },
  {
    name: '开发工具',
    items: [
      {
        title: 'Docus',
        desc: '基于 Nuxt 的文档站点生成工具，开箱即用，支持 Markdown 编写',
        href: 'https://docus.dev/en',
      },
      {
        title: 'MultiPost',
        desc: '浏览器扩展，一键将内容同步发布到知乎、微博、小红书、抖音等 10+ 平台',
        href: 'https://github.com/leaperone/MultiPost-Extension',
      },
    ],
  },
  {
    name: '生活工具',
    items: [
      {
        title: '证件照大师',
        desc: '在线证件照处理，支持换底色、压缩、剪切、排版等',
        href: 'https://id-photo.cn',
      },
      {
        title: '珍彩证件照',
        desc: '在线制作各类规格证件照，支持一寸、二寸等多种尺寸',
        href: 'https://zhengjianzhao.com',
      },
    ],
  },
  {
    name: '学习资源',
    items: [
      {
        title: 'MIT 6.S081 操作系统工程',
        desc: '基于 xv6 的操作系统课程，覆盖进程、系统调用、页表、中断、文件系统等核心内容',
        href: 'https://github.com/xiyuan1avery/-MIT-6.S081-Operating-System-Engineering',
      },
      {
        title: '中国教科书开源仓库',
        desc: '收录从小学到大学的数学教材 PDF，完全免费开源',
        href: 'https://github.com/TapXWorld/ChinaTextbook',
      },
    ],
  },
  {
    name: 'AI 工具',
    items: [
      {
        title: 'Pixelle-Video',
        desc: '一站式 AI 短视频引擎，输入主题自动完成文案、配图、配音、背景音乐合成',
        href: 'https://github.com/AIDC-AI/Pixelle-Video',
      },
    ],
  },
];

// 统计条目数用于顶部档案标头
const totalItems = categories.reduce((sum, c) => sum + c.items.length, 0);
---

<BaseLayout
  title="收藏夹 | 阅微漫记"
  description="语霖精选的优质资源收藏 — 工程实践、设计灵感、学习资料等。"
  bodyClass="dossier"
>
  <div class="grid-bg"></div>
  <div class="noise"></div>
  <div class="wm"><span class="a">又</span><span class="b">见</span></div>

  <header class="topbar">
    <div class="topbar-in">
      <div class="logo">朝</div>
      <div class="brand">
        <b>观禾</b>
        <small>浮生观禾，静心成长</small>
      </div>
      <div class="topbar-right">
        <span class="meta"><span class="dot"></span>在册</span>
        <span class="meta">NO. BMK</span>
        <span class="meta" id="today">——</span>
      </div>
    </div>
  </header>

  <main class="dossier-main">
    <div class="container">
      <!-- 顶部档案条：标题 + 返回首页 -->
      <div class="bm-head">
        <div class="bm-head-left">
          <div class="bm-stamp">FILE · BOOKMARKS</div>
          <h1 class="bm-title">收<span class="rd">藏</span>夹</h1>
          <p class="bm-sub">
            语霖精选的优质资源归档，按类别分卷存档。<br>
            共计 <b>{categories.length}</b> 卷 · <b>{totalItems}</b> 条书签。
          </p>
        </div>
        <a class="btn btn-ghost" href="/">← 返回首页</a>
      </div>

      <!-- 分类卷宗 -->
      <div class="bm-grid">
        {categories.map((category, idx) => (
          <section class="folder reveal">
            <div class="folder-tab">FILE {String(idx + 1).padStart(2, '0')}</div>
            <span class="stamp ok">在册</span>
            <div class="pid">BMK-{String(idx + 1).padStart(3, '0')}</div>
            <h2 class="folder-title">{category.name}</h2>
            <div class="folder-count">共 {category.items.length} 条 · ENTRIES</div>
            <ul class="bm-list">
              {category.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="bm-item"
                  >
                    <span class="bm-row">
                      <span class="bm-bullet">◆</span>
                      <span class="bm-content">
                        <span class="bm-name">{item.title}</span>
                        <span class="bm-desc">{item.desc}</span>
                        <span class="bm-href">{item.href}</span>
                      </span>
                      <span class="bm-go" aria-hidden="true">↗</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <!-- 页脚说明 -->
      <footer class="bm-foot">
        <div class="bm-foot-in">
          <div class="end">档案终 · <b>END OF FILE</b></div>
          <div class="bm-foot-meta">
            本收藏夹由「语霖」本人核验归档<br/>
            更新于 2026.07 · 持证人保留一切权利
          </div>
        </div>
      </footer>
    </div>
  </main>

  <style is:global>
    /* 复用首页 dossier 主题 token，与 404.astro / index.astro 保持一致 */
    body.dossier {
      --paper: #f0e4cd;
      --paper-2: #e6dcc4;
      --paper-3: #fbfaf4;
      --ink: #171310;
      --ink-2: #2c241c;
      --ink-soft: #6b6354;
      --red: #c13a2b;
      --red-deep: #8b2a1f;
      --manila: #d9a441;
      --manila-d: #b8862e;
      --border: #c9bea3;
      --line: #d9cfb4;
      --hard: 4px 4px 0 var(--ink);
      --text-primary: #1a1a1a;
      --text-secondary: #6b6b6b;
      background: var(--paper);
      color: var(--text-primary);
      font-family: 'Noto Serif SC', serif;
    }

    .grid-bg {
      background-image:
        linear-gradient(to right, rgba(27,19,16,.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(27,19,16,.04) 1px, transparent 1px);
      background-size: 48px 48px;
    }
    .noise {
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='180' height='180' filter='url(%23n)'/></svg>");
      opacity: .06;
      mix-blend-mode: multiply;
    }
    .grid-bg, .noise, .wm { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
    .wm { overflow: hidden; }
    .wm span {
      position: absolute;
      font-family: 'Noto Serif SC', serif;
      font-weight: 900;
      font-size: 46vw;
      color: transparent;
      -webkit-text-stroke: 1.5px rgba(27,19,16,.06);
      user-select: none;
      line-height: .8;
    }
    .wm .a { top: -12%; left: -7%; }
    .wm .b { bottom: -22%; right: -9%; }

    /* topbar */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 40;
      background: var(--paper);
      border-bottom: 2px solid var(--ink);
    }
    .topbar-in {
      width: min(1240px, 94vw);
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 11px 0;
    }
    .logo {
      width: 38px;
      height: 38px;
      background: var(--red);
      color: var(--paper);
      display: grid;
      place-items: center;
      font-family: 'Ma Shan Zheng', serif;
      font-size: 24px;
      box-shadow: 3px 3px 0 var(--ink);
      flex: none;
    }
    .brand {
      display: flex;
      flex-direction: column;
      line-height: 1.1;
    }
    .brand b {
      font-family: 'Noto Serif SC', serif;
      font-weight: 700;
      font-size: 15px;
      letter-spacing: .04em;
    }
    .brand small {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 9.5px;
      letter-spacing: .22em;
      color: var(--text-secondary);
      text-transform: uppercase;
      padding-top: 4px;
    }
    .topbar-right {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .meta {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10.5px;
      letter-spacing: .12em;
      color: var(--text-secondary);
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--red);
      box-shadow: 0 0 0 0 rgba(197,61,35,.6);
      animation: pulse 2.2s infinite;
    }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(197,61,35,.55); }
      70% { box-shadow: 0 0 0 8px rgba(197,61,35,0); }
      100% { box-shadow: 0 0 0 0 rgba(197,61,35,0); }
    }

    /* main */
    .dossier-main {
      position: relative;
      z-index: 1;
      padding: 56px 24px 80px;
    }
    .container {
      width: min(1100px, 94vw);
      margin: 0 auto;
    }

    /* 顶部档案条 */
    .bm-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
      padding-bottom: 24px;
      border-bottom: 2px solid var(--ink);
      margin-bottom: 44px;
    }
    .bm-head-left { min-width: 0; flex: 1; }
    .bm-stamp {
      display: inline-block;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      letter-spacing: 3px;
      padding: 5px 12px;
      background: var(--ink);
      color: var(--paper);
      border-radius: 2px;
      margin-bottom: 22px;
      transform: rotate(-1deg);
    }
    .bm-title {
      font-family: 'Noto Serif SC', serif;
      font-weight: 900;
      font-size: clamp(40px, 6vw, 64px);
      line-height: 1;
      letter-spacing: 4px;
      color: var(--ink);
      margin-bottom: 14px;
    }
    .bm-title .rd { color: var(--red); }
    .bm-sub {
      font-family: 'Noto Serif SC', serif;
      font-size: 14px;
      line-height: 2;
      color: var(--text-secondary);
      max-width: 560px;
    }
    .bm-sub b {
      color: var(--red);
      font-weight: 700;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 15px;
      margin: 0 2px;
    }

    /* btn */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 11px 20px;
      font-family: 'Noto Serif SC', serif;
      font-weight: 700;
      font-size: 13px;
      letter-spacing: 2px;
      text-decoration: none;
      border: 1.5px solid var(--ink);
      border-radius: 2px;
      transition: transform .2s, box-shadow .2s, background .2s, color .2s;
      white-space: nowrap;
    }
    .btn-ghost {
      background: transparent;
      color: var(--ink);
    }
    .btn-ghost:hover {
      background: var(--ink);
      color: var(--paper);
      transform: translate(-2px, -2px);
      box-shadow: 4px 4px 0 var(--red);
    }

    /* 书签网格 */
    .bm-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 30px;
    }

    /* folder 卡片 */
    .folder {
      position: relative;
      background: var(--paper-3);
      border: 1.5px solid var(--ink);
      box-shadow: 8px 8px 0 var(--ink);
      padding: 30px 22px 22px;
      transition: transform .25s, box-shadow .25s;
    }
    .folder::before {
      content: '';
      position: absolute;
      top: -1.5px;
      left: 30px;
      width: 90px;
      height: 4px;
      background: var(--red);
    }
    .folder:hover {
      transform: translateY(-4px) rotate(-.3deg);
      box-shadow: 10px 10px 0 var(--ink);
    }
    .folder-tab {
      position: absolute;
      top: -15px;
      left: 16px;
      background: var(--manila-d);
      border: 1.5px solid var(--ink);
      border-bottom: 0;
      border-radius: 7px 7px 0 0;
      padding: 3px 14px;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      letter-spacing: .12em;
      color: var(--ink);
    }
    .folder .pid {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      letter-spacing: .14em;
      color: var(--red-deep);
      margin-bottom: 4px;
    }
    .folder-title {
      font-family: 'Noto Serif SC', serif;
      font-weight: 900;
      font-size: 24px;
      line-height: 1.2;
      color: var(--ink);
      margin: 0 0 4px;
    }
    .folder-count {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      letter-spacing: .1em;
      color: var(--ink-soft);
      text-transform: uppercase;
      margin-bottom: 14px;
      padding-bottom: 12px;
      border-bottom: 1.5px dashed var(--border);
    }
    .folder .stamp {
      position: absolute;
      top: 14px;
      right: 14px;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 9.5px;
      letter-spacing: .1em;
      text-transform: uppercase;
      border: 2.5px double currentColor;
      padding: 3px 7px;
      transform: rotate(7deg);
      color: var(--red);
    }

    /* 书签列表 */
    .bm-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .bm-list li {
      border-bottom: 1px dashed var(--border);
    }
    .bm-list li:last-child {
      border-bottom: none;
    }
    .bm-item {
      display: block;
      text-decoration: none;
      color: inherit;
      padding: 12px 0;
      transition: padding .2s, background .2s;
    }
    .bm-item:hover {
      padding-left: 6px;
      background: rgba(193,58,43,.04);
    }
    .bm-row {
      display: grid;
      grid-template-columns: 18px 1fr auto;
      gap: 10px;
      align-items: flex-start;
    }
    .bm-bullet {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      color: var(--red);
      line-height: 1.6;
    }
    .bm-content {
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-width: 0;
    }
    .bm-name {
      font-family: 'Noto Serif SC', serif;
      font-weight: 700;
      font-size: 15px;
      line-height: 1.4;
      color: var(--ink);
      transition: color .2s;
    }
    .bm-item:hover .bm-name {
      color: var(--red-deep);
    }
    .bm-desc {
      font-family: 'Noto Serif SC', serif;
      font-size: 12.5px;
      line-height: 1.65;
      color: var(--text-secondary);
    }
    .bm-href {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 9.5px;
      letter-spacing: .04em;
      color: var(--ink-soft);
      word-break: break-all;
      opacity: .7;
      margin-top: 2px;
    }
    .bm-go {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 13px;
      color: var(--red-deep);
      opacity: 0;
      transform: translateX(-4px);
      transition: opacity .2s, transform .2s;
      align-self: center;
    }
    .bm-item:hover .bm-go {
      opacity: 1;
      transform: translateX(0);
    }

    /* 页脚 */
    .bm-foot {
      border-top: 3px double var(--ink);
      padding: 32px 0 0;
      margin-top: 56px;
    }
    .bm-foot-in {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      align-items: center;
    }
    .bm-foot .end {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12px;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: var(--ink);
    }
    .bm-foot .end b {
      color: var(--red);
    }
    .bm-foot-meta {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      letter-spacing: .1em;
      color: var(--ink-soft);
      text-align: right;
      text-transform: uppercase;
      line-height: 1.8;
    }

    /* reveal 动画 */
    .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity .7s cubic-bezier(.22,1,.36,1), transform .7s cubic-bezier(.22,1,.36,1);
    }
    .reveal.in {
      opacity: 1;
      transform: none;
    }

    /* 响应式 */
    @media (max-width: 640px) {
      .dossier-main { padding: 36px 16px 60px; }
      .bm-head {
        flex-direction: column;
        align-items: stretch;
        gap: 18px;
      }
      .bm-head-left { width: 100%; }
      .btn-ghost { align-self: flex-start; }
      .bm-grid { grid-template-columns: 1fr; gap: 22px; }
      .folder { padding: 26px 18px 18px; box-shadow: 5px 5px 0 var(--ink); }
      .folder:hover { transform: none; box-shadow: 5px 5px 0 var(--ink); }
      .bm-foot-in { grid-template-columns: 1fr; text-align: center; gap: 12px; }
      .bm-foot-meta { text-align: center; }
      .topbar-right .meta:not(:last-child) { display: none; }
      .brand small { display: none; }
    }
  </style>

  <script is:client>
    // 显示北京时间，与首页 topbar 一致
    (function() {
      const el = document.getElementById('today');
      if (!el) return;
      try {
        const now = new Date();
        const fmt = new Intl.DateTimeFormat('zh-CN', {
          timeZone: 'Asia/Shanghai',
          year: 'numeric', month: '2-digit', day: '2-digit',
          hour: '2-digit', minute: '2-digit', hour12: false
        });
        el.textContent = fmt.format(now).replace(/\//g, '.');
      } catch (e) {
        el.textContent = '——';
      }
    })();

    // reveal 动画
    (function() {
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(en) {
          if (en.isIntersecting) {
            en.target.classList.add('in');
            io.unobserve(en.target);
          }
        });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach(function(el) { io.observe(el); });
    })();
  </script>
</BaseLayout>
