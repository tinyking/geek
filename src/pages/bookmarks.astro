---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const categories = [
  {
    name: '工程实践',
    items: [
      {
        title: 'Harness 工程学习',
        desc: '系统学习 Harness 持续交付平台',
        href: 'https://walkinglabs.github.io/learn-harness-engineering/zh/',
      },
      {
        title: 'Engineering AI Agents',
        desc: 'AI Agents 工程实践指南，涵盖上下文管理、授权、成本控制等核心决策',
        href: 'https://agents.siddhantkhare.com/preface/',
      },
    ],
  },
  {
    name: '开发工具',
    items: [
      {
        title: 'Docus',
        desc: '基于 Nuxt 的文档站点生成工具，开箱即用，支持 Markdown 编写',
        href: 'https://docus.dev/en',
      },
      {
        title: 'MultiPost',
        desc: '浏览器扩展，一键将内容同步发布到知乎、微博、小红书、抖音等 10+ 平台',
        href: 'https://github.com/leaperone/MultiPost-Extension',
      },
    ],
  },
  {
    name: '生活工具',
    items: [
      {
        title: '证件照大师',
        desc: '在线证件照处理，支持换底色、压缩、剪切、排版等',
        href: 'https://id-photo.cn',
      },
      {
        title: '珍彩证件照',
        desc: '在线制作各类规格证件照，支持一寸、二寸等多种尺寸',
        href: 'https://zhengjianzhao.com',
      },
    ],
  },
  {
    name: '学习资源',
    items: [
      {
        title: 'MIT 6.S081 操作系统工程',
        desc: '基于 xv6 的操作系统课程，覆盖进程、系统调用、页表、中断、文件系统等核心内容',
        href: 'https://github.com/xiyuan1avery/-MIT-6.S081-Operating-System-Engineering',
      },
      {
        title: '中国教科书开源仓库',
        desc: '收录从小学到大学的数学教材 PDF，完全免费开源',
        href: 'https://github.com/TapXWorld/ChinaTextbook',
      },
    ],
  },
  {
    name: 'AI 工具',
    items: [
      {
        title: 'Pixelle-Video',
        desc: '一站式 AI 短视频引擎，输入主题自动完成文案、配图、配音、背景音乐合成',
        href: 'https://github.com/AIDC-AI/Pixelle-Video',
      },
    ],
  },
];
---

<BaseLayout>
  <Navbar />
  <main id="main-content" class="min-h-screen pt-16">
    <div class="section-padding">
      <div class="content-width">
        <h1 class="text-4xl font-medium mb-12">收藏夹</h1>

        {categories.map((category) => (
          <div class="mb-12">
            <h2 class="text-xl font-medium mb-4">{category.name}</h2>
            <div class="grid gap-4 md:grid-cols-2">
              {category.items.map((item) => (
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group card-interactive p-6 relative"
                >
                  <span class="absolute top-4 right-4 text-ink-tertiary text-xs" aria-hidden="true">↗</span>
                  <h3 class="text-lg font-medium mb-2 group-hover:text-accent transition-colors">
                    {item.title}
                  </h3>
                  <p class="text-ink-secondary text-sm">
                    {item.desc}
                  </p>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
