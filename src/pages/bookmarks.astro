---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const categories = [
  {
    name: '工程实践',
    items: [
      {
        title: 'Harness 工程学习',
        desc: '系统学习 Harness 持续交付平台',
        href: 'https://walkinglabs.github.io/learn-harness-engineering/zh/',
      },
      {
        title: 'Engineering AI Agents',
        desc: 'AI Agents 工程实践指南，涵盖上下文管理、授权、成本控制等核心决策',
        href: 'https://agents.siddhantkhare.com/preface/',
      },
    ],
  },
  {
    name: '开发工具',
    items: [
      {
        title: 'Docus',
        desc: '基于 Nuxt 的文档站点生成工具，开箱即用，支持 Markdown 编写',
        href: 'https://docus.dev/en',
      },
    ],
  },
  {
    name: '生活工具',
    items: [
      {
        title: '证件照大师',
        desc: '在线证件照处理，支持换底色、压缩、剪切、排版等',
        href: 'https://id-photo.cn',
      },
      {
        title: '珍彩证件照',
        desc: '在线制作各类规格证件照，支持一寸、二寸等多种尺寸',
        href: 'https://zhengjianzhao.com',
      },
    ],
  },
  {
    name: '学习资源',
    items: [
      {
        title: 'MIT 6.S081 操作系统工程',
        desc: '基于 xv6 的操作系统课程，覆盖进程、系统调用、页表、中断、文件系统等核心内容',
        href: 'https://github.com/xiyuan1avery/-MIT-6.S081-Operating-System-Engineering',
      },
    ],
  },
  {
    name: 'AI 工具',
    items: [
      {
        title: 'Pixelle-Video',
        desc: '一站式 AI 短视频引擎，输入主题自动完成文案、配图、配音、背景音乐合成',
        href: 'https://github.com/AIDC-AI/Pixelle-Video',
      },
    ],
  },
];
---

<BaseLayout>
  <Navbar />
  <main class="min-h-screen pt-24">
    <div class="section-padding">
      <div class="max-w-3xl mx-auto">
        <h1 class="text-4xl font-semibold mb-12">收藏夹</h1>

        {categories.map((category) => (
          <div class="mb-12">
            <h2 class="text-xl font-semibold mb-4">{category.name}</h2>
            <div class="grid gap-4 md:grid-cols-2">
              {category.items.map((item) => (
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group bg-white border border-[#E5E5E0] p-6 rounded-xl transition-all hover:shadow-lg hover:border-[#9CA3AF] relative"
                >
                  <span class="absolute top-4 right-4 text-[#9CA3AF] text-xs">↗</span>
                  <h3 class="text-lg font-semibold mb-2 group-hover:text-[#E57035] transition-colors">
                    {item.title}
                  </h3>
                  <p class="text-[#6B6B6B] text-sm">
                    {item.desc}
                  </p>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
