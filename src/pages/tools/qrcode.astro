---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="二维码生成器 | 观禾·浮生观禾，静心成长"
  description="在线生成自定义二维码的实用工具。"
  robots="noindex, follow"
  bodyClass="dossier"
>
  <div class="grid-bg"></div>
  <div class="noise"></div>
  <div class="wm"><span class="a">又</span><span class="b">见</span></div>

  <header class="topbar">
    <div class="topbar-in">
      <div class="logo">朝</div>
      <div class="brand">
        <b>观禾</b>
        <small>浮生观禾，静心成长</small>
      </div>
      <div class="topbar-right">
        <span class="meta"><span class="dot"></span>在册</span>
        <span class="meta">NO. TLS-QR</span>
        <span class="meta" id="today">——</span>
      </div>
    </div>
  </header>

  <main class="dossier-main">
    <div class="container">
      <div class="page-head">
        <a class="back" href="/tools">← 返回工具间</a>
        <div class="head-stamp">TOOL · 二维码生成器</div>
      </div>

      <div class="page-title-row">
        <h1 class="page-title">二维码生成器 · <span class="rd">QR CODE</span></h1>
        <div class="page-rule"></div>
        <p class="page-sub">
          在线生成自定义二维码。<br>
          卷宗编号 <b>NO. TLS-QR</b>，下方为工具面板。
        </p>
      </div>

      <div class="tool-frame">
        <div class="tool-frame-head">
          <span class="dot-r"></span>
          <span class="dot-y"></span>
          <span class="dot-g"></span>
          <span class="frame-no">qrcode.html</span>
        </div>
        <iframe
          src="/tools/qrcode.html"
          title="二维码生成器"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </main>

  <style is:global>
    /* 复用首页 dossier 主题 token，与 404.astro 保持一致 */
    body.dossier {
      --paper: #f0e4cd;
      --paper-2: #e6dcc4;
      --paper-3: #fbfaf4;
      --ink: #171310;
      --ink-2: #2c241c;
      --red: #c13a2b;
      --red-deep: #8b2a1f;
      --manila: #d9a441;
      --manila-d: #b8862e;
      --border: #c9bea3;
      --text-primary: #1a1a1a;
      --text-secondary: #6b6b6b;
      background: var(--paper);
      color: var(--text-primary);
      font-family: 'Noto Serif SC', serif;
    }

    .grid-bg {
      background-image:
        linear-gradient(to right, rgba(27,19,16,.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(27,19,16,.04) 1px, transparent 1px);
      background-size: 48px 48px;
    }
    .noise {
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='180' height='180' filter='url(%23n)'/></svg>");
      opacity: .06;
      mix-blend-mode: multiply;
    }
    .grid-bg, .noise, .wm { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
    .wm { overflow: hidden; }
    .wm span {
      position: absolute;
      font-family: 'Noto Serif SC', serif;
      font-weight: 900;
      font-size: 46vw;
      color: transparent;
      -webkit-text-stroke: 1.5px rgba(27,19,16,.06);
      user-select: none;
      line-height: .8;
    }
    .wm .a { top: -12%; left: -7%; }
    .wm .b { bottom: -22%; right: -9%; }

    /* topbar */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 40;
      background: var(--paper);
      border-bottom: 2px solid var(--ink);
    }
    .topbar-in {
      width: min(1240px, 94vw);
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 11px 0;
    }
    .logo {
      width: 38px;
      height: 38px;
      background: var(--red);
      color: var(--paper);
      display: grid;
      place-items: center;
      font-family: 'Ma Shan Zheng', serif;
      font-size: 24px;
      box-shadow: 3px 3px 0 var(--ink);
      flex: none;
    }
    .brand {
      display: flex;
      flex-direction: column;
      line-height: 1.1;
    }
    .brand b {
      font-family: 'Noto Serif SC', serif;
      font-weight: 700;
      font-size: 15px;
      letter-spacing: .04em;
    }
    .brand small {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 9.5px;
      letter-spacing: .22em;
      color: var(--text-secondary);
      text-transform: uppercase;
      padding-top: 4px;
    }
    .topbar-right {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .meta {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10.5px;
      letter-spacing: .12em;
      color: var(--text-secondary);
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--red);
      box-shadow: 0 0 0 0 rgba(197,61,35,.6);
      animation: pulse 2.2s infinite;
    }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(197,61,35,.55); }
      70% { box-shadow: 0 0 0 8px rgba(197,61,35,0); }
      100% { box-shadow: 0 0 0 0 rgba(197,61,35,0); }
    }

    /* main */
    .dossier-main {
      position: relative;
      z-index: 1;
      padding: 56px 24px 100px;
    }
    .container {
      width: min(900px, 94vw);
      margin: 0 auto;
    }

    /* page head */
    .page-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 36px;
      flex-wrap: wrap;
    }
    .back {
      font-family: 'Noto Serif SC', serif;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 1.5px;
      color: var(--ink);
      text-decoration: none;
      padding: 8px 14px;
      border: 1.5px solid var(--ink);
      background: var(--paper-3);
      box-shadow: 3px 3px 0 var(--ink);
      transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    }
    .back:hover {
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0 var(--ink);
      background: var(--ink);
      color: var(--paper);
    }
    .head-stamp {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      letter-spacing: 3px;
      padding: 5px 12px;
      background: var(--ink);
      color: var(--paper);
      border-radius: 2px;
      transform: rotate(-1deg);
    }

    /* title row */
    .page-title-row {
      margin-bottom: 32px;
    }
    .page-title {
      font-family: 'Noto Serif SC', serif;
      font-weight: 900;
      font-size: clamp(28px, 4.2vw, 42px);
      letter-spacing: 3px;
      color: var(--ink);
      line-height: 1.2;
      margin-bottom: 16px;
    }
    .page-title .rd { color: var(--red); }
    .page-rule {
      width: 60px;
      height: 3px;
      background: var(--ink);
      margin-bottom: 18px;
    }
    .page-sub {
      font-family: 'Noto Serif SC', serif;
      font-size: 14px;
      line-height: 1.95;
      color: var(--text-secondary);
    }
    .page-sub b {
      color: var(--ink);
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12px;
      letter-spacing: 1.5px;
      margin: 0 2px;
    }

    /* tool frame */
    .tool-frame {
      position: relative;
      background: var(--paper-3);
      border: 1.5px solid var(--ink);
      box-shadow: 6px 6px 0 var(--ink);
      overflow: hidden;
    }
    .tool-frame::before {
      content: '';
      position: absolute;
      top: -1.5px;
      left: 24px;
      width: 80px;
      height: 4px;
      background: var(--red);
      z-index: 2;
    }
    .tool-frame-head {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 14px;
      background: var(--paper-2);
      border-bottom: 1.5px solid var(--ink);
    }
    .dot-r, .dot-y, .dot-g {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      border: 1px solid var(--ink);
    }
    .dot-r { background: var(--red); }
    .dot-y { background: var(--manila); }
    .dot-g { background: #6b8e4e; }
    .frame-no {
      margin-left: auto;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      letter-spacing: 1.5px;
      color: var(--text-secondary);
      text-transform: uppercase;
    }
    .tool-frame iframe {
      display: block;
      width: 100%;
      height: 80vh;
      min-height: 600px;
      border: 0;
      background: #fff;
    }

    @media (max-width: 720px) {
      .tool-frame { box-shadow: 4px 4px 0 var(--ink); }
      .tool-frame iframe { height: 70vh; min-height: 500px; }
      .page-title { letter-spacing: 2px; }
      .brand small { display: none; }
    }
  </style>

  <script is:client>
    (function() {
      const el = document.getElementById('today');
      if (!el) return;
      try {
        const now = new Date();
        const fmt = new Intl.DateTimeFormat('zh-CN', {
          timeZone: 'Asia/Shanghai',
          year: 'numeric', month: '2-digit', day: '2-digit',
          hour: '2-digit', minute: '2-digit', hour12: false
        });
        el.textContent = fmt.format(now).replace(/\//g, '.');
      } catch (e) {
        el.textContent = '——';
      }
    })();
  </script>
</BaseLayout>
