---
import BaseLayout from '../../layouts/BaseLayout.astro';

const siteBase = Astro.site ?? new URL('https://www.wangjianchao.cn');
const canonicalURL = new URL(Astro.url.pathname, siteBase).href;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "首页", "item": siteBase.href },
    { "@type": "ListItem", "position": 2, "name": "工具间", "item": new URL('/tools', siteBase).href },
    { "@type": "ListItem", "position": 3, "name": "Markdown 转微信公众号", "item": canonicalURL },
  ],
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Markdown 转微信公众号",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "url": canonicalURL,
  "description": "将 Markdown 内容一键转换为微信公众号编辑器可直接粘贴的富文本格式。",
  "author": { "@type": "Person", "name": "语霖", "url": siteBase.href },
  "inLanguage": "zh-CN",
};
---

<BaseLayout
  title="Markdown 转微信公众号 · UTILITIES | 语霖 · WANGJIANCHAO.CN"
  description="将 Markdown 内容一键转换为微信公众号编辑器可直接粘贴的富文本格式。"
  bodyClass="dossier dossier-home"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  </Fragment>

  <div id="pb"></div>

  <!-- 顶栏导航 -->
  <header class="topbar-home">
    <div class="topbar-in wrap bar">
      <a class="brand" href="/">
        <span class="seal-s">语</span>
        <span class="brand-name">语霖</span>
      </a>
      <nav>
        <a href="/#research">研究</a>
        <a href="/#system">系统</a>
        <a href="/#projects">项目</a>
        <a href="/tools" style="color: var(--los-seal);">工具</a>
        <a href="/#about">关于</a>
      </nav>
    </div>
  </header>

  <main style="padding: 40px 0 100px;">
    <div class="wrap">
      <!-- 面包屑导航与标识 -->
      <div class="sub-tool-bar rv">
        <nav class="breadcrumb-nav-dossier" aria-label="面包屑导航">
          <ol class="breadcrumb-list-dossier">
            <li><a href="/">首页</a></li>
            <li class="sep">/</li>
            <li><a href="/tools">工具间</a></li>
            <li class="sep">/</li>
            <li class="active" aria-current="page">Markdown 转微信公众号</li>
          </ol>
        </nav>
        <span class="tool-stamp-badge">TOOL · TLS-MWX</span>
      </div>

      <!-- 标题章头 -->
      <div class="ch-head rv" style="margin-bottom: 24px;">
        <span class="ch-no">TLS-MWX</span>
        <h2>Markdown 转公众号</h2>
        <span class="ch-en">MARKDOWN TO WECHAT</span>
        <i class="ch-line"></i>
      </div>

      <p class="tool-page-desc rv">
        将 Markdown 内容转换为微信公众号编辑器可无缝粘贴的优雅富文本排版。<br />
        卷宗编号 <b>NO. TLS-MWX</b>，纯前端安全渲染，不传输任何私密内容。
      </p>

      <!-- 工具面板容器 -->
      <div class="tool-frame rv">
        <div class="tool-frame-head">
          <span class="dot-r"></span>
          <span class="dot-y"></span>
          <span class="dot-g"></span>
          <span class="frame-no">md-to-wechat.html</span>
        </div>
        <iframe
          src="/tools/md-to-wechat.html"
          title="Markdown 转微信公众号"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </main>

  <!-- 落款 Footer -->
  <footer class="end-footer">
    <div class="wrap end">
      <div class="seal-square seal-lg" role="img" aria-label="语霖之印">
        <span>语</span><span>霖</span><span>之</span><span>印</span>
      </div>
      <p class="f-motto">执笔为语 · 心落成霖</p>
      <div class="f-meta">
        <span>© 2026 语霖 · WANGJIANCHAO.CN</span>
        <a href="#top">回到页首 ↑</a>
      </div>
    </div>
  </footer>

  <style is:global>
    /* 面包屑与顶部栏 */
    body.dossier-home .sub-tool-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 28px;
    }
    body.dossier-home .breadcrumb-nav-dossier {
      font-family: var(--los-mono);
      font-size: 12px;
      letter-spacing: .12em;
    }
    body.dossier-home .breadcrumb-list-dossier {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      list-style: none;
      padding: 0;
      margin: 0;
      color: var(--los-ink2);
    }
    body.dossier-home .breadcrumb-list-dossier a {
      color: var(--los-ink);
      text-decoration: none;
      transition: color .25s;
    }
    body.dossier-home .breadcrumb-list-dossier a:hover {
      color: var(--los-seal);
      text-decoration: underline;
    }
    body.dossier-home .breadcrumb-list-dossier .sep {
      color: var(--los-line);
    }
    body.dossier-home .breadcrumb-list-dossier .active {
      color: var(--los-seal);
      font-weight: 700;
    }
    body.dossier-home .tool-stamp-badge {
      font-family: var(--los-mono);
      font-size: 11px;
      letter-spacing: 2px;
      padding: 4px 10px;
      background: var(--los-seal);
      color: var(--los-paper);
      border-radius: 2px;
    }
    body.dossier-home .tool-page-desc {
      font-size: 15px;
      line-height: 1.85;
      color: var(--los-ink2);
      margin-bottom: 32px;
    }
    body.dossier-home .tool-page-desc b {
      font-family: var(--los-mono);
      font-size: 13px;
      color: var(--los-ink);
      letter-spacing: 1px;
    }

    /* 工具 Frame 容器 */
    body.dossier-home .tool-frame {
      background: var(--los-paper-3, #fbfaf4);
      border: 1px solid var(--los-line);
      box-shadow: 0 8px 24px rgba(193, 58, 43, 0.05);
      overflow: hidden;
      margin-top: 20px;
    }
    body.dossier-home .tool-frame-head {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 12px 18px;
      background: var(--los-paper-3, #fbfaf4);
      border-bottom: 1px solid var(--los-line);
    }
    body.dossier-home .dot-r,
    body.dossier-home .dot-y,
    body.dossier-home .dot-g {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }
    body.dossier-home .dot-r { background: var(--los-seal); }
    body.dossier-home .dot-y { background: #d9a441; }
    body.dossier-home .dot-g { background: #6b8e4e; }
    body.dossier-home .frame-no {
      margin-left: auto;
      font-family: var(--los-mono);
      font-size: 11px;
      letter-spacing: 1.5px;
      color: var(--los-ink2);
    }
    body.dossier-home .tool-frame iframe {
      display: block;
      width: 100%;
      height: 82vh;
      min-height: 640px;
      border: 0;
      background: #ffffff;
    }
  </style>

  <script is:inline>
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.rv').forEach((el) => io.observe(el));

    window.addEventListener('scroll', () => {
      const pb = document.getElementById('pb');
      if (!pb) return;
      const h = document.documentElement.scrollHeight - window.innerHeight;
      pb.style.width = (h > 0 ? (window.scrollY / h) * 100 : 0) + '%';
    });
  </script>
</BaseLayout>
