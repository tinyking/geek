---
import BaseLayout from '../../layouts/BaseLayout.astro';

const tools = [
  {
    title: '封面生成器',
    desc: '快速生成公众号封面图',
    href: '/tools/cover',
    icon: '🎨',
    external: false,
    no: 'TLS-CVR',
  },
  {
    title: 'Markdown 转微信公众号',
    desc: '将 Markdown 格式转换为微信公众号可用的格式',
    href: '/tools/md-to-wechat',
    icon: '📝',
    external: false,
    no: 'TLS-MWX',
  },
  {
    title: 'Markdown 转 X (Twitter)',
    desc: '将 Markdown 内容转换为 X 平台的格式',
    href: '/tools/md-to-x',
    icon: '𝕏',
    external: false,
    no: 'TLS-MDX',
  },
  {
    title: '二维码生成器',
    desc: '快速生成各种二维码',
    href: '/tools/qrcode',
    icon: '📱',
    external: false,
    no: 'TLS-QR',
  },
  {
    title: 'Z2H 字符转换',
    desc: '全角 / 半角字符互转，快速处理中文排版问题',
    href: 'https://z2h.cn',
    icon: '🔤',
    external: true,
    no: 'TLS-EXT',
  },
];
---

<BaseLayout
  title="工具 · TOOLS | 阅微漫记"
  description="语霖的在线工具集合 — 封面生成器、Markdown 转微信公众号等实用小工具。"
  robots="noindex, follow"
  bodyClass="dossier"
>
  <div class="grid-bg"></div>
  <div class="noise"></div>
  <div class="wm"><span class="a">又</span><span class="b">见</span></div>

  <header class="topbar">
    <div class="topbar-in">
      <div class="logo">朝</div>
      <div class="brand">
        <b>观禾</b>
        <small>浮生观禾，静心成长</small>
      </div>
      <div class="topbar-right">
        <span class="meta"><span class="dot"></span>在册</span>
        <span class="meta">NO. TLS</span>
        <span class="meta" id="today">——</span>
      </div>
    </div>
  </header>

  <main class="dossier-main">
    <div class="container">
      <div class="page-head">
        <a class="back" href="/">← 返回首页</a>
        <div class="head-stamp">TOOLS · 工具间</div>
      </div>

      <div class="page-title-row">
        <h1 class="page-title">工具 · <span class="rd">TOOLS</span></h1>
        <div class="page-rule"></div>
        <p class="page-sub">
          收存几件常用的小工具 — 封面、转换、二维码。<br>
          卷宗编号 <b>NO. TLS</b>，按需取用，悉听尊便。
        </p>
      </div>

      <div class="folder-grid">
        {tools.map((tool) => (
          <a
            class="folder-card"
            href={tool.href}
            target={tool.external ? '_blank' : '_self'}
            rel={tool.external ? 'noopener noreferrer' : undefined}
          >
            <div class="folder-tape"></div>
            <div class="folder-no">NO. {tool.no}</div>
            {tool.external && (
              <span class="folder-ext" aria-hidden="true">↗ 外链</span>
            )}
            <div class="folder-icon" aria-hidden="true">{tool.icon}</div>
            <h2 class="folder-title">{tool.title}</h2>
            <p class="folder-desc">{tool.desc}</p>
            <div class="folder-foot">
              <span class="folder-link">开启 →</span>
              <span class="folder-seal">观禾</span>
            </div>
          </a>
        ))}
      </div>

      <div class="page-foot">
        <span><b>合计</b> · {tools.length} 件</span>
        <span><b>状态</b> · 在册</span>
        <span><b>更新</b> · 随用随修</span>
      </div>
    </div>
  </main>

  <style is:global>
    /* 复用首页 dossier 主题 token，与 404.astro 保持一致 */
    body.dossier {
      --paper: #f0e4cd;
      --paper-2: #e6dcc4;
      --paper-3: #fbfaf4;
      --ink: #171310;
      --ink-2: #2c241c;
      --red: #c13a2b;
      --red-deep: #8b2a1f;
      --manila: #d9a441;
      --manila-d: #b8862e;
      --border: #c9bea3;
      --text-primary: #1a1a1a;
      --text-secondary: #6b6b6b;
      background: var(--paper);
      color: var(--text-primary);
      font-family: 'Noto Serif SC', serif;
    }

    .grid-bg {
      background-image:
        linear-gradient(to right, rgba(27,19,16,.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(27,19,16,.04) 1px, transparent 1px);
      background-size: 48px 48px;
    }
    .noise {
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='180' height='180' filter='url(%23n)'/></svg>");
      opacity: .06;
      mix-blend-mode: multiply;
    }
    .grid-bg, .noise, .wm { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
    .wm { overflow: hidden; }
    .wm span {
      position: absolute;
      font-family: 'Noto Serif SC', serif;
      font-weight: 900;
      font-size: 46vw;
      color: transparent;
      -webkit-text-stroke: 1.5px rgba(27,19,16,.06);
      user-select: none;
      line-height: .8;
    }
    .wm .a { top: -12%; left: -7%; }
    .wm .b { bottom: -22%; right: -9%; }

    /* topbar */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 40;
      background: var(--paper);
      border-bottom: 2px solid var(--ink);
    }
    .topbar-in {
      width: min(1240px, 94vw);
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 11px 0;
    }
    .logo {
      width: 38px;
      height: 38px;
      background: var(--red);
      color: var(--paper);
      display: grid;
      place-items: center;
      font-family: 'Ma Shan Zheng', serif;
      font-size: 24px;
      box-shadow: 3px 3px 0 var(--ink);
      flex: none;
    }
    .brand {
      display: flex;
      flex-direction: column;
      line-height: 1.1;
    }
    .brand b {
      font-family: 'Noto Serif SC', serif;
      font-weight: 700;
      font-size: 15px;
      letter-spacing: .04em;
    }
    .brand small {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 9.5px;
      letter-spacing: .22em;
      color: var(--text-secondary);
      text-transform: uppercase;
      padding-top: 4px;
    }
    .topbar-right {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .meta {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10.5px;
      letter-spacing: .12em;
      color: var(--text-secondary);
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--red);
      box-shadow: 0 0 0 0 rgba(197,61,35,.6);
      animation: pulse 2.2s infinite;
    }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(197,61,35,.55); }
      70% { box-shadow: 0 0 0 8px rgba(197,61,35,0); }
      100% { box-shadow: 0 0 0 0 rgba(197,61,35,0); }
    }

    /* main */
    .dossier-main {
      position: relative;
      z-index: 1;
      padding: 56px 24px 100px;
    }
    .container {
      width: min(1080px, 100%);
      margin: 0 auto;
    }

    /* page head */
    .page-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 36px;
      flex-wrap: wrap;
    }
    .back {
      font-family: 'Noto Serif SC', serif;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 1.5px;
      color: var(--ink);
      text-decoration: none;
      padding: 8px 14px;
      border: 1.5px solid var(--ink);
      background: var(--paper-3);
      box-shadow: 3px 3px 0 var(--ink);
      transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    }
    .back:hover {
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0 var(--ink);
      background: var(--ink);
      color: var(--paper);
    }
    .head-stamp {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      letter-spacing: 3px;
      padding: 5px 12px;
      background: var(--ink);
      color: var(--paper);
      border-radius: 2px;
      transform: rotate(-1deg);
    }

    /* title row */
    .page-title-row {
      margin-bottom: 44px;
    }
    .page-title {
      font-family: 'Noto Serif SC', serif;
      font-weight: 900;
      font-size: clamp(32px, 5vw, 52px);
      letter-spacing: 4px;
      color: var(--ink);
      line-height: 1.2;
      margin-bottom: 18px;
    }
    .page-title .rd { color: var(--red); }
    .page-rule {
      width: 60px;
      height: 3px;
      background: var(--ink);
      margin-bottom: 22px;
    }
    .page-sub {
      font-family: 'Noto Serif SC', serif;
      font-size: 15px;
      line-height: 2;
      color: var(--text-secondary);
      max-width: 640px;
    }
    .page-sub b {
      color: var(--ink);
      font-family: 'IBM Plex Mono', monospace;
      font-size: 13px;
      letter-spacing: 1.5px;
      margin: 0 2px;
    }

    /* folder grid */
    .folder-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
    .folder-card {
      position: relative;
      background: var(--paper-3);
      border: 1.5px solid var(--ink);
      box-shadow: 6px 6px 0 var(--ink);
      padding: 32px 28px 24px;
      text-decoration: none;
      color: var(--ink);
      transition: transform .2s, box-shadow .2s;
      display: flex;
      flex-direction: column;
      min-height: 220px;
    }
    .folder-card::before {
      content: '';
      position: absolute;
      top: -1.5px;
      left: 24px;
      width: 80px;
      height: 4px;
      background: var(--red);
    }
    .folder-card:hover {
      transform: translate(-3px, -3px);
      box-shadow: 9px 9px 0 var(--ink);
    }
    .folder-tape {
      position: absolute;
      top: -10px;
      right: 28px;
      width: 56px;
      height: 18px;
      background: rgba(217,164,65,.65);
      border: 1px dashed rgba(27,19,16,.3);
      transform: rotate(3deg);
    }
    .folder-no {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10.5px;
      letter-spacing: 2px;
      color: var(--text-secondary);
      text-transform: uppercase;
      margin-bottom: 18px;
    }
    .folder-ext {
      position: absolute;
      top: 14px;
      right: 18px;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      letter-spacing: 1.5px;
      color: var(--red);
      border: 1px solid var(--red);
      padding: 2px 6px;
    }
    .folder-icon {
      font-size: 38px;
      line-height: 1;
      margin-bottom: 14px;
      font-family: 'IBM Plex Mono', monospace;
    }
    .folder-title {
      font-family: 'Noto Serif SC', serif;
      font-weight: 700;
      font-size: 20px;
      letter-spacing: 1.5px;
      color: var(--ink);
      margin-bottom: 8px;
    }
    .folder-desc {
      font-family: 'Noto Serif SC', serif;
      font-size: 13.5px;
      line-height: 1.85;
      color: var(--text-secondary);
      flex: 1;
    }
    .folder-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px dashed var(--border);
    }
    .folder-link {
      font-family: 'Noto Serif SC', serif;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 2px;
      color: var(--red);
    }
    .folder-seal {
      font-family: 'Ma Shan Zheng', serif;
      font-size: 14px;
      color: var(--red);
      border: 1.5px solid var(--red);
      padding: 2px 8px;
      letter-spacing: 2px;
      transform: rotate(-3deg);
      opacity: .85;
    }

    /* page foot */
    .page-foot {
      display: flex;
      gap: 32px;
      flex-wrap: wrap;
      margin-top: 48px;
      padding-top: 24px;
      border-top: 1px dashed var(--border);
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      letter-spacing: 1.5px;
      color: var(--text-secondary);
      text-transform: uppercase;
    }
    .page-foot b {
      color: var(--ink);
      font-weight: 700;
      margin-right: 6px;
    }

    @media (max-width: 720px) {
      .folder-grid { grid-template-columns: 1fr; }
      .folder-card { padding: 24px 20px 18px; box-shadow: 4px 4px 0 var(--ink); }
      .folder-card:hover { box-shadow: 6px 6px 0 var(--ink); }
      .page-title { letter-spacing: 2px; }
      .brand small { display: none; }
    }
  </style>

  <script is:client>
    (function() {
      const el = document.getElementById('today');
      if (!el) return;
      try {
        const now = new Date();
        const fmt = new Intl.DateTimeFormat('zh-CN', {
          timeZone: 'Asia/Shanghai',
          year: 'numeric', month: '2-digit', day: '2-digit',
          hour: '2-digit', minute: '2-digit', hour12: false
        });
        el.textContent = fmt.format(now).replace(/\//g, '.');
      } catch (e) {
        el.textContent = '——';
      }
    })();
  </script>
</BaseLayout>
