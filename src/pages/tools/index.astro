---
import BaseLayout from '../../layouts/BaseLayout.astro';

const tools = [
  {
    title: '封面生成器',
    desc: '快速生成公众号封面图，支持极简美学排版与一键导出高清晰图片。',
    href: '/tools/cover',
    icon: '🎨',
    external: false,
    no: 'TLS-CVR',
    tag: '视觉排版',
  },
  {
    title: 'Markdown 转微信公众号',
    desc: '将 Markdown 内容一键渲染为微信公众号编辑器支持的富文本美观格式。',
    href: '/tools/md-to-wechat',
    icon: '📝',
    external: false,
    no: 'TLS-MWX',
    tag: '文本编辑',
  },
  {
    title: 'Markdown 转 X (Twitter)',
    desc: '格式化转换推文长文与长图排版，适合多平台社交媒体高效分发。',
    href: '/tools/md-to-x',
    icon: '𝕏',
    external: false,
    no: 'TLS-MDX',
    tag: '社交分发',
  },
  {
    title: '二维码生成器',
    desc: '在线一键生成高清晰度二维码，支持自定义容错率与尺寸参数。',
    href: '/tools/qrcode',
    icon: '📱',
    external: false,
    no: 'TLS-QR',
    tag: '实用工具',
  },
  {
    title: 'Z2H 字符转换',
    desc: '全角与半角字符快速互转，精准解决中英文标点与数字排版规范问题。',
    href: 'https://z2h.cn',
    icon: '🔤',
    external: true,
    no: 'TLS-EXT',
    tag: '文本处理',
  },
];
const siteBase = Astro.site ?? new URL('https://www.wangjianchao.cn');
const canonicalURL = new URL(Astro.url.pathname, siteBase).href;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "首页", "item": siteBase.href },
    { "@type": "ListItem", "position": 2, "name": "工具间", "item": canonicalURL },
  ],
};

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "工具间",
  "description": "语霖的在线工具集合 — 封面生成器、Markdown 转微信公众号、Markdown 转 X、二维码生成器等实用工具。",
  "url": canonicalURL,
  "inLanguage": "zh-CN",
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": tools.length,
    "itemListElement": tools.map((tool, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": tool.title,
      "url": tool.external ? tool.href : new URL(tool.href, siteBase).href,
    })),
  },
};
---

<BaseLayout
  title="工具间 · UTILITIES | 语霖 · WANGJIANCHAO.CN"
  description="语霖的在线工具集合 — 封面生成器、Markdown 转微信公众号、Markdown 转 X、二维码生成器等实用工具。"
  bodyClass="dossier dossier-home"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  </Fragment>

  <!-- 阅读进度线 -->
  <div id="pb"></div>

  <!-- 顶栏导航 -->
  <header class="topbar-home">
    <div class="topbar-in wrap bar">
      <a class="brand" href="/">
        <span class="seal-s">语</span>
        <span class="brand-name">语霖</span>
      </a>
      <nav>
        <a href="/#research">研究</a>
        <a href="/#system">系统</a>
        <a href="/#projects">项目</a>
        <a href="/tools" style="color: var(--los-seal);">工具</a>
        <a href="/#about">关于</a>
      </nav>
    </div>
  </header>

  <main style="padding: 40px 0 100px;">
    <div class="wrap">
      <!-- 面包屑导航 -->
      <nav class="breadcrumb-nav-dossier" aria-label="面包屑导航" style="margin-bottom: 28px;">
        <ol class="breadcrumb-list-dossier">
          <li><a href="/">首页</a></li>
          <li class="sep">/</li>
          <li class="active" aria-current="page">工具间</li>
        </ol>
      </nav>

      <!-- 章节章头 -->
      <div class="ch-head rv">
        <span class="ch-no">05</span>
        <h2>工具间</h2>
        <span class="ch-en">UTILITIES & TOOLS</span>
        <i class="ch-line"></i>
      </div>

      <!-- 首页同款 .split 双栏 sticky 结构 -->
      <div class="split">
        <!-- 左侧 sticky 栏 -->
        <div class="left rv">
          <h3>工欲善其事，<br>必先<em>利其器</em>。</h3>
          <p style="font-size: 15px; line-height: 1.95; margin-bottom: 24px;">
            收存几件日常写作、排版、公众号运营与推广用的小工具。<br />
            无广告、免登录、纯前端运行，专注于提升创作全链路效能。<br />
            卷宗编号 <b>NO. TLS</b>。
          </p>
          <div class="series-meta-sum">
            <span><b>{tools.length}</b> 件工具</span>
            <span><b class="on">在册运行</b></span>
          </div>

          <!-- 侧栏状态读出 -->
          <div class="side-readout-box" style="margin-top: 36px; display: flex; gap: 16px;">
            <div class="side-stat-item">
              <span class="s-num">05</span>
              <span class="s-txt">收录工具</span>
            </div>
            <div class="side-stat-item">
              <span class="s-num">100%</span>
              <span class="s-txt">免登可用</span>
            </div>
          </div>
        </div>

        <!-- 右侧工具卡片网格 -->
        <div class="right">
          <div class="tools-dir-grid">
            {tools.map((tool) => (
              <a
                class="t-card rv"
                href={tool.href}
                target={tool.external ? '_blank' : '_self'}
                rel={tool.external ? 'noopener noreferrer' : undefined}
              >
                <div class="t-top">
                  <span class="t-no">{tool.no}</span>
                  <span class="t-tag">{tool.tag}</span>
                </div>
                <div class="t-head">
                  <span class="t-icon">{tool.icon}</span>
                  <h4>{tool.title}</h4>
                </div>
                <p class="t-desc">{tool.desc}</p>
                <div class="t-foot">
                  <span class="t-link">
                    {tool.external ? '开启外链 ↗' : '使用工具 →'}
                  </span>
                  <span class="t-seal">语霖</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- 落款 Footer -->
  <footer class="end-footer">
    <div class="wrap end">
      <div class="seal-square seal-lg" role="img" aria-label="语霖之印">
        <span>语</span><span>霖</span><span>之</span><span>印</span>
      </div>
      <p class="f-motto">执笔为语 · 心落成霖</p>
      <div class="f-meta">
        <span>© 2026 语霖 · WANGJIANCHAO.CN</span>
        <a href="#top">回到页首 ↑</a>
      </div>
    </div>
  </footer>

  <style is:global>
    /* 面包屑导航样式 */
    body.dossier-home .breadcrumb-nav-dossier {
      font-family: var(--los-mono);
      font-size: 12px;
      letter-spacing: .12em;
    }
    body.dossier-home .breadcrumb-list-dossier {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      list-style: none;
      padding: 0;
      margin: 0;
      color: var(--los-ink2);
    }
    body.dossier-home .breadcrumb-list-dossier a {
      color: var(--los-ink);
      text-decoration: none;
      transition: color .25s;
    }
    body.dossier-home .breadcrumb-list-dossier a:hover {
      color: var(--los-seal);
      text-decoration: underline;
    }
    body.dossier-home .breadcrumb-list-dossier .sep {
      color: var(--los-line);
    }
    body.dossier-home .breadcrumb-list-dossier .active {
      color: var(--los-seal);
      font-weight: 700;
    }

    /* 侧栏微型读出块 */
    body.dossier-home .side-stat-item {
      background: var(--los-paper-3, #fbfaf4);
      border: 1px solid var(--los-line);
      padding: 14px 20px;
      flex: 1;
      text-align: center;
    }
    body.dossier-home .side-stat-item .s-num {
      display: block;
      font-family: var(--los-mono);
      font-size: 20px;
      font-weight: 700;
      color: var(--los-seal);
      line-height: 1.1;
      margin-bottom: 2px;
    }
    body.dossier-home .side-stat-item .s-txt {
      font-family: var(--los-mono);
      font-size: 11px;
      letter-spacing: 1px;
      color: var(--los-ink2);
    }

    /* 工具卡片网格 */
    body.dossier-home .tools-dir-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
    body.dossier-home .tools-dir-grid .t-card {
      background: var(--los-paper-3, #fbfaf4);
      border: 1px solid var(--los-line);
      padding: 26px 22px 20px;
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: var(--los-ink);
      transition: transform .25s, border-color .25s, background-color .25s, box-shadow .25s;
      position: relative;
    }
    body.dossier-home .tools-dir-grid .t-card:hover {
      transform: translateY(-4px);
      border-color: var(--los-seal);
      background: #ffffff;
      box-shadow: 0 8px 24px rgba(193, 58, 43, 0.08);
    }
    body.dossier-home .tools-dir-grid .t-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }
    body.dossier-home .tools-dir-grid .t-no {
      font-family: var(--los-mono);
      font-size: 11px;
      letter-spacing: .2em;
      color: var(--los-ink2);
    }
    body.dossier-home .tools-dir-grid .t-tag {
      font-family: var(--los-mono);
      font-size: 10px;
      letter-spacing: 1px;
      padding: 2px 8px;
      background: var(--los-fig, #fafaf8);
      border: 1px solid var(--los-line);
      color: var(--los-ink2);
    }
    body.dossier-home .tools-dir-grid .t-head {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
    }
    body.dossier-home .tools-dir-grid .t-icon {
      font-size: 26px;
      line-height: 1;
    }
    body.dossier-home .tools-dir-grid .t-head h4 {
      font-family: var(--los-serif);
      font-weight: 700;
      font-size: 19px;
      color: var(--los-ink);
      margin: 0;
      transition: color .25s;
    }
    body.dossier-home .tools-dir-grid .t-card:hover .t-head h4 {
      color: var(--los-seal);
    }
    body.dossier-home .tools-dir-grid .t-desc {
      font-size: 14px;
      line-height: 1.8;
      color: var(--los-ink2);
      margin-bottom: 22px;
      flex: 1;
    }
    body.dossier-home .tools-dir-grid .t-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 14px;
      border-top: 1px dashed var(--los-line);
    }
    body.dossier-home .tools-dir-grid .t-link {
      font-family: var(--los-mono);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1px;
      color: var(--los-seal);
      transition: letter-spacing .2s;
    }
    body.dossier-home .tools-dir-grid .t-card:hover .t-link {
      letter-spacing: 2px;
    }
    body.dossier-home .tools-dir-grid .t-seal {
      font-family: 'Ma Shan Zheng', var(--los-serif);
      font-size: 13px;
      color: var(--los-seal);
      border: 1px solid var(--los-seal);
      padding: 1px 6px;
      letter-spacing: 1.5px;
      opacity: .85;
      transform: rotate(-2deg);
    }

    @media (max-width: 820px) {
      body.dossier-home .tools-dir-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <!-- 显现与阅读进度逻辑 -->
  <script is:inline>
    // 显现逻辑
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.rv').forEach((el) => io.observe(el));

    // 阅读进度
    window.addEventListener('scroll', () => {
      const pb = document.getElementById('pb');
      if (!pb) return;
      const h = document.documentElement.scrollHeight - window.innerHeight;
      pb.style.width = (h > 0 ? (window.scrollY / h) * 100 : 0) + '%';
    });
  </script>
</BaseLayout>
