---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SERIES, STATUS_CLASS } from '../../../data/series';
import AdUnit from '../../../components/AdUnit.astro';
import { ARTICLE_BODY_MAP, createFallbackBody, type Block } from '../../../data/series-articles';

export function getStaticPaths() {
  const paths: Array<{
    params: { id: string; no: string };
    props: { series: typeof SERIES[number]; article: typeof SERIES[number]['articles'][number]; index: number; total: number };
  }> = [];
  SERIES.forEach((s) => {
    s.articles.forEach((a, i) => {
      paths.push({
        params: { id: s.id, no: a.no },
        props: { series: s, article: a, index: i, total: s.articles.length }
      });
    });
  });
  return paths;
}

interface Props {
  series: typeof SERIES[number];
  article: typeof SERIES[number]['articles'][number];
  index: number;
  total: number;
}
const { series, article, index, total } = Astro.props;

const stampClass = STATUS_CLASS[series.status] || 'run';
const statusEn = series.status === '连载中' ? 'ONGOING'
  : series.status === '已完结' ? 'COMPLETED'
  : 'IRREGULAR';

// 上一篇 / 下一篇
const prev = index > 0 ? series.articles[index - 1] : null;
const next = index < total - 1 ? series.articles[index + 1] : null;

// 顶部日期（北京时间）
const fmt = new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai',
  year: 'numeric', month: '2-digit', day: '2-digit',
  weekday: 'short'
});
const parts = fmt.formatToParts(new Date());
const get = (t: string) => parts.find(p => p.type === t)?.value ?? '';
const today = `${get('year')}.${get('month')}.${get('day')} · ${get('weekday')}`;

const pageTitle = `${article.title} · ${series.title}`;
const pageDesc = `${series.desc} — ${article.title}（发表于 ${article.date}）`;

const siteBase = Astro.site ?? new URL('https://www.wangjianchao.cn');
const canonicalURL = new URL(Astro.url.pathname, siteBase).href;

// 面包屑结构化数据
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "首页", "item": siteBase.href },
    { "@type": "ListItem", "position": 2, "name": series.title, "item": new URL(`/series/${series.id}`, siteBase).href },
    { "@type": "ListItem", "position": 3, "name": article.title, "item": canonicalURL },
  ],
};

// 文章正文：按 series.id + article.no 查找真实内容，未命中则 fallback 到占位
const articleBody = ARTICLE_BODY_MAP[`${series.id}:${article.no}`] ?? createFallbackBody(series.desc, article.no, article.date);
---

<BaseLayout title={pageTitle} description={pageDesc} ogType="article" bodyClass="dossier dossier-article">
  <div class="grid-bg"></div>
  <div class="noise"></div>
  <div class="wm"><span class="a">又</span><span class="b">见</span></div>

  <div class="app">

    <!-- TOPBAR -->
    <header class="topbar">
      <div class="topbar-in">
        <a class="logo" href="/" aria-label="返回首页">朝</a>
        <div class="brand">
          <b>观禾</b>
          <small>浮生观禾，静心成长</small>
        </div>
        <div class="topbar-right">
          <span class="meta"><span class="dot"></span>ONLINE</span>
          <span class="meta">{series.tab} · NO.{article.no}</span>
          <span class="meta" id="today">{today}</span>
        </div>
      </div>
    </header>

    <main>
      <!-- ARTICLE HEAD -->
      <section class="article-cover" id="cover">
        <div class="container">
          <a class="back-link" href={`/series/${series.id}`} aria-label={`返回 ${series.title} 专辑`}>
            <span class="arrow">←</span>
            <span>返回专辑 RETURN TO SERIES</span>
          </a>

          <article class="article-hero reveal">
            <div class="article-meta-row">
              <span class="series-tab">{series.tab}</span>
              <a class="series-link" href={`/series/${series.id}`}>{series.title}</a>
              <span class="article-no-tag">NO.{article.no} / {String(total).padStart(3, '0')}</span>
            </div>

            <h1 class="article-title">{article.title}</h1>

            <div class="article-meta-row sub">
              <span class="meta-item"><b class={`stamp-dot ${stampClass}`}>●</b>{series.status}</span>
              <span class="meta-item date">{article.date}</span>
              <span class="meta-item">{statusEn}</span>
            </div>

            <div class="article-stamp-pad">
              <div class={`article-stamp ${stampClass}`}>
                <span class="article-stamp-cn">{series.status}</span>
                <span class="article-stamp-en">{statusEn}</span>
              </div>
            </div>
          </article>
        </div>
      </section>

      <!-- ARTICLE BODY -->
      <section id="body">
        <div class="container">
          <div class="ad-top">
            <AdUnit slot="6252683541" format="auto" label="文章顶部广告" />
          </div>

          <div class="article-body reveal">
            {articleBody.map((block) => {
              if (block.type === 'h2') {
                return (
                  <h2 class="prose-h2">
                    {block.kicker && <span class="prose-kicker">{block.kicker}</span>}
                    <span class="prose-h2-text">{block.text}</span>
                  </h2>
                );
              } else if (block.type === 'h3') {
                return <h3 class="prose-h3">{block.text}</h3>;
              } else if (block.type === 'quote') {
                return <blockquote class="prose-quote">{block.text}</blockquote>;
              } else if (block.type === 'hr') {
                return <hr class="prose-hr" />;
              } else if (block.type === 'list') {
                return (
                  <ul class="prose-list">
                    {block.items.map((it) => <li>{it}</li>)}
                  </ul>
                );
              } else if (block.type === 'callout') {
                return (
                  <aside class="prose-callout">
                    <span class="prose-callout-mark">"</span>
                    <p class="prose-callout-text">{block.text}</p>
                  </aside>
                );
              } else if (block.type === 'code') {
                return (
                  <pre class="prose-code">
                    <span class="prose-code-title">text</span>
                    <code>{block.lines.join('\n')}</code>
                  </pre>
                );
              } else if (block.type === 'flow') {
                const nodes = block.nodes;
                const nodeH = 56;
                const gap = 40;
                const padding = 28;
                const width = 220;
                const height = padding * 2 + nodes.length * nodeH + (nodes.length - 1) * gap;
                const cx = width / 2;
                return (
                  <div class="prose-flow">
                    <svg viewBox={`0 0 ${width} ${height}`} xmlns="http://www.w3.org/2000/svg" role="img" aria-label="单点故障链路图">
                      <rect x="0" y="0" width={width} height={height} fill="var(--paper-3)" />
                      {nodes.map((label, i) => {
                        const y = padding + i * (nodeH + gap);
                        const isLast = i === nodes.length - 1;
                        const isRisk = isLast;
                        return (
                          <g>
                            {/* 节点框 */}
                            <rect
                              x={(width - 160) / 2}
                              y={y}
                              width="160"
                              height={nodeH}
                              rx="2"
                              fill={isRisk ? 'var(--red)' : 'var(--paper)'}
                              stroke="var(--ink)"
                              stroke-width="1.5"
                            />
                            {/* 节点偏移阴影（档案卷宗风） */}
                            <rect
                              x={(width - 160) / 2 + 4}
                              y={y + 4}
                              width="160"
                              height={nodeH}
                              rx="2"
                              fill="none"
                              stroke="var(--ink)"
                              stroke-width="1.5"
                              opacity="0.5"
                            />
                            {/* 节点编号小标签 */}
                            <rect
                              x={(width - 160) / 2 + 10}
                              y={y - 6}
                              width="36"
                              height="14"
                              fill="var(--ink)"
                            />
                            <text
                              x={(width - 160) / 2 + 28}
                              y={y + 4}
                              text-anchor="middle"
                              font-family="IBM Plex Mono, monospace"
                              font-size="9"
                              font-weight="700"
                              letter-spacing="1.5"
                              fill="var(--paper)"
                            >{`0${i + 1}`}</text>
                            {/* 节点文字 */}
                            <text
                              x={cx}
                              y={y + nodeH / 2 + 5}
                              text-anchor="middle"
                              font-family="Noto Serif SC, serif"
                              font-size={label.length > 7 ? 14 : 18}
                              font-weight="900"
                              fill={isRisk ? 'var(--paper)' : 'var(--ink)'}
                            >{label}</text>
                            {/* 连接箭头 */}
                            {!isLast && (
                              <g stroke="var(--ink)" stroke-width="1.5" fill="none">
                                <line
                                  x1={cx}
                                  y1={y + nodeH}
                                  x2={cx}
                                  y2={y + nodeH + gap - 6}
                                  stroke-dasharray="4 4"
                                />
                                <polygon
                                  points={`${cx - 5},${y + nodeH + gap - 6} ${cx + 5},${y + nodeH + gap - 6} ${cx},${y + nodeH + gap}`}
                                  fill="var(--ink)"
                                  stroke="none"
                                />
                              </g>
                            )}
                          </g>
                        );
                      })}
                      {/* 底部危险标签 */}
                      <g>
                        <rect
                          x={(width - 180) / 2}
                          y={height - 22}
                          width="180"
                          height="16"
                          fill="var(--red)"
                        />
                        <text
                          x={cx}
                          y={height - 11}
                          text-anchor="middle"
                          font-family="IBM Plex Mono, monospace"
                          font-size="8"
                          font-weight="700"
                          letter-spacing="1.2"
                          fill="var(--paper)"
                        >SINGLE POINT OF FAILURE</text>
                      </g>
                    </svg>
                  </div>
                );
              } else if (block.type === 'kvlist') {
                return (
                  <div class="prose-kvlist">
                    {block.pairs.map((pair, i) => (
                      <div class="kv-row" style={`--i:${i}`}>
                        <span class="kv-k">{pair.k}</span>
                        <span class="kv-arrow">→</span>
                        <span class="kv-v">{pair.v}</span>
                      </div>
                    ))}
                  </div>
                );
              } else if (block.type === 'architecture') {
                const branches = block.branches;
                const branchW = 150;
                const branchH = 64;
                const gap = 12;
                const padding = 20;
                const width = padding * 2 + branches.length * branchW + (branches.length - 1) * gap;
                const rootW = 100;
                const rootH = 32;
                const bottomH = 32;
                const connectorH = 20;
                const height = padding + rootH + connectorH + branchH + connectorH + bottomH + padding;
                const cx = width / 2;
                const rootY = padding;
                const branchY = rootY + rootH + connectorH;
                const bottomY = branchY + branchH + connectorH;
                return (
                  <div class="prose-arch">
                    <svg viewBox={`0 0 ${width} ${height}`} xmlns="http://www.w3.org/2000/svg" role="img" aria-label="人生系统架构图">
                      {/* 根节点 */}
                      <rect x={(width - rootW) / 2} y={rootY} width={rootW} height={rootH} rx="2" fill="var(--ink)" />
                      <text x={cx} y={rootY + rootH / 2 + 5} text-anchor="middle" font-family="Noto Serif SC, serif" font-size="14" font-weight="900" fill="var(--paper)">{block.root}</text>
                      {/* 根到分支的连接线 */}
                      <line x1={cx} y1={rootY + rootH} x2={cx} y2={rootY + rootH + connectorH / 2} stroke="var(--ink)" stroke-width="1.5" />
                      <line x1={padding + branchW / 2} y1={rootY + rootH + connectorH / 2} x2={width - padding - branchW / 2} y2={rootY + rootH + connectorH / 2} stroke="var(--ink)" stroke-width="1.5" />
                      {/* 每个分支 */}
                      {branches.map((b, i) => {
                        const x = padding + i * (branchW + gap);
                        const isCenter = i === Math.floor(branches.length / 2);
                        return (
                          <g>
                            <line x1={x + branchW / 2} y1={rootY + rootH + connectorH / 2} x2={x + branchW / 2} y2={branchY} stroke="var(--ink)" stroke-width="1.5" stroke-dasharray="3 3" />
                            {/* 分支卡片 */}
                            <rect x={x} y={branchY} width={branchW} height={branchH} rx="2" fill="var(--paper-3)" stroke="var(--ink)" stroke-width="1.5" />
                            <rect x={x} y={branchY} width={branchW} height="4" fill="var(--red)" />
                            <text x={x + branchW / 2} y={branchY + 26} text-anchor="middle" font-family="Noto Serif SC, serif" font-size="14" font-weight="900" fill="var(--ink)">{b.label}</text>
                            <text x={x + branchW / 2} y={branchY + 48} text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10" fill="var(--text-secondary)">{b.desc}</text>
                            {/* 分支到底部的连接线 */}
                            <line x1={x + branchW / 2} y1={branchY + branchH} x2={x + branchW / 2} y2={bottomY} stroke="var(--ink)" stroke-width="1.5" stroke-dasharray="3 3" />
                          </g>
                        );
                      })}
                      {/* 汇聚线 */}
                      <line x1={padding + branchW / 2} y1={bottomY} x2={width - padding - branchW / 2} y2={bottomY} stroke="var(--ink)" stroke-width="1.5" />
                      <line x1={cx} y1={bottomY} x2={cx} y2={bottomY} stroke="var(--ink)" stroke-width="1.5" />
                      {/* 底部节点 */}
                      <rect x={(width - rootW) / 2} y={bottomY} width={rootW} height={bottomH} rx="2" fill="var(--red)" stroke="var(--ink)" stroke-width="1.5" />
                      <text x={cx} y={bottomY + bottomH / 2 + 5} text-anchor="middle" font-family="Noto Serif SC, serif" font-size="13" font-weight="900" fill="var(--paper)">{block.bottom}</text>
                    </svg>
                  </div>
                );
              } else if (block.type === 'diary') {
                return (
                  <div class="prose-diary">
                    {/* 日记头部：日期 / 天气 / 地点 */}
                    <div class="diary-meta">
                      <div class="diary-meta-row">
                        <span class="dm-k">DATE</span>
                        <span class="dm-v">{block.meta.date}</span>
                      </div>
                      <div class="diary-meta-row">
                        <span class="dm-k">WEATHER</span>
                        <span class="dm-v">{block.meta.weather}</span>
                      </div>
                      <div class="diary-meta-row">
                        <span class="dm-k">PLACE</span>
                        <span class="dm-v">{block.meta.location}</span>
                      </div>
                    </div>
                    {/* 日记各章节 */}
                    {block.sections.map((s, i) => (
                      <div class="diary-section">
                        <div class="diary-sec-head">
                          {s.kicker && <span class="diary-kicker">{s.kicker}</span>}
                          <h4 class="diary-sec-title">{s.title}</h4>
                        </div>
                        <ul class="diary-items">
                          {s.items.map((it, j) => (
                            <li class="diary-item" style={`--i:${j}`}>{it}</li>
                          ))}
                        </ul>
                        {s.footnote && (
                          <div class="diary-footnote">
                            <span class="df-mark">笺</span>
                            <span class="df-text">{s.footnote}</span>
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                );
              }
              return <p class="prose-p">{block.text}</p>;
            })}

            <div class="article-end-rule">
              <span>END · 完</span>
            </div>
          </div>

          <div class="ad-bottom">
            <AdUnit slot="6252683541" format="auto" label="文章底部广告" />
          </div>

          <!-- 上一篇 / 下一篇 -->
          <nav class="article-nav reveal">
            {prev ? (
              <a class="nav-card prev" href={`/series/${series.id}/${prev.no}`}>
                <span class="nav-label">← 上一篇 PREVIOUS</span>
                <span class="nav-title">NO.{prev.no} · {prev.title}</span>
              </a>
            ) : (
              <span class="nav-card placeholder">已是第一篇 · AT BEGINNING</span>
            )}
            {next ? (
              <a class="nav-card next" href={`/series/${series.id}/${next.no}`}>
                <span class="nav-label">下一篇 NEXT →</span>
                <span class="nav-title">NO.{next.no} · {next.title}</span>
              </a>
            ) : (
              <span class="nav-card placeholder">已是最后一篇 · THE END</span>
            )}
          </nav>

          <div class="article-foot reveal">
            <a class="btn btn-red" href={`/series/${series.id}`}>← 返回专辑目录</a>
          </div>
        </div>
      </section>
    </main>

    <!-- FOOT -->
    <footer class="foot">
      <div class="container">
        <div class="foot-row">
          <span class="foot-logo">观禾 · GUAN HE</span>
          <span class="foot-meta">© {new Date().getFullYear()} · 浮生观禾，静心成长</span>
        </div>
      </div>
    </footer>

  </div>
</BaseLayout>

<!-- JSON-LD: BreadcrumbList -->
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<style is:global>
/* ============ ARTICLE DETAIL PAGE ============ */
body.dossier-article {
  background: var(--paper);
}

/* 背景层 */
.dossier-article .grid-bg,
.dossier-article .noise,
.dossier-article .wm {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}
.dossier-article .grid-bg {
  background-image:
    linear-gradient(rgba(27,39,56,.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(27,39,56,.04) 1px, transparent 1px);
  background-size: 28px 28px;
}
.dossier-article .noise {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='180' height='180' filter='url(%23n)'/></svg>");
  opacity: .06;
  mix-blend-mode: multiply;
}
.dossier-article .wm { overflow: hidden; }
.dossier-article .wm span {
  position: absolute;
  font-family: 'Noto Serif SC', serif;
  font-weight: 900;
  font-size: 46vw;
  color: transparent;
  -webkit-text-stroke: 1.5px rgba(27,39,56,.06);
  user-select: none;
  line-height: .8;
}
.dossier-article .wm .a { top: -12%; left: -7%; animation: drift 14s ease-in-out infinite alternate; }
.dossier-article .wm .b { bottom: -22%; right: -9%; animation: drift 17s ease-in-out infinite alternate-reverse; }
@keyframes drift {
  from { transform: translate(0, 0); }
  to   { transform: translate(20px, -16px); }
}

.dossier-article .app {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
}

/* TOPBAR */
.dossier-article .topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  background: var(--paper);
  border-bottom: 1.5px solid var(--ink);
}
.dossier-article .topbar-in {
  width: min(1240px, 94vw);
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 11px 0;
}
.dossier-article .logo {
  width: 38px;
  height: 38px;
  background: var(--red);
  color: var(--paper);
  display: grid;
  place-items: center;
  font-family: 'Ma Shan Zheng', serif;
  font-size: 24px;
  box-shadow: 4px 4px 0 var(--ink);
  flex: none;
  text-decoration: none;
  cursor: pointer;
}
.dossier-article .brand {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}
.dossier-article .brand b {
  font-family: 'Noto Serif SC', serif;
  font-weight: 700;
  font-size: 15px;
  letter-spacing: .04em;
}
.dossier-article .brand small {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 9.5px;
  letter-spacing: .22em;
  color: var(--ink-soft);
  text-transform: uppercase;
  padding-top: 4px;
}
.dossier-article .topbar-right {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 14px;
}
.dossier-article .meta {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10.5px;
  letter-spacing: .12em;
  color: var(--ink-soft);
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 8px;
}
.dossier-article .meta .dot {
  width: 7px;
  height: 7px;
  background: var(--red);
  border-radius: 50%;
  display: inline-block;
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: .35; }
}

/* MAIN */
.dossier-article main {
  flex: 1;
  padding: 0 0 80px;
}
.dossier-article .container {
  max-width: 760px;
  margin: 0 auto;
  padding: 0 28px;
}

/* BACK LINK */
.back-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin: 36px 0 28px;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 11px;
  letter-spacing: .14em;
  color: var(--red-deep);
  text-decoration: none;
  text-transform: uppercase;
  transition: color .25s ease;
}
.back-link .arrow {
  display: inline-block;
  transition: transform .25s ease;
}
.back-link:hover { color: var(--red); }
.back-link:hover .arrow { transform: translateX(-4px); }

/* ARTICLE HERO */
.article-cover { padding-top: 8px; }
.article-hero {
  position: relative;
  padding: 24px 0 40px;
  border-bottom: 1.5px dashed var(--ink);
}
.article-meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14px;
  margin-bottom: 18px;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 11px;
  letter-spacing: .12em;
  color: var(--text-secondary);
}
.article-meta-row.sub { gap: 18px; margin-bottom: 0; }
.article-meta-row .series-tab {
  color: var(--paper);
  background: var(--ink);
  padding: 4px 12px;
  border-radius: 1px;
  letter-spacing: .18em;
}
.series-link {
  color: var(--red-deep);
  text-decoration: none;
  border-bottom: 1px dotted var(--red-deep);
  padding-bottom: 1px;
  transition: color .25s ease;
}
.series-link:hover { color: var(--red); }
.article-no-tag {
  color: var(--ink-soft);
  letter-spacing: .14em;
}
.meta-item {
