---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SERIES, STATUS_CLASS } from '../../../data/series';
import AdUnit from '../../../components/AdUnit.astro';

export function getStaticPaths() {
  const paths: Array<{
    params: { id: string; no: string };
    props: { series: typeof SERIES[number]; article: typeof SERIES[number]['articles'][number]; index: number; total: number };
  }> = [];
  SERIES.forEach((s) => {
    s.articles.forEach((a, i) => {
      paths.push({
        params: { id: s.id, no: a.no },
        props: { series: s, article: a, index: i, total: s.articles.length }
      });
    });
  });
  return paths;
}

interface Props {
  series: typeof SERIES[number];
  article: typeof SERIES[number]['articles'][number];
  index: number;
  total: number;
}
const { series, article, index, total } = Astro.props;

const stampClass = STATUS_CLASS[series.status] || 'run';
const statusEn = series.status === '连载中' ? 'ONGOING'
  : series.status === '已完结' ? 'COMPLETED'
  : 'IRREGULAR';

// 上一篇 / 下一篇
const prev = index > 0 ? series.articles[index - 1] : null;
const next = index < total - 1 ? series.articles[index + 1] : null;

// 顶部日期（北京时间）
const fmt = new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai',
  year: 'numeric', month: '2-digit', day: '2-digit',
  weekday: 'short'
});
const parts = fmt.formatToParts(new Date());
const get = (t: string) => parts.find(p => p.type === t)?.value ?? '';
const today = `${get('year')}.${get('month')}.${get('day')} · ${get('weekday')}`;

const pageTitle = `${article.title} · ${series.title}`;
const pageDesc = `${series.desc} — ${article.title}（发表于 ${article.date}）`;

const siteBase = Astro.site ?? new URL('https://www.wangjianchao.cn');
const canonicalURL = new URL(Astro.url.pathname, siteBase).href;

// 面包屑结构化数据
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "首页", "item": siteBase.href },
    { "@type": "ListItem", "position": 2, "name": series.title, "item": new URL(`/series/${series.id}`, siteBase).href },
    { "@type": "ListItem", "position": 3, "name": article.title, "item": canonicalURL },
  ],
};

// 文章正文：按 series.id + article.no 查找真实内容，未命中则 fallback 到占位
type Block =
  | { type: 'p'; text: string }
  | { type: 'h2'; text: string; kicker?: string }
  | { type: 'h3'; text: string }
  | { type: 'quote'; text: string }
  | { type: 'hr' }
  | { type: 'list'; items: string[] }
  | { type: 'callout'; text: string }
  | { type: 'code'; lines: string[] }
  | { type: 'flow'; nodes: string[] }
  | { type: 'kvlist'; title?: string; pairs: { k: string; v: string }[] }
  | { type: 'architecture'; root: string; branches: { label: string; desc: string }[]; bottom: string }
  | { type: 'diary'; meta: { date: string; weather: string; location: string }; sections: { title: string; kicker?: string; items: string[]; footnote?: string }[] };

const ARTICLE_BODY_MAP: Record<string, Block[]> = {
  'learn-from-chairman-mao:001': [
    { type: 'p', text: '前两天晚上，加完班回家，快十一点了。推开门，看着熟睡的孩子和妻子，我突然觉得一阵没来由的恐慌。' },
    { type: 'p', text: '白天在公司，开了一场三个小时的会。满屏的"赋能"、"闭环"、"底层逻辑"、"颗粒度"，大家慷慨激昂，可散会了，却没人知道明天到底该干什么。那一刻，我特别清晰地意识到：我身处一个巨大的草台班子，而我，正在变老。' },
    { type: 'p', text: '就是在那个晚上，我没有像往常一样刷短视频麻醉自己，而是从书架最深处，抽出了那套落了灰的《毛泽东选集》。' },
    { type: 'p', text: '后来有朋友问我，人到中年，怎么突然开始读这种"老古董"？是想考公，还是想创业？' },
    { type: 'p', text: '我说都不是。我只是想活下去，活得明白一点。' },
    { type: 'hr' },
    { type: 'h2', text: '为什么是教员，而不是成功学？' },
    { type: 'p', text: '市面上教人成功的书太多了。成功学教我"怎么赢"，管理学教我"怎么管"。但说实话，那些东西对我没用。' },
    { type: 'p', text: '我没有显赫的背景，没有花不完的资源，我手里拿的就是一把烂牌：一个混乱的组织，一副开始走下坡路的身体，和一家老小的生计。那些书里的大佬，都是站在山顶上，教我怎么爬山。' },
    { type: 'p', text: '只有教员不一样。' },
    { type: 'p', text: '他是真正从泥坑里、从绝境里、从"敌强我弱"的死人堆里爬出来的。他这一辈子，大半时间都在当"弱者"。所以，他不教你怎么开顺风局。他教的是：当你什么都没有、四面楚歌、所有人都觉得你要完蛋的时候，你该怎么活下来，怎么一点一点把局势扳回来。' },
    { type: 'quote', text: '当你什么都没有、四面楚歌、所有人都觉得你要完蛋的时候，你该怎么活下来，怎么一点一点把局势扳回来。' },
    { type: 'p', text: '这才是我这个中年人，最需要的"防身术"。' },
    { type: 'hr' },
    { type: 'h2', text: '他给了我一只"照妖镜"，让我不再害怕' },
    { type: 'p', text: '以前在公司，领导一画饼，或者一施压，我就慌，觉得天要塌了。读了《矛盾论》和《纸老虎》，我突然开窍了。' },
    { type: 'p', text: '我开始学会"抓主要矛盾"，开始看"利益结构"。我发现，那个在台上张牙舞爪、满嘴黑话的人，其实也不过是个被利益架空的"纸老虎"；那些吓唬我的"35岁危机"、"AI淘汰论"，大半也是纸老虎。' },
    { type: 'p', text: '真正的老虎只有一个：我的身体垮了，我的家散了。' },
    { type: 'p', text: '看清了这一点，我心里的恐惧，少了一大半。原来，让我不安的从来不是现实，而是我对现实的"执念"和"盲目"。教员说，战略上要藐视敌人，战术上要重视敌人。现在，面对那些虚张声势的困难，我会在心里默念一句："装腔作势，借以吓人。"然后，该干嘛干嘛。' },
    { type: 'hr' },
    { type: 'h2', text: '他教会我"放下包袱，开动机器"' },
    { type: 'p', text: '中年人最怕什么？怕回忆。总觉得自己前半生选错了路，觉得自己"定型了"、"来不及了"、"一事无成"。' },
    { type: 'p', text: '教员在《学习和时局》里说，这些都是"包袱"。' },
    { type: 'p', text: '我照着做了。我在纸上写下"我总觉得一事无成"，然后问自己：这是事实，还是执念？我撑起了一个家，我养育了孩子，我凭什么一事无成？那一刻，我真的觉得肩膀松了。' },
    { type: 'p', text: '教员告诉我：不要否定一切。过去的对的，是我的本钱；错的，是我的教训。带着本钱，改着教训，往前走就行了。' },
    { type: 'p', text: '四十岁怎么了？愚公九十岁才移山。只要把包袱放下，我这台旧机器，还能重新转起来。' },
    { type: 'hr' },
    { type: 'h2', text: '他把我从"宏大叙事"里拽了出来，按在地上"挖土"' },
    { type: 'p', text: '以前我总想搞个大动作，想一夜之间改变现状，想搞个大转型。结果呢？三分钟热度，然后陷入更深的自我怀疑。' },
    { type: 'p', text: '教员在《反对党八股》里骂得好：空话连篇，言之无物。在《实践论》里他说：你要知道梨子的滋味，就得亲口吃一吃。' },
    { type: 'p', text: '于是，我不再喊"我要彻底改变人生"这种口号了。我把目标缩小到荒谬的程度：' },
    { type: 'list', items: [
      '每天晚饭后，走路20分钟。',
      '每天晚上，11点关灯。',
      '本周，约个体检。'
    ]},
    { type: 'p', text: '就这么点事。这就是我的"战略"。' },
    { type: 'p', text: '教员说，这叫"集中优势兵力，打歼灭战"。一次只打一个点，打透了，再打下一个。现在，我每天走那20分钟的时候，我不焦虑了。因为我知道，我不是在"走路"，我是在"挖土"。愚公移山，不就是每天挖一箕土吗？山不会自己变矮，但我每挖一箕，它就矮一分。' },
    { type: 'hr' },
    { type: 'h2', text: '普通人的战略，就是守住自己的根据地' },
    { type: 'p', text: '所以，为什么要跟着教员学战略思维？' },
    { type: 'p', text: '因为在这个充满不确定性的、有点荒诞的时代，我们普通人太容易被带节奏，太容易焦虑，太容易觉得自己是个无足轻重的螺丝钉。' },
    { type: 'p', text: '教员没有教我怎么做官，也没有教我发财。他教我的，是一种"主体性"。' },
    { type: 'p', text: '他告诉我：不管环境多烂，不管牌多差，你都不是无能为力的。你可以调查，可以分析，可以集中兵力，可以战略退却，可以持久战。他让我从一个"被生活推着走的中年人"，变成了一个"有自己根据地的指挥官"。' },
    { type: 'p', text: '我的根据地不大，就是我的身体，和我的家。但我会像他教的那样，守住它。' },
    { type: 'quote', text: '前途是光明的，道路是曲折的。' },
    { type: 'p', text: '我不着急，也不害怕。我换上鞋，出门，去走我今天的那20分钟。' },
    { type: 'p', text: '这就是我的战略。' }
  ],

  'learn-from-chairman-mao:002': [
    { type: 'callout', text: '「谁是我们的敌人？谁是我们的朋友？这个问题是革命的首要问题。」——毛泽东，1925' },
    { type: 'p', text: '一九二五年，毛泽东二十六岁，刚刚回到湖南养病，国民革命的局势尚不明朗。他在《中国社会各阶级的分析》开篇写下的这句话，后来被视为中国共产党最早的「方法论奠基石」。' },
    { type: 'p', text: '九十九年后，一个身处草台班子、人到中年的我，把这句话抄在了笔记本第一页——它也是我的首要问题。因为中年人最大的消耗，从来不是努力太少，而是打错了仗。' },
    { type: 'p', text: '火力浪费在假敌人上，时间消耗在无意义的会议里，情绪浪费在别人眼光里——回头看，那些"加班""焦虑""内耗"，大半都是打错仗的结果。' },
    { type: 'hr' },

    { type: 'h2', kicker: '壹', text: '先借他的"镜子"' },
    { type: 'p', text: '第一篇的精髓不是"阶级"，而是一套「分清敌友、集中火力」的方法。它要回答三个问题：' },
    { type: 'list', items: [
      '它是帮我，还是耗我？',
      '它是真正的威胁，还是吓我的纸老虎？',
      '它是可靠的依靠，还是摇摆的工具？'
    ]},
    { type: 'p', text: '分不清，就会把火力浪费在假敌人上。分清了，就能把主力集中到真正要命的那一两个点上——弱者资源有限，打错仗就是死。' },
    { type: 'quote', text: '团结真正的朋友，以攻击真正的敌人。' },
    { type: 'hr' },

    { type: 'h2', kicker: '贰', text: '我的"敌友地图"' },
    { type: 'p', text: '把身边所有力量摆出来，逐一问「它是在帮我，还是在耗我」。这就是我自己的阶级分析——' },
    { type: 'h3', text: '真敌 · 集中兵力 · 攻击' },
    { type: 'kvlist', title: '它们才是要命的，别的都是干扰', pairs: [
      { k: '身体的透支与忽视', v: '熬夜、不运动、不体检。唯一会真的"要命"的老虎。' },
      { k: '惯性与拖延', v: '"明天再说"是杀死行动的头号敌人。' },
      { k: '恐惧与包袱', v: '"来不及了""我失败了""我定型了"——都是执念。' },
      { k: '空话与内耗', v: '无意义的会、表演式努力、党八股。' }
    ]},

    { type: 'h3', text: '动摇 · 争取 · 善用 · 不托付' },
    { type: 'kvlist', title: '可以是工具，不能当归宿', pairs: [
      { k: '草台班子 / 工作', v: '给我收入也耗我精力。既非纯敌，也非纯友。' },
      { k: 'AI', v: '可以是"取代我"的威胁，也可以是倍增器。' },
      { k: '钱 / 物质', v: '可以是安全感，也可以是焦虑源。' }
    ]},

    { type: 'h3', text: '真友 · 依靠 · 团结 · 服务' },
    { type: 'kvlist', title: '我为什么出发，就为了它们', pairs: [
      { k: '家庭', v: '妻子、孩子、父母。我的主旋律，我服务的"人民"。' },
      { k: '每天的小行动', v: '走路、早睡、学习。看似微小，实则可靠。' },
      { k: '经验与判断力', v: '二十年攒下的本钱，不是包袱。' }
    ]},

    { type: 'h3', text: '领导 · 指挥 · 决定 · 行动' },
    { type: 'kvlist', title: '唯一能对我负责的，是我自己', pairs: [
      { k: '清醒的自己', v: '能分析、能决定、能行动的主体。我的"无产阶级"。' }
    ]},
    { type: 'hr' },

    { type: 'h2', kicker: '叁', text: '战略结论：团结真友，攻击真敌' },
    { type: 'p', text: '把第一篇的结论，翻译成我的行动纲领：' },
    { type: 'list', items: [
      '把主力从假敌人上撤下来——老板的脸色、同事的竞争、别人的眼光、35岁危机的恐吓。',
      '它们是纸老虎或动摇者，不配我的主力。',
      '集中兵力攻击真敌人——身体的透支、惯性、恐惧。第一个仗，打身体。',
      '依靠真朋友——家庭、每天的小行动、我的经验。它们是我出发的理由。',
      '善用动摇者——工作是车，AI 是器，钱是工具。用它们，不被它们用。',
      '让清醒的自己当指挥官。情绪可以汇报，但不能决策。'
    ]},
    { type: 'quote', text: '装腔作势，借以吓人。' },
    { type: 'hr' },

    { type: 'h2', kicker: '肆', text: '我现在打的仗' },
    { type: 'p', text: '一九二五年，他面对的是中国革命的乱局；我面对的，是自己人生的乱局。本质上没有区别——都是「分清敌友、集中火力、坚持下去」。' },
    { type: 'p', text: '正在打的第一场仗：身体攻坚战。每天走路 20 分钟，11 点关灯，本周约体检。' },
    { type: 'p', text: '正在打的第二场仗：习惯攻坚战。把标准降到不可能失败——每天只挖一箕土，山总会矮一点。' },
    { type: 'p', text: '正在打的第三场仗：恐惧攻坚战。告诉自己「来不及了」是纸的，「我定型了」是纸的，「失败一次就是失败一辈子」更是纸的。' },
    { type: 'p', text: '把纸老虎赶走，握紧指挥权。剩下的，慢慢打。' },
    { type: 'hr' },

    { type: 'h2', kicker: '伍', text: '写在最后' },
    { type: 'quote', text: '我的敌人，是透支、惯性与恐惧。\n我的朋友，是家庭、身体与每天的一箕土。\n\n把火力从假敌人上撤下来，\n集中到真正要命的那一仗上。\n\n这，就是我的第一篇。' },
    { type: 'p', text: '九十九年前，教员在油灯下写下那句话；九十九年后，我在一个普通的夜晚，在笔记本上抄下了它。' },
    { type: 'p', text: '方法是不分时代的。分清敌友，认清纸老虎，集中火力——这对一个 2026 年的中年工程师，和对一个 1925 年的青年革命者，用的是同一副武器。' },
    { type: 'p', text: '前途是光明的，道路是曲折的——但只要方向对，火力集中，走得慢一点也没关系。' }
  ],

  'learn-from-chairman-mao:003': [
    { type: 'callout', text: '「没有调查，没有发言权。」——毛泽东，1927' },
    { type: 'p', text: '一九二七年，毛泽东三十四岁。全社会都在骂农民运动「糟得很」——地主、士绅、国民党右派、共产党内的妥协派，异口同声。他没有在长沙的办公室里争辩，他走了三十二天、七百里，下到湘南的乡下，亲眼去看。' },
    { type: 'p', text: '看完，他说：「好得很！」' },
    { type: 'p', text: '九十九年后，世界也在对我的中年喊「糟得很」——来不及了、身体废了、要被淘汰了。这一次，我决定像他一样：先去调查，再下结论。' },
    { type: 'hr' },

    { type: 'h2', kicker: '壹', text: '先学他的"调查法"' },
    { type: 'p', text: '第二篇的精髓不在「农民运动」，而在一套「调查法」。三个字：走、看、断。' },
    { type: 'kvlist', title: '调查法 · 三步', pairs: [
      { k: '走下去', v: '毛泽东不坐在屋里看报告，他走了七百里。真相不在二手信息里，在你亲自走到的地方。' },
      { k: '亲眼看', v: '别人嘴里的「糟得很」，是他们的立场。是真是假，要你自己的眼睛说了才算。' },
      { k: '再下判断', v: '没有调查，就没有发言权。调查完了，你才有资格说「好得很」或「糟得很」。' }
    ]},
    { type: 'quote', text: '没有调查，没有发言权。' },
    { type: 'hr' },

    { type: 'h2', kicker: '贰', text: '世界喊的"糟得很"，调查后的"好得很"' },
    { type: 'p', text: '每一条中年焦虑，都对应一个调查后的反转。把嘴里的「糟得很」摆到眼前，让事实说话——' },
    { type: 'h3', text: '焦虑一 ·「四十岁了，什么都来不及了。」' },
    { type: 'p', text: '调查后：愚公九十岁才动手。你还有几十年，而且已经开始了——每天走 20 分钟。山不加增，挖一箕少一箕。' },
    { type: 'list', items: [
      '别算"还剩多少"，算"今天挖了几箕"。'
    ]},
    { type: 'h3', text: '焦虑二 ·「我的身体已经废了，改也改不好了。」' },
    { type: 'p', text: '调查后：你体检了吗？没有。那「废了」是恐惧，不是事实。身体从每天 20 分钟开始，真的会好转。' },
    { type: 'list', items: [
      '本周约体检，让数据说话，别让恐惧说话。'
    ]},
    { type: 'h3', text: '焦虑三 ·「AI 会取代我，我马上就要没用了。」' },
    { type: 'p', text: '调查后：AI 是工具，不是对手。你正在认真学它。二十年的经验 × AI，恰恰是年轻人没有的优势。' },
    { type: 'list', items: [
      '用 AI 解决一个你真实的工作问题，把它变成朋友。'
    ]},
    { type: 'h3', text: '焦虑四 ·「草台班子没救了，我在这耗着没意义。」' },
    { type: 'p', text: '调查后：你看清了它的空，说明你比大多数人清醒。你需要的不是它的认可，是你自己的根据地。' },
    { type: 'list', items: [
      '把精力从"抱怨它"转到"建设自己"。'
    ]},
    { type: 'h3', text: '焦虑五 ·「我前半生白活了，一事无成。」' },
    { type: 'p', text: '调查后：你养大了孩子，撑起了家，看清了人心。这不是「白活」，这是成绩。错的算教训，对的算本钱。' },
    { type: 'list', items: [
      '写下三件你做成的事，别只盯着没做成的。'
    ]},
    { type: 'hr' },

    { type: 'h2', kicker: '叁', text: '我的"700里"：接下来要调查的四件事' },
    { type: 'p', text: '毛泽东走七百里看农村，我走我的「七百里」看自己。这是接下来要做的四份调查——' },
    { type: 'kvlist', title: '我的调查清单', pairs: [
      { k: '调查身体', v: '我的身体到底是什么状况？不是焦虑说的，是数据说的。约体检 + 记基线（体重、血压、睡眠、精力）。让数据开口，不让恐惧开口。' },
      { k: '调查能力', v: '我到底会什么、擅长什么？这些经验在市场上值多少？写下三件我真正拿手的事。看自己的手，别只看别人的嘴。' },
      { k: '调查家庭', v: '伴侣、孩子、父母，真正需要的是什么？不是我猜的，是他们说的。认真问一次，别猜。他们要的，往往比我想的简单。' },
      { k: '调查草台班子', v: '这里真正的价值在哪？空洞在哪？我留下图什么、离开怕什么？看清利益结构再决定去留。看明白了，才谈得上选择。' }
    ]},
    { type: 'hr' },

    { type: 'h2', kicker: '肆', text: '调查的结论' },
    { type: 'p', text: '一线有真相，而我就在我生活的一线。' },
    { type: 'p', text: '我不再替别人转述我的中年。我的身体、我的家、我的能力——我自己去看，自己去量，自己下结论。' },
    { type: 'p', text: '调查完我才发现：所谓「糟得很」，大半是没调查过的恐惧。而真实的我，正在每天挖土，好得很。' },
    { type: 'quote', text: '别人喊的"糟得很"，是他们嘴里的；\n我看到的样子，才算数。' },
    { type: 'hr' },

    { type: 'h2', kicker: '伍', text: '写在最后' },
    { type: 'p', text: '面对中年的每一句「糟得很」，我先不慌，也不认——我先去调查。' },
    { type: 'p', text: '我每天那 20 分钟的走路，也是调查：调查我的身体，也调查我的心。走着走着，我就看清了——我的中年，好得很。' },
    { type: 'quote', text: '没有调查，没有发言权。' },
    { type: 'p', text: '方法论源自《毛泽东选集》第一卷第二篇《湖南农民运动考察报告》(1927)，与一个 2026 年的中年人的自我调查结合。' }
  ],

  'learn-from-chairman-mao:004': [
    { type: 'callout', text: '「红旗到底能打多久？」——毛泽东，1928' },
    { type: 'p', text: '一九二八年，毛泽东三十五岁。大革命失败，共产党几乎被消灭，他带着残部退守井冈山，被白色政权四面包围。林彪在那一刻写信问：「红旗到底能打多久？」他没有喊口号，也没有回避，而是冷静地写下《中国的红色政权为什么能够存在？》，列出五个条件，证明红旗还能打下去。' },
    { type: 'p', text: '九十八年后，被草台班子和中年焦虑包围的我，心里也在问：「我真的能翻身吗？」这一次，我像他一样，不喊口号，先核对条件。' },
    { type: 'hr' },

    { type: 'h2', kicker: '壹', text: '同一种处境' },
    { type: 'p', text: '一九二八年的井冈山，和我的中年，竟是同构的。' },
    { type: 'kvlist', title: '处境对照', pairs: [
      { k: '1928 · 毛泽东', v: '大革命失败，共产党几乎被消灭；退守井冈山，被白色政权四面包围；疑问「红旗到底能打多久？」；选择不硬拼，建立和巩固根据地。' },
      { k: '此刻 · 我', v: '草台班子混乱，中年压力四伏；被焦虑、不确定、「35岁危机」包围；疑问「我真的能翻身吗？」；选择不硬拼，守住身体和家这块根据地。' }
    ]},
    { type: 'p', text: '我们都不是要立刻「打出去」，而是要先回答：在四面受困里，凭什么能站住。' },
    { type: 'hr' },

    { type: 'h2', kicker: '贰', text: '五个条件：我凭什么能站住' },
    { type: 'p', text: '毛泽东列出的五个条件，每一条都对应我的人生。' },
    { type: 'h3', text: '条件壹 · 有缝隙' },
    { type: 'p', text: '毛泽东：中国政治经济发展极不平衡，白色政权之间有裂缝，红色政权才能在夹缝中存在。' },
    { type: 'p', text: '我的版本：草台班子和这个时代，不是铁板一块。「35岁危机」和「重用经验」之间有缝，AI 里有机遇，市场里有空位。总有一条缝，容得下我。' },
    { type: 'list', items: [
      '别把环境看成铁板一块，去找属于我的那条缝。'
    ]},
    { type: 'h3', text: '条件贰 · 有根基' },
    { type: 'p', text: '毛泽东：红色政权发生的地方，是经过大革命洗礼、有群众基础的地方。' },
    { type: 'p', text: '我的版本：我不是从零开始。我的家庭、我二十年的经验、我已经开始的觉醒和行动——都是我的根基。我有火种，不是白手。' },
    { type: 'list', items: [
      '盘点我已有的，别低估自己手里的。'
    ]},
    { type: 'h3', text: '条件叁 · 趋势向前' },
    { type: 'p', text: '毛泽东：全国的革命形势是向前发展的，这是红色政权能存在的大势。' },
    { type: 'p', text: '我的版本：大势在我这边——AI 能学、身体练了会好、时代奖励持续学习的人。时间站在坚持的人这边，不站在放弃的人那边。' },
    { type: 'list', items: [
      '看趋势，别被一时的起伏吓退。'
    ]},
    { type: 'h3', text: '条件肆 · 有战斗力' },
    { type: 'p', text: '毛泽东：有相当力量的正式红军，红色政权才能存在。没有枪杆子，一切是空谈。' },
    { type: 'p', text: '我的版本：我的「红军」 = 真实的本事 + 健康的身体 + 行动力。这是我立足的本钱。没有它，其余都是空中楼阁。' },
    { type: 'list', items: [
      '每天强壮我的战斗力——走 20 分钟、学 AI、做实事。'
    ]},
    { type: 'h3', text: '条件伍 · 有正确领导' },
    { type: 'p', text: '毛泽东：共产党组织有力量、政策不错误，是红色政权存在的关键。' },
    { type: 'p', text: '我的版本：我的「领导」 = 清醒的自己 + 战略思维。不犯大错：不放弃、不打错仗、不飘、不丢根据地。' },
    { type: 'list', items: [
      '让清醒的自己指挥，保持方法论在线。'
    ]},
    { type: 'quote', text: '缝隙在、根基在、趋势在、战斗力在、清醒在，我就能站住。这不是鸡汤，是条件。' },
    { type: 'hr' },

    { type: 'h2', kicker: '叁', text: '我的"井冈山"是什么构成的' },
    { type: 'p', text: '五个条件，落到我身上，就是我的根据地——' },
    { type: 'kvlist', title: '我的根据地构成', pairs: [
      { k: '身 · 地形 · 根基', v: '身体。地形塌了，根据地就没了。身体是承载一切的地盘。' },
      { k: '家 · 人民 · 为谁', v: '家庭。根据地的人。我服务的人民，我存在的理由。' },
      { k: '能 · 军队 · 本钱', v: '能力。我的红军。真实本事是立足和战斗的资本。' },
      { k: '醒 · 领导 · 灵魂', v: '清醒。我的党。清醒的头脑和正确的方法，让我不迷路。' },
      { k: '行 · 建设 · 生长', v: '行动。每天挖土。根据地不是一天建成的，是天天长出来的。' }
    ]},
    { type: 'hr' },

    { type: 'h2', kicker: '肆', text: '确认了条件，然后怎么办' },
    { type: 'p', text: '井冈山的打法：守住、扩大、不冒进、等时机。' },
    { type: 'kvlist', title: '四个动作', pairs: [
      { k: '守 · 守住根据地', v: '别让身体垮、别让家散、别让清醒丢。这三样在，根据地就在；这三样丢一个，什么都难。' },
      { k: '扩 · 扩大根据地', v: '本事长一点、AI 学一点、影响大一点。每天挖一箕土，根据地就大一圈。' },
      { k: '稳 · 不急于打大城市', v: '不幻想一夜翻盘、速胜暴富。先立足，再图发展。速胜论和亡国论，都是错的。' },
      { k: '待 · 等待形势变化', v: '大势向前，机会会来。我把自己准备好，等风来。风来的时候，根据地还在的人，才接得住。' }
    ]},
    { type: 'quote', text: '红旗能打多久？\n条件在，就能一直打下去。' },
    { type: 'hr' },

    { type: 'h2', kicker: '伍', text: '写在最后' },
    { type: 'p', text: '下次再自我怀疑「我能行吗」，我不喊「我能行」，也不认「我不行」——我核对这五个条件。' },
    { type: 'p', text: '一九二八年，井冈山很小，被四面围困。但毛泽东说，它有五个条件，所以能存在、能发展。' },
    { type: 'p', text: '我的「井冈山」现在也很小——一副在恢复的身体，一个温暖的家，一点在长的本事。但五个条件都在。所以，它能存在，也能长大。' },
    { type: 'quote', text: '我的根据地，虽小，能存在。' },
    { type: 'p', text: '红旗，就这样一直打下去。' },
    { type: 'p', text: '方法论源自《毛泽东选集》第一卷第三篇《中国的红色政权为什么能够存在？》(1928)，与一个 2026 年的中年人的根据地结合。' }
  ],

  'learn-from-chairman-mao:005': [
    { type: 'callout', text: '「红旗到底能打多久？」——林彪，1930。毛泽东的回答是：火种虽小，但干柴已铺、风在吹，燎原必至。' },
    { type: 'p', text: '一九三零年，林彪在信里问：「红旗到底能打多久？」那是井冈山最苦的时候，看不到头。毛泽东的回答是：火种虽小，但干柴已铺、风在吹，燎原必至。' },
    { type: 'p', text: '今天，处在相持阶段、每天做着小动作却看不到效果的我，心里也在问：「我这点小动作，真的有用吗？」这一篇，就是给我的回答。' },
    { type: 'hr' },

    { type: 'h2', kicker: '壹', text: '相持阶段，我的那个疑问' },
    { type: 'p', text: '林彪的疑问，就是我的疑问——只是换了战场。' },
    { type: 'quote', text: '「我这点小动作，真的有用吗？」' },
    { type: 'p', text: '每天走 20 分钟、11 点睡、学一点 AI……做了些日子，秤没动、精力没明显变好、工作也没起色。于是那个声音又来了：这么小的事，能改变什么？是不是白费劲？' },
    { type: 'p', text: '毛泽东的回答是：你看到的只是「火苗还小」，却没看到干柴已经铺满、风正在吹。火种不是没用，是还没到燎原的那一刻。小，不等于无用；小，是燎原的起点。' },
    { type: 'hr' },

    { type: 'h2', kicker: '贰', text: '三步判断：为什么燎原必至' },
    { type: 'p', text: '毛泽东的论证：干柴已铺 + 火种已有 + 风在吹 = 燎原必至。' },
    { type: 'h3', text: '条件壹 · 干柴已铺' },
    { type: 'p', text: '毛泽东：中国是全国都布满了干柴，很快就会燃成烈火——条件早已具备。' },
    { type: 'p', text: '我的版本：我对草台班子的不满、身体的警报、对更好生活的渴望、AI 的机会——改变的干柴早已铺满，只差火种。我不是在贫瘠的地上点火。' },
    { type: 'h3', text: '条件贰 · 火种已有' },
    { type: 'p', text: '毛泽东：红军和根据地，就是那已经存在的星星之火。' },
    { type: 'p', text: '我的版本：我不是在等火种——我自己就是火种。走路、早睡、体检、学 AI，每一个都已经点燃。我不是从零，我是从「已燃」开始。' },
    { type: 'h3', text: '条件叁 · 风在吹' },
    { type: 'p', text: '毛泽东：革命形势继续向前发展，风正在吹。' },
    { type: 'p', text: '我的版本：风在吹——AI 的时代、对健康的重视、奖励持续学习的趋势。时间站在积累的人这边。风起时，火就燎原。' },
    { type: 'quote', text: '干柴已铺、火种已有、风在吹。燎原必至，不是鸡汤，是条件。' },
    { type: 'hr' },

    { type: 'h2', kicker: '叁', text: '点火器：我的六星火种' },
    { type: 'p', text: '每一颗，都是我正在做的一个小动作——它们如何从「一点微光」汇成「燎原之势」。' },
    { type: 'kvlist', title: '六颗火种', pairs: [
      { k: '走 · 每天 20 分钟', v: '最朴素的火种。脚抬起、落下，点燃的是身体的代谢和意志的复苏。' },
      { k: '睡 · 11 点关灯', v: '夜间最关键的火种。一夜修复，第二天火苗才不灭。' },
      { k: '梯 · 上班爬楼', v: '碎片化训练的火种。不需要整块时间，日积月累，腿力就是根据地。' },
      { k: '戒 · 不吃夜宵', v: '断负的火种。不是添柴，是堵漏。少一口，火就少一分被浇灭。' },
      { k: '检 · 本周约体检', v: '清醒的火种。看清自己地形，才不会瞎点火、点错火。' },
      { k: '智 · 认真学 AI', v: '面向未来的火种。燎原不只靠身体，还要靠手艺与时代共振。' }
    ]},
    { type: 'p', text: '六颗火种齐燃，燎原之势已成。不是某一颗在扛，是六颗一起在烧。' },
    { type: 'hr' },

    { type: 'h2', kicker: '肆', text: '高潮已在路上：三个比喻' },
    { type: 'p', text: '毛泽东说，那不是「可能会来」，是「已经在来」——桅杆已见、光芒已射、胎儿已动。' },
    { type: 'h3', text: '比喻壹 · 航船：已见桅杆' },
    { type: 'quote', text: '「它是站在海岸遥望海中，已经看得见桅杆尖头了的一只航船。」' },
    { type: 'p', text: '我的版本：结果不是没有，是正在驶来——精力在恢复、数据在变好，桅杆已经露头。' },
    { type: 'h3', text: '比喻贰 · 朝日：喷薄欲出' },
    { type: 'quote', text: '「它是立于高山之巅远看东方，已见光芒四射喷薄欲出的一轮朝日。」' },
    { type: 'p', text: '我的版本：不是天还黑着，是天快亮了。我积累的，正处在破晓前的那一刻。' },
    { type: 'h3', text: '比喻叁 · 婴儿：快要成熟' },
    { type: 'quote', text: '「它是躁动于母腹中的，快要成熟了的一个婴儿。」' },
    { type: 'p', text: '我的版本：那个更好的我，正在成形，即将出生。他不是不存在，是还没到产期。' },
    { type: 'hr' },

    { type: 'h2', kicker: '伍', text: '躲开两个陷阱' },
    { type: 'p', text: '毛泽东同时批评了右的悲观和「左」的急躁——相持阶段，两头都要防。' },
    { type: 'h3', text: '陷阱壹 · 右的悲观：「做了也没用」' },
    { type: 'p', text: '那个声音会说：「这点小动作，改变不了什么，算了吧。」' },
    { type: 'p', text: '破法：干柴已铺、火种已有、风在吹。你不是在做无用功，你是在等燎原的那一刻。别在黎明前，亲手掐灭自己的火种。' },
    { type: 'h3', text: '陷阱贰 · 「左」的急躁：「怎么还没见效」' },
    { type: 'p', text: '那个声音会说：「都这么多天了，怎么一点变化都没有？」' },
    { type: 'p', text: '破法：高潮会来，但要积累。你现在处在攒干柴的阶段，不是火没来的时候。急于求成，反而会烧了自己。' },
    { type: 'quote', text: '不轻视小，不急于成。每天添一颗火种。燎原不是等来的，是一颗一颗火种点出来的。' },
    { type: 'hr' },

    { type: 'h2', kicker: '陆', text: '写在最后' },
    { type: 'p', text: '我走的每一步、睡的每一个早觉、学的每一点 AI，都是一颗火种。' },
    { type: 'p', text: '此刻它们还小，像夜里零星的几点光。但干柴已铺，风正在吹。' },
    { type: 'p', text: '所以，我不悲观，也不急躁。我只是每天，再添一颗火种。燎原的那一刻，会来的——而我会准备好，迎接它。' },
    { type: 'quote', text: '我的火种，会燎原。' },
    { type: 'p', text: '方法论源自《毛泽东选集》第一卷第四篇《星星之火，可以燎原》(1930)，献给相持阶段仍在添火种的你。' }
  ],

  'life-debug:001': [
    // 引言卡片
    { type: 'callout', text: '「快速上线」的年轻人从不回头看——但那些没有维护的东西，正在悄悄吃掉未来的自己。' },

    // 前言
    { type: 'p', text: '过去十几年，我一直相信一个公式：技术能力提升，解决问题增加，经验不断积累，未来自然会越来越好。这个公式在年轻的时候几乎没有错——' },
    { type: 'p', text: '刚进入技术行业的时候，学习一个新技术，解决一个线上问题，完成一个重要项目，得到一次认可，都会带来非常明显的成长反馈。那时候的人生，很像一个不断升级的程序：只要持续提交代码，系统就会不断迭代；只要不断努力，未来就会越来越好。' },
    { type: 'p', text: '可是到了某个阶段，我发现事情开始发生变化。代码还在写，问题还在解决，项目还在推进，经验还在增加。但是——职业成长的速度慢了，收入增长变难了，未来方向开始模糊了。以前让我获得安全感的东西，正在慢慢失效。' },
    { type: 'p', text: '我开始意识到：也许问题不是我不够努力。而是我的人生系统，积累了一些长期没有处理的技术债。' },

    // 01
    { type: 'h2', kicker: 'CORE', text: '01 · 程序员都知道技术债，但很少审查自己的人生债' },
    { type: 'p', text: '做软件的人都知道：一个系统刚开始的时候通常很简单——需求来了，快速实现，先上线，以后优化。这是一种非常正常的工程选择，因为创业公司需要速度，业务需要验证，项目需要交付。' },
    { type: 'p', text: '但是随着时间推移：临时方案越来越多，历史代码越来越复杂，系统越来越难维护。最后出现一种情况：没人敢轻易修改，一个简单需求也可能引发连锁问题。这就是技术债。' },
    { type: 'p', text: '人生其实也是一样。我们年轻的时候，也在不断「快速上线」。' },
    { type: 'h3', text: '为了获得更好的机会、证明自己的价值、获得稳定发展、完成目标——我们拼命奔跑' },
    { type: 'p', text: '为了获得更好的机会，我们努力提升技术能力；为了证明自己的价值，我们承担越来越多的工作；为了获得稳定发展，我们接受组织安排；为了完成目标，我们牺牲自己的时间和身体。' },
    { type: 'p', text: '这些选择在当时没有错，甚至很多时候正是这些选择让我们走到了今天。但是问题在于：很多东西上线以后，我们再也没有回来维护。于是过去帮助我们成长的东西，慢慢变成了限制我们的东西。这就是：人生技术债。' },

    // 02
    { type: 'h2', kicker: 'ASSET', text: '02 · 第一笔人生技术债：只积累能力，没有建设资产' },
    { type: 'p', text: '很多技术人的成长路径非常类似。年轻的时候：能力 = 技术，价值 = 解决问题。所以我们不断学习、不断深入、不断挑战复杂问题——谁能解决别人解决不了的问题，谁就是团队里的核心。这套逻辑在前十年非常有效。' },
    { type: 'p', text: '但是到了职业中后期，问题出现了。因为组织对你的期待开始变化——它不再只需要一个「能完成任务的人」，而需要一个「能够设计系统的人」。' },
    { type: 'p', text: '但是很多技术人还停留在过去的成长模式里：不断提升代码能力、架构能力、技术深度，却忽略了一件事情——你的经验有没有沉淀成自己的资产？' },
    { type: 'p', text: '比如：你解决过的问题有没有形成方法？你踩过的坑有没有形成文章？你积累的经验有没有形成自己的认知体系？如果没有，那么十年经验，可能只是十年重复。' },
    { type: 'p', text: '真正有价值的经验，不应该只存在你的脑子里。它应该可以：被记录、被复用、被传播、被放大。' },

    // 03
    { type: 'h2', kicker: 'INTERFACE', text: '03 · 第二笔人生技术债：把自己设计成了公司的一个接口' },
    { type: 'p', text: '这是很多技术人的共同困境。我们习惯成为一个可靠的人——线上出问题找你，项目延期找你，技术难题找你。久而久之，你成为组织里的「关键节点」。' },
    { type: 'p', text: '但这里隐藏着一个风险。你有没有发现：很多技术高手，最后成为了高级执行者？不是因为能力不够，恰恰是因为太擅长解决具体问题。组织不断给你输入需求，你不断输出解决方案。久而久之，你变成了一个非常优秀的接口。' },
    { type: 'p', text: '但是——接口依赖系统存在，一旦系统变化，接口价值就会重新评估。这就是很多 40 岁技术人的焦虑来源：不是不会做事情，而是过去十年证明了自己「能完成任务」，但是未来十年，需要证明自己「能创造系统」。' },

    // 04
    { type: 'h2', kicker: 'RISK', text: '04 · 第三笔人生技术债：收入系统只有一个生产环境' },
    { type: 'p', text: '程序员应该很容易理解这个问题。一个重要系统如果只有一个生产环境，风险会非常高——没有备份，没有容灾，没有故障转移。' },
    { type: 'p', text: '很多人的人生，其实也是单环境部署，结构非常简单：' },
    { type: 'flow', nodes: ['公司', '岗位', '工资', '生活'] },
    { type: 'p', text: '只要公司稳定，系统正常运行。但是——行业变化、组织调整、岗位变化，整个系统都会受到影响。很多人到了 40 岁才意识到：最大的风险不是技术过时，而是自己只有一个收入来源。没有第二增长曲线，没有个人影响力，没有自己的长期资产。这就是：人生单点故障。' },

    // 05
    { type: 'h2', kicker: 'OPTIMIZE', text: '05 · 第四笔人生技术债：每天解决问题，却没有升级自己的系统' },
    { type: 'p', text: '这是最容易被忽略的一点，因为工作中的反馈太强烈了。一个 Bug 修复、一个项目上线、一个问题解决，都会让你感觉「今天有价值」。但是几年以后回头看，你可能发现：每天都很忙，但是没有留下真正属于自己的东西。' },
    { type: 'p', text: '你的经验、你的思考、你的方法，都随着项目结束消失了。这就像每天都在维护服务器，但是从来没有升级架构。系统可以运行，但越来越脆弱。' },

    // 06
    { type: 'h2', kicker: 'REVIEW', text: '06 · 40 岁之后，需要做一次人生代码审查' },
    { type: 'p', text: '软件工程里，遇到复杂问题，第一步不是马上修改代码，而是：代码审查，找到问题根因。人生也是一样。40 岁之后，也许需要停下来问自己几个问题。' },
    { type: 'h3', text: '职业模块：如果离开现在的平台，我的能力还能在哪里产生价值？' },
    { type: 'h3', text: '知识模块：过去十年的经验，有没有形成自己的方法论？' },
    { type: 'h3', text: '财富模块：除了工资，有没有其他增长来源？' },
    { type: 'h3', text: '个人模块：别人为什么需要我？我的不可替代性在哪里？' },
    { type: 'p', text: '这些问题，不一定马上有答案，但它们值得被重新审视。' },

    // 07
    { type: 'h2', kicker: 'UPGRADE', text: '07 · 人生 Debug，不是推翻过去，而是升级未来' },
    { type: 'p', text: '后来我慢慢理解：40 岁并不是人生系统崩溃，它更像一次升级提醒。过去的版本帮助我们完成了过去十年的成长，但是未来十年，可能需要新的架构。' },
    { type: 'p', text: '从执行者，变成系统设计者。从解决别人定义的问题，变成发现和定义问题。从依赖单一组织，变成建设自己的系统。' },
    { type: 'p', text: '这不是否定过去。过去的努力依然有价值，只是旧版本完成了它的使命，现在需要一次升级。' }
  ],

  'life-debug:002': [
    // 引言卡片
    { type: 'callout', text: '「停下来」，像做 Code Review 一样，重新检查自己的人生系统。' },

    // 前言
    { type: 'p', text: '有一段时间，我经常有一种奇怪的感觉。每天都很忙。会议很多。需求很多。问题很多。别人看起来可能觉得：一个工作十几年的技术人，应该已经非常稳定了。有经验。懂业务。能解决复杂问题。遇到事情也能够扛下来。' },
    { type: 'p', text: '可是只有自己知道：心里其实一直有一种隐隐的不确定感。' },
    { type: 'p', text: '我开始问自己几个问题。如果五年以后，公司不再需要现在的我，我还能依靠什么？如果未来技术变化越来越快，过去积累的经验，还有多少价值？如果有一天，我离开现在的位置，我真正拥有的东西是什么？' },
    { type: 'p', text: '这些问题，以前我很少认真想。因为每天都有新的任务、新的需求、新的问题，就像一个运行中的线上系统——只要没有宕机，就很少有人愿意停下来检查。' },
    { type: 'p', text: '但是某一天，我突然意识到：过去十几年，我一直在维护公司的系统。可是——我好像很少认真维护自己的人生系统。' },

    // 01
    { type: 'h2', kicker: 'REVIEW', text: '01 · 程序员会做 Code Review，却很少给自己做人生 Review' },
    { type: 'p', text: '作为程序员，我们都知道：代码写久了，一定会产生问题。哪怕最开始的设计非常合理，随着需求不断增加、功能不断叠加、人员不断变化，系统里面一定会出现：历史代码、临时方案、隐藏依赖。' },
    { type: 'p', text: '这些东西，在刚开始的时候没有问题，甚至帮助系统快速上线。但是时间久了，它们会慢慢变成维护成本。这就是技术债。' },
    { type: 'h3', text: 'Code Review 的本质：理解过去，发现风险，优化未来' },
    { type: 'p', text: '成熟的软件团队，会定期做一件事情：Code Review。不是为了证明谁写错了，也不是为了否定过去的设计，而是：重新理解系统、发现隐藏风险、优化未来架构。' },
    { type: 'p', text: '后来我发现：人生其实也是一样。我们年轻的时候，也在不断写自己的「人生代码」。为了进入更好的公司，我们学习技术；为了证明自己的价值，我们承担更多责任；为了获得稳定，我们接受组织安排；为了完成目标，我们牺牲时间和健康。' },
    { type: 'p', text: '这些选择，当时都是合理的，因为它们帮助我们走到了今天。但是问题是：很多代码上线以后，就再也没有回头维护。很多人生选择也是一样。我们不断增加功能、增加责任、增加负载，却很少停下来问：现在这套系统，还适合未来十年吗？' },

    // 02
    { type: 'h2', kicker: 'DEBT', text: '02 · 我的第一次人生代码审查：发现自己欠了几笔债' },
    { type: 'p', text: '当我开始认真检查自己的时候，我发现：很多问题并不是突然出现的，它们早就在系统里存在。只是以前年轻、机会多、身体还能扛，所以没有暴露出来。就像一个运行多年的系统，平时看起来没问题，但是流量增加以后，隐藏的问题开始出现。' },
    { type: 'h3', text: '第一笔债：能力债' },
    { type: 'p', text: '我第一个检查的问题是：这些年，我到底积累了什么？过去十几年，我学过很多技术，参与过很多项目，解决过很多复杂问题。但是如果有一天脱离现在的公司环境，这些经验还能不能产生价值？' },
    { type: 'p', text: '这个问题让我停顿了很久。因为以前我认为：技术能力，就是我的核心资产。但是后来我发现：技术只是能力的一部分。真正有长期价值的东西，应该是我解决问题的方法、我理解业务的能力、我总结出来的规律、我形成的判断体系。如果这些东西只存在我的脑子里，随着项目结束消失，那么它更像一次性的代码，而不是可以复用的组件。' },
    { type: 'h3', text: '第二笔债：经验债' },
    { type: 'p', text: '这是很多技术人的共同问题。我们经常说「我有十几年经验」，但是后来我开始问自己：这十几年，是十几年成长？还是一年经验重复了十年？区别很大。如果每一年都有新的认知、新的方法、新的沉淀，那么经验会产生复利。但是如果只是不断完成任务、不断解决问题、不断进入下一个项目，那么时间只是增加了熟练度。' },
    { type: 'p', text: '经验真正的价值，不在于经历过多少事情，而在于：你有没有从经历中提炼出自己的系统。' },
    { type: 'h3', text: '第三笔债：表达债' },
    { type: 'p', text: '这是我以前低估的一笔债。技术人很容易相信：只要事情做好，价值自然会被看到。代码写好了、系统稳定了、问题解决了——事实证明：并不完全如此。' },
    { type: 'p', text: '因为随着职业阶段变化，你的价值越来越复杂。年轻的时候，你的价值可能体现在写代码、解决 Bug、完成需求。但是到了中后期：你的价值更多体现在判断、决策、影响、协作。这些东西，如果不能被表达，别人很难理解。这不是让自己包装，而是升级自己的沟通接口。过去我和世界连接的接口是代码，未来我需要增加新的接口：文字、表达、影响力、方法论。' },
    { type: 'h3', text: '第四笔债：依赖债' },
    { type: 'p', text: '这是我后来意识到比较严重的一件事情。很多技术人的职业系统，其实是一种单节点架构，结构很简单：' },
    { type: 'flow', nodes: ['公司', '岗位', '工资', '生活'] },
    { type: 'p', text: '过去很多年，这个系统运行得很好——公司提供平台、岗位提供收入、我提供能力，彼此交换。但是任何系统都有风险。公司会变化、行业会变化、岗位会变化。如果整个系统只有一个节点，那么风险其实很高。' },
    { type: 'p', text: '所以我开始思考：除了当前工作，我有没有建立自己的备用系统？不是说马上离开公司，也不是说所有人都应该创业，而是：未来的自己，有没有更多选择？有没有自己的知识资产、自己的持续输出、自己的个人影响力？这些东西短期看不到收益，但是它们是在为未来建立故障转移能力。' },
    { type: 'h3', text: '第五笔债：身体债' },
    { type: 'p', text: '这一笔债，是很多技术人最容易忽略的。年轻的时候，我们习惯认为：身体可以恢复，熬夜、加班、高压力，都可以扛过去。但是到了 40 岁左右，我越来越意识到：身体不是普通模块，它是整个系统的基础设施。如果底层资源不足，上层所有功能都会受到影响。未来十年的竞争，不仅仅是能力竞争，也是系统稳定性竞争。' },

    // 03
    { type: 'h2', kicker: 'UNDERSTAND', text: '03 · 人生代码审查，不是为了否定过去' },
    { type: 'p', text: '当我把这些债列出来的时候，其实有一瞬间，我也会产生一个想法：是不是以前走错了？后来我发现：不是。真正优秀的工程师，不会责怪旧代码。因为他知道：当年的设计，一定是在当年的约束条件下做出的最佳选择。年轻时候追求技术没有错，努力工作没有错，承担责任没有错。这些选择，构成了今天的自己。' },
    { type: 'p', text: '代码审查的目的，不是批判过去，而是：理解过去、优化现在、设计未来。人生也是一样。' },

    // 04
    { type: 'h2', kicker: 'REDESIGN', text: '04 · 40 岁以后，我想重新设计自己的人生系统' },
    { type: 'p', text: '这也是我开始写《人生 Debug》的原因。我不是因为已经找到了答案，恰恰相反，是因为我也正在寻找答案。我想记录：一个 40 岁程序员，如何重新检查自己的系统。哪些地方需要修复、哪些地方需要升级、哪些地方需要重新设计。也许未来某一天回头看，现在写下的这些文字，就是这一次人生重构留下的版本记录。' },
    { type: 'p', text: '如果你也处在人生某个版本切换阶段，也许你也可以问自己几个问题：过去十年，我真正积累了什么？哪些能力正在失效？哪些经验还没有被转化？我的人生系统，有没有隐藏的单点故障？未来十年，我希望自己成为怎样的人？' },
    { type: 'p', text: '这些问题，不一定马上有答案，但是值得开始一次审查。因为不知道自己欠了什么债，就不知道未来应该优化哪里。' },
    { type: 'p', text: '人生不会因为一次代码审查，就变得完美。系统也不会因为一次重构，就永远稳定。但是一个愿意持续 Debug 自己的人，至少不会一直运行在旧版本里。' }
  ],

  'life-debug:003': [
    // 引言卡片
    { type: 'callout', text: '「认知接口」也许没坏，只是和这个世界还在用旧版协议通信。' },

    // 前言
    { type: 'p', text: '有一段时间，我发现自己遇到一个很奇怪的问题：明明做了很多事情，也解决了很多问题，但是别人好像并没有完全理解我的价值。甚至有时候，我会产生一种错觉——是不是现在的组织，不再需要技术人了？技术能力已经不重要了？年轻人掌握的新技术，正在快速替代过去的经验？' },
    { type: 'p', text: '后来我认真想了一下，发现事情可能没有这么简单。问题也许不是我的能力下降了，而是：我和这个世界沟通的方式，可能还停留在过去。' },

    // 01
    { type: 'h2', kicker: 'INTERFACE', text: '01 · 程序员最熟悉的东西：接口' },
    { type: 'p', text: '作为程序员，我们每天都在和接口打交道。两个系统想要通信，不是靠猜，需要定义协议：输入是什么、输出是什么、参数是什么、返回值是什么。只有双方遵守同一个协议，信息才能正确传递。' },
    { type: 'p', text: '如果接口协议不匹配，会发生什么？系统调用失败、数据无法解析、双方无法协作。' },
    { type: 'p', text: '后来我发现：人与世界之间，其实也存在一个接口。这个接口，就是：认知接口。' },

    // 02
    { type: 'h2', kicker: 'OLD', text: '02 · 我以前的认知接口：只要做好事情，就会被看见' },
    { type: 'p', text: '这是很多技术人的默认配置，特别是我们这一代程序员。刚进入行业的时候，这个逻辑非常有效：写出高质量代码，解决复杂问题，保证系统稳定——这些事情，会直接带来反馈。你解决了线上事故，领导会看到；你完成了重要项目，团队会认可。' },
    { type: 'p', text: '于是我们慢慢形成了一套认知协议：' },
    { type: 'kvlist', pairs: [
      { k: '输入', v: '努力工作' },
      { k: '输出', v: '获得认可 / 获得机会 / 获得成长' }
    ]},
    { type: 'p', text: '这个协议在过去很多年运行良好，于是我们相信：只要持续提升能力，价值自然会被发现。' },
    { type: 'p', text: '但是后来，我发现：这个接口开始失效了。不是因为努力没有价值，而是环境变化了。' },

    // 03
    { type: 'h2', kicker: 'MISMATCH', text: '03 · 第一次接口失配：技术价值不再自动传输' },
    { type: 'p', text: '以前，一个优秀技术人的价值非常容易观察：代码质量、系统稳定性、问题解决速度。这些东西相对明确。但是到了职业中后期，你的价值开始发生变化——你解决的问题越来越复杂，很多价值变成：判断、设计、协调、影响。这些东西不再直接暴露。' },
    { type: 'p', text: '比如：你提前发现了一个架构风险，最终系统没有出问题，但是别人可能感受不到你的贡献。你帮助团队避免了一次错误决策，最终什么都没有发生，别人也很难知道你的价值。这时候，如果还使用过去的接口——「我把事情做好，别人自然会看到」——就会出现问题，因为你的价值没有被正确传输。' },

    // 04
    { type: 'h2', kicker: 'LANGUAGE', text: '04 · 第二次接口失配：你还是用技术语言描述自己' },
    { type: 'p', text: '这是我后来意识到的一个问题。技术人有一个天然习惯：喜欢描述过程——我做了什么、用了什么技术、解决了什么问题。但是组织真正关注的，往往不是这些。他们更关注：为什么做、解决什么问题、创造什么价值。' },
    { type: 'p', text: '这其实是两个不同的协议。比如：' },
    { type: 'quote', text: '「我完成了系统架构升级，引入了新的消息队列方案，提高了系统吞吐能力。」' },
    { type: 'p', text: '这是技术语言。但换一个表达：' },
    { type: 'quote', text: '「通过架构调整，降低核心业务风险，提高系统承载能力，为未来业务增长留下空间。」' },
    { type: 'p', text: '这就是业务语言。事情没有变化，但是接口协议变了。信息传输效率完全不同。' },

    // 05
    { type: 'h2', kicker: 'IDENTITY', text: '05 · 第三次接口失配：你的身份定义还停留在过去' },
    { type: 'p', text: '这是我最近思考比较多的问题。很多技术人，包括我自己，很容易给自己贴一个标签：「我是程序员」。这个标签没有错，但是它可能限制了我们。因为「程序员」这个身份，容易让别人默认：写代码、实现需求、解决 Bug。但是工作十几年之后，你的能力其实已经超过这个范围——你可能理解业务、设计系统、培养新人、推动项目、识别风险。' },
    { type: 'p', text: '可是如果你自己都还用「我就是写代码的」，那么别人也很难看到更完整的你。你和世界之间的接口定义，决定了世界如何调用你。' },

    // 06
    { type: 'h2', kicker: 'REBUILD', text: '06 · 我开始重新设计自己的认知接口' },
    { type: 'p', text: '意识到这个问题之后，我开始尝试做一件事情：重新定义自己。不是我会什么技术，而是我能解决什么问题；不是完成了多少需求，而是创造了什么价值；不是作为一个执行者，而是作为一个系统设计者。' },
    { type: 'p', text: '这其实是一种接口升级。' },
    { type: 'p', text: '过去：' },
    { type: 'kvlist', pairs: [
      { k: '身份', v: '程序员' },
      { k: '能力', v: '写代码' },
      { k: '价值', v: '完成任务' }
    ]},
    { type: 'p', text: '未来：' },
    { type: 'kvlist', pairs: [
      { k: '身份', v: '技术系统设计者' },
      { k: '能力', v: '理解问题、设计方案、创造系统' },
      { k: '价值', v: '持续解决复杂问题' }
    ]},

    // 07
    { type: 'h2', kicker: 'UPGRADE', text: '07 · 认知接口升级，不是改变自己，而是重新暴露自己' },
    { type: 'p', text: '程序员应该很容易理解这个概念：一个系统升级接口，不是把内部全部推翻，而是调整对外暴露的能力。人生也是一样。过去十年的经历，没有浪费——那些项目、那些问题、那些踩过的坑，都是你的内部能力。但是未来，你需要设计一个新的接口，让这些能力被理解、被连接、被放大。' },

    // 08
    { type: 'h2', kicker: 'DIRECTION', text: '08 · 我给自己的下一阶段定义了三个接口升级方向' },
    { type: 'h3', text: '第一个接口：从技术输出，到认知输出' },
    { type: 'p', text: '以前：分享代码、分享技术方案。未来：分享经验、分享方法、分享模型，把解决问题的过程沉淀成别人可以复用的东西。' },
    { type: 'h3', text: '第二个接口：从内部价值，到外部价值' },
    { type: 'p', text: '以前价值主要存在组织内部，未来尝试建立组织之外的连接——写作、输出、交流，让自己的能力不只依赖一个环境。' },
    { type: 'h3', text: '第三个接口：从执行接口，到设计接口' },
    { type: 'p', text: '以前别人给问题，我解决问题；未来主动发现问题、定义问题、设计解决方案。这是职业后半程，需要完成的一次升级。' },

    // 09
    { type: 'h2', kicker: 'EPILOGUE', text: '09 · 旧版本的认知接口，已经无法连接新的世界' },
    { type: 'p', text: '后来我越来越觉得：40 岁之后，很多技术人的困境，不是能力不够，而是旧版本的认知接口，已经无法连接新的世界。过去那套协议，帮助我们走到了今天，但是未来十年，可能需要升级。' },
    { type: 'p', text: '代码需要接口设计，人生同样需要。如果你现在的系统运行正常，但越来越难被理解，也许不是系统出了问题，可能只是你的接口协议，已经到了需要升级的时候。' },
    { type: 'p', text: '《人生 Debug》的第三步：不是马上改变自己，而是先重新认识自己，找到那个更适合未来十年的接口。' }
  ],

  'life-debug:004': [
    // 引言卡片
    { type: 'callout', text: '「灰度发布」，而不是直接推倒重来——这是 40 岁程序员最需要的转型方式。' },

    // 前言
    { type: 'p', text: '有一段时间，我经常会想一个问题：如果有一天，我不做现在的工作了，我应该怎么办？这个问题以前其实没有那么强烈——因为年轻的时候，路径很清晰：学习技术、积累经验、进入更好的公司、承担更大的项目、提升自己的价值。每一步虽然辛苦，但大方向是明确的。' },
    { type: 'p', text: '可是到了 40 岁左右，很多事情开始变得不一样。技术还在发展，行业变化越来越快，组织里的不确定性越来越高。你会发现：过去那套成长模型，好像正在慢慢失效。以前是「努力 → 提升 → 晋升 → 更好的机会」，现在却是「努力之后，未必有确定的结果」。' },
    { type: 'p', text: '于是很多人开始产生一个想法：是不是应该彻底改变？换行业、创业、做自媒体、转管理、重新开始。我也曾经有过这样的冲动，甚至会想是不是应该直接离开现在的环境、重新开始一套人生系统。' },
    { type: 'p', text: '但是后来，我想到一个程序员非常熟悉的概念：灰度发布。' },

    // 01
    { type: 'h2', kicker: 'LAUNCH', text: '01 · 程序员不会直接把未经验证的代码推向所有用户' },
    { type: 'p', text: '做软件的人都知道：一个重要功能上线之前，通常不会直接全量发布。为什么？因为你不知道它是否真的稳定、是否符合预期、是否会产生新的问题。' },
    { type: 'p', text: '所以成熟的软件团队通常会采用灰度发布：先让一小部分用户使用，观察数据、收集反馈，确认稳定之后，再逐步扩大范围。比如：第一阶段 1% 的用户，第二阶段 10%，第三阶段 50%，最后 100% 上线。' },
    { type: 'flow', nodes: ['1%', '10%', '50%', '100%'] },
    { type: 'p', text: '这背后的核心思想是：不要用一次赌博，决定整个系统的未来。' },
    { type: 'p', text: '后来我发现：人生其实也应该这样。' },

    // 02
    { type: 'h2', kicker: 'RESTART', text: '02 · 我曾经误以为，改变人生需要一次「大重启」' },
    { type: 'p', text: '很多人在 40 岁左右产生焦虑，不是因为没有能力，而是突然发现：过去的路径可能不再确定。于是容易产生一种想法：我要彻底改变、我要重新开始、我要摆脱现在的一切。这种想法其实很容易理解——因为当一个系统运行出现问题时，人的第一反应往往是：重写。' },
    { type: 'p', text: '但是实际工作中，真正成熟的工程师很少这么做。为什么？因为正在运行的系统不能轻易推倒。旧系统虽然有问题，但它也承载着业务，贸然重构可能带来更大的风险。人生也是一样：现在的工作、现在的收入、现在积累的经验，可能不完美，但它们依然是你的生产环境。' },

    // 03
    { type: 'h2', kicker: 'REFORM', text: '03 · 我开始重新理解：转型不是逃离，而是灰度测试' },
    { type: 'p', text: '以前我对转型的理解比较简单：要么不做，要做就全力投入——辞职、创业、转行。后来我发现，这其实是一种高风险发布方式：相当于直接关闭旧系统、上线新系统。但是新的系统是否稳定？用户是否接受？商业模式是否成立？这些都没有经过验证。' },
    { type: 'p', text: '所以后来我开始改变思路。也许更好的方式是：先做灰度发布。' },

    // 04
    { type: 'h2', kicker: 'EXPERIMENT', text: '04 · 我的第一次人生灰度发布：从「想法」变成「小实验」' },
    { type: 'p', text: '当我开始思考未来方向时，我没有再问「我要不要彻底改变？」而是换了一个问题：「我能不能先验证一个新的可能？」' },
    { type: 'p', text: '比如：我一直对写作、内容输出感兴趣。以前的想法是如果做就应该认真做——做账号、做定位、做商业化。但这样想很容易被压力压垮，因为目标太大。' },
    { type: 'p', text: '后来我换了一个方式：先发布一篇文章，先录一期内容，先验证——有没有人愿意阅读？有没有人产生共鸣？有没有人愿意交流？这其实就是人生灰度发布。不是立即改变人生，而是在当前系统之外，运行一个新的实验环境。' },

    // 05
    { type: 'h2', kicker: 'FEAR', text: '05 · 灰度发布最大的价值：降低恐惧' },
    { type: 'p', text: '很多人不敢改变，不是因为没有能力，而是因为改变意味着放弃确定性。现在的工作虽然不满意，但它提供收入、经验和生活基础。如果一下子全部放弃，心理压力会非常大。' },
    { type: 'p', text: '但是灰度发布不同。它允许你：保留当前系统，同时探索未来版本。白天继续工作，晚上学习、输出、实验、验证。不是逃离现在，而是为未来增加一个备用系统。' },

    // 06
    { type: 'h2', kicker: 'MONITOR', text: '06 · 人生灰度发布，需要三个监控指标' },
    { type: 'p', text: '软件灰度发布之后，一定会看监控：错误率、性能、用户反馈。人生实验也一样。如果你正在尝试一个新方向，不要只看「我喜不喜欢」，还需要观察：' },
    { type: 'h3', text: '第一：有没有持续产生价值？' },
    { type: 'p', text: '比如写文章，有没有越来越清晰？有没有形成自己的观点？' },
    { type: 'h3', text: '第二：有没有获得外部反馈？' },
    { type: 'p', text: '有没有人愿意阅读、讨论、认可？' },
    { type: 'h3', text: '第三：自己是否能够长期坚持？' },
    { type: 'p', text: '一个方向，不是靠一时激情，而是靠长期运行。' },

    // 07
    { type: 'h2', kicker: 'DECISION', text: '07 · 灰度发布不是犹豫，而是一种高级决策方式' },
    { type: 'p', text: '以前我觉得：快速行动就是勇敢。后来发现，真正成熟的行动，不一定是快，而是风险可控。' },
    { type: 'p', text: '优秀工程师不会因为害怕上线失败，就永远不上线。但也不会因为想快速交付，就直接把未经测试的代码推给所有用户。人生也是一样。真正的成长，不是一次豪赌，而是：持续实验、持续反馈、持续调整。' },

    // 08
    { type: 'h2', kicker: 'VERSION', text: '08 · 40 岁之后，我更相信「小版本迭代」' },
    { type: 'p', text: '年轻的时候，我们喜欢大目标：我要成为专家、我要进入大厂、我要获得更高职位。这些目标没有错。但是到了人生后半程，也许需要换一种方式。不要总想着一次改变人生，而是每一次升级一个版本。' },
    { type: 'p', text: '今天多输出一次，这个月完成一个小项目，半年后验证一个新方向，一年后回头看——你可能已经完成了一次系统迁移。' },

    // 09
    { type: 'h2', kicker: 'THE END', text: '∞ · 不要急着重启人生，先发布一个新的版本' },
    { type: 'p', text: '后来我越来越觉得：人生最大的风险，不是改变，而是在旧系统已经出现问题的时候，仍然拒绝测试新版本。但是改变也不应该是一场赌博——程序员不会把未经验证的代码直接推给所有用户，那么我们为什么要把未经验证的人生选择，直接推向自己的全部未来？' },
    { type: 'p', text: '40 岁之后，我想尝试一种新的方式：不是推翻过去，而是在过去的基础上，一点一点发布新的自己。先灰度，再验证，再升级。这也是《人生 Debug》的第四步：不要急着重启人生，先发布一个新的版本，看看未来的那个自己，是否真的能够运行。' }
  ],

  'life-debug:005': [
    // 引言卡片
    { type: 'callout', text: '「单点故障」——人生最大的风险，不是能力不足，而是所有希望只押在一个节点上。' },

    // 前言
    { type: 'p', text: '有一次，我在复盘自己的职业状态时，突然意识到一个问题。这些年，我一直在提升自己的能力、学习技术、解决问题、承担更大的责任。从表面来看，我的系统运行得还不错——有工作、有收入、有经验、有一定的问题解决能力。' },
    { type: 'p', text: '但是当我问自己一个问题时，我突然停住了。如果现在这个系统发生故障，我有没有备用方案？' },
    { type: 'p', text: '比如：如果有一天公司业务调整、如果岗位发生变化、如果组织不再需要现在的能力结构，我的生活会不会受到巨大影响？答案其实并不乐观。因为我发现：过去很多年，我的人生系统里，存在一个非常明显的问题——单点故障。' },

    // 01
    { type: 'h2', kicker: 'FAULT', text: '01 · 程序员最害怕什么？单点故障' },
    { type: 'p', text: '做技术的人都知道：一个系统最危险的地方，不是某个模块偶尔出现 Bug，而是整个系统依赖某一个不可替代的节点。比如数据库只有一个实例、没有备份、没有故障转移——平时运行正常，但是一旦数据库挂掉，整个业务停止。这就是单点故障。' },
    { type: 'p', text: '成熟的系统设计，会尽量避免这种情况。增加副本、增加备用节点、设计容灾方案，目的只有一个：即使某个部分失效，整个系统仍然可以继续运行。后来我发现：人生其实也是一个复杂系统，而很多人的人生，也存在单点故障。' },

    // 02
    { type: 'h2', kicker: 'ARCHITECTURE', text: '02 · 我的人生系统里，最大的单点故障是什么？' },
    { type: 'p', text: '以前我没有认真思考过这个问题。因为在过去很长时间里，工作就是我的主要系统——收入来自工作、成长来自工作、价值感来自工作。这个模型运行了很多年，所以我默认：只要把当前工作做好，未来就会自然展开。' },
    { type: 'p', text: '但是后来环境变化，让我开始重新审视这个设计。我发现：我的人生架构有点像这样：' },
    { type: 'flow', nodes: ['公司', '岗位', '收入', '生活'] },
    { type: 'p', text: '看起来很稳定。但是实际上：所有关键能力都集中在一个节点上。如果这个节点发生变化，下面所有模块都会受到影响。这就是典型的单点架构。' },

    // 03
    { type: 'h2', kicker: 'DEPENDENCY', text: '03 · 为什么很多优秀的人，也会陷入单点故障？' },
    { type: 'p', text: '这是我后来思考比较多的问题。很多建立单点依赖的人，并不是不努力——恰恰相反，他们往往是过去太专注于做好当前事情。一个技术人如果在公司里持续成长，很容易形成这样的路径：做好技术、解决复杂问题、成为核心成员、承担更多责任。这条路径本身没有问题。' },
    { type: 'p', text: '问题在于：我们容易把「公司里的价值」等同于「自己的全部价值」。公司认可你，你觉得自己有价值；公司需要你，你觉得未来有保障。但是——组织系统和个人系统，本质不同。公司会变化、业务会调整、战略会转移，组织关注的是当前阶段需要什么，而个人需要考虑的是未来十年，我还能依靠什么。' },

    // 04
    { type: 'h2', kicker: 'WARNING', text: '04 · 单点故障最危险的时候，不是崩溃，而是没有准备' },
    { type: 'p', text: '其实很多系统不是突然坏掉的，而是在问题发生之前已经出现很多信号——流量增长、响应变慢、资源不足，只是因为系统还能运行，所以大家选择忽略。人生也是一样。很多 40 岁左右的技术人，其实已经感受到一些信号：技术更新越来越快、年轻人的竞争越来越强、组织对技术价值的评价在发生变化。' },
    { type: 'p', text: '但是因为工资还在发、项目还能推进、生活还能继续，所以很多人选择先吧。直到某一天，真正的问题出现，才发现：自己没有备用方案。' },

    // 05
    { type: 'h2', kicker: 'DESIGN', text: '05 · 我开始给自己设计「故障转移」' },
    { type: 'p', text: '意识到这个问题之后，我没有马上否定现在的工作——因为当前工作依然是我的重要基础。一个运行中的系统，不能因为发现风险就直接关闭。更合理的方式是：增加备用能力。就像系统容灾一样，我的思考开始发生变化：' },
    { type: 'p', text: '过去：我要依靠公司获得全部价值。未来：我要让自己的价值可以跨环境运行。' },

    // 06
    { type: 'h2', kicker: 'BACKUP', text: '06 · 人生系统，需要哪些备用节点？' },
    { type: 'p', text: '后来我开始尝试建立几个新的模块。' },
    { type: 'h3', text: '第一个：知识资产' },
    { type: 'p', text: '过去解决的问题，不能只停留在过去。那些经验、方法、判断，应该沉淀下来。从「我做过」，变成「我能够讲清楚」，再变成「别人可以复用」。' },
    { type: 'h3', text: '第二个：表达能力' },
    { type: 'p', text: '技术人的一个隐藏问题：拥有大量经验，但是没有形成输出。如果能力只存在自己的脑子里，它很难产生复利。文字、视频、分享，其实是在建立个人能力接口。' },
    { type: 'h3', text: '第三个：外部连接' },
    { type: 'p', text: '过去很多人的职业关系，主要围绕公司、同事、项目、组织。但是未来，需要建立更多连接——行业交流、内容输出、同行关系，这些都是个人系统的备用链路。' },

    // 07
    { type: 'h2', kicker: 'STABILITY', text: '07 · 避免单点故障，不是让自己变成超人' },
    { type: 'p', text: '这里有一个容易误解的地方。很多人听到「建立第二曲线」，马上想到：我要同时做很多事情——工作、副业、创业、学习，最后把自己变成一个多线程运行的人。但是系统设计里，增加节点不是无限增加负担。真正优秀的架构，不是复杂，而是稳定。人生也是一样，不是要求你同时拥有十种能力，而是不要把所有希望压在一个节点上。' },

    // 08
    { type: 'h2', kicker: 'REDESIGN', text: '08 · 40 岁之后，我开始重新设计自己的人生架构' },
    { type: 'p', text: '年轻的时候，我们追求更快、更高、更强。但是到了人生后半程，可能需要考虑稳定性。一个成熟系统，不是没有故障，而是故障发生时，还有恢复能力。' },
    { type: 'p', text: '未来十年，我希望自己的系统变成这样：' },
    { type: 'architecture', root: '自己', branches: [
      { label: '工作系统', desc: '稳定收入来源' },
      { label: '知识系统', desc: '认知沉淀资产' },
      { label: '输出系统', desc: '影响与连接' }
    ], bottom: '收入基础' },
    { type: 'p', text: '工作依然重要，但是它不再是唯一节点。我希望：即使未来环境变化，自己依然有调整空间。' },

    // 09
    { type: 'h2', kicker: 'CHECK', text: '09 · 没有备用节点的人生，看似稳定，其实风险最高' },
    { type: 'p', text: '后来我越来越觉得：40 岁之后最大的风险，不是年龄增长，而是你的人生系统，仍然只有一个节点。年轻的时候，单线程运行没有问题，因为我们还有时间、还有很多试错空间。但是到了人生中段，需要开始考虑系统可靠性——不是因为悲观，而是因为真正成熟的工程师，永远会提前设计容灾方案。人生也是如此。' },
    { type: 'p', text: '你不需要马上改变一切，但是你可以问自己几个问题：如果现在的工作发生变化，我还有什么能力可以迁移？如果收入来源中断，我还有什么备用方案？如果过去积累的经验失效，我还能创造什么价值？这些问题，不是为了制造焦虑，而是一次人生架构检查。因为没有备用节点的人生，看似稳定，其实风险最高。' },
    { type: 'p', text: '《人生 Debug》的第五步：不是逃离当前系统，而是给自己增加一个新的节点，让未来的自己，拥有更多选择。' }
  ],

  'life-debug:006': [
    // 01 · 引言卡
    { type: 'callout', text: '掌控人生，其实它悄悄依赖了太多外部模块——公司、岗位、技能，还有领导的认可。这些依赖，有些正藏着风险。' },

    // 02 · 前言
    { type: 'p', text: '有一段时间，我开始重新审视自己的职业状态。以前我经常思考：要不要学习新的技术？要不要提升管理能力？要不要寻找新的机会？' },
    { type: 'p', text: '但是后来，我发现：这些问题可能不是最底层的问题。真正应该问的是——我的人生系统，到底依赖什么在运行？' },
    { type: 'quote', text: '「我的人生系统，到底依赖什么在运行？」' },
    { type: 'p', text: '因为很多时候，我们以为自己掌控着人生。但仔细拆开来看，我们其实依赖了很多东西：依赖一家公司、依赖一个岗位、依赖一种技能、依赖某个领导的认可、依赖某种行业环境。' },
    { type: 'p', text: '这些依赖，有些是健康的，有些却隐藏着风险。就像软件系统一样——如果一个模块和另一个模块强耦合，短期运行没有问题，但一旦其中一个发生变化，整个系统都会受到影响。' },
    { type: 'p', text: '后来我想到一个程序设计里的概念：依赖注入。' },

    // 03 · 什么是依赖注入
    { type: 'h2', kicker: 'DEPENDENCY INJECTION', text: '01 · 什么是依赖注入？' },
    { type: 'p', text: '对于程序员来说，依赖注入并不是一个陌生概念。简单理解：一个模块不要自己创建所有需要的东西，而应该由外部提供依赖。为什么？因为这样系统会更加灵活。' },
    { type: 'flow', nodes: ['订单系统', '直接调用短信服务'] },
    { type: 'p', text: '订单系统和短信服务强绑定。以后如果想换成邮件通知，或者企业微信通知，怎么办？可能需要修改大量代码。' },
    { type: 'p', text: '更好的设计是：' },
    { type: 'flow', nodes: ['订单系统', '消息接口', '短信 / 邮件 / 企业微信'] },
    { type: 'p', text: '订单系统只关心：我要发送消息。至于具体怎么发送，由外部注入。这样系统拥有更强的扩展能力。' },

    // 04 · 我曾经把"公司"当成了人生最大的依赖
    { type: 'h2', kicker: 'THE BIGGEST DEPENDENCY', text: '02 · 我曾经把"公司"当成了人生最大的依赖' },
    { type: 'p', text: '回头看自己的职业路径。其实很长时间里，我的人生架构是这样的：' },
    { type: 'flow', nodes: ['个人能力', '公司平台', '岗位价值', '收入来源'] },
    { type: 'p', text: '这套结构运行了很多年，而且效果不错。公司提供机会，项目提供成长，岗位提供收入。所以我很自然地认为：只要继续做好工作，未来就不会有太大问题。' },
    { type: 'p', text: '但是后来我意识到：这里隐藏了一个风险。我的很多能力，其实是通过公司的环境才能发挥出来。离开这个环境以后，这些能力还能不能独立运行？这是一个值得认真思考的问题。' },

    // 05 · 依赖本身没有问题，过度依赖才是问题
    { type: 'h2', kicker: 'HEALTHY VS RISKY', text: '03 · 依赖本身没有问题，过度依赖才是问题' },
    { type: 'p', text: '后来我发现：很多人误解了"独立"。好像人生一定不能依靠任何东西。其实不是。软件系统也需要依赖，一个复杂系统，不可能完全没有外部组件。' },
    { type: 'p', text: '关键问题不是有没有依赖，而是：你的依赖是否健康？' },
    { type: 'p', text: '比如：一个程序依赖一个稳定的第三方服务，有明确接口、有备用方案、有监控机制，这是健康依赖。但如果整个系统依赖一个没人维护的内部脚本，没有文档、没有备份、没有替代方案，这就是风险。人生也是一样。' },
    { type: 'callout', text: '判断标准：依赖不可怕，怕的是"单点 + 无备份 + 不可替换"。' },

    // 06 · 我重新检查了自己的几种依赖
    { type: 'h2', kicker: 'AUDIT MY DEPENDENCIES', text: '04 · 我重新检查了自己的几种依赖' },
    { type: 'p', text: '那段时间，我像检查系统架构一样，重新检查自己的人生依赖。' },
    { type: 'h3', text: '第一种依赖：平台依赖' },
    { type: 'p', text: '过去很多年的成长，离不开公司的平台。这个没有问题。平台给了我项目机会、业务经验、复杂问题。但是问题是：如果有一天平台变化，我的能力还能不能迁移？所以我开始思考：哪些能力属于公司？哪些能力真正属于我？' },
    { type: 'h3', text: '第二种依赖：技能依赖' },
    { type: 'p', text: '技术人的另一个风险：把某项技术能力当成全部价值。年轻的时候，这个非常有效——掌握热门技术、解决技术难题、成为领域专家。但是技术世界变化很快，今天流行的技术，几年后可能变成基础能力。真正长期有效的，不是某个技术工具，而是：学习能力、抽象能力、解决复杂问题的能力。' },
    { type: 'h3', text: '第三种依赖：外部评价依赖' },
    { type: 'p', text: '这是我后来发现比较隐蔽的一种。很多技术人，其实非常依赖外部反馈：项目成功得到认可、解决难题获得成就感。但是如果某一天，没有人关注、没有即时反馈，是不是还知道自己的价值？一个成熟的人生系统，不能完全依赖外部评价运行。' },

    // 07 · 我开始尝试给自己做"依赖解耦"
    { type: 'h2', kicker: 'DECOUPLING', text: '05 · 我开始尝试给自己做"依赖解耦"' },
    { type: 'p', text: '软件系统优化时，一个重要动作是降低耦合。人生也是一样。以前，我的价值高度绑定当前岗位；未来，我希望把价值拆开。' },
    { type: 'quote', text: '以前：价值绑定岗位；未来：把价值拆成可独立运行的模块' },
    { type: 'h3', text: '工作能力' },
    { type: 'p', text: '继续保持，这是当前现金流。' },
    { type: 'h3', text: '方法论沉淀' },
    { type: 'p', text: '把经验变成自己的资产。' },
    { type: 'h3', text: '内容输出' },
    { type: 'p', text: '让自己的认知产生外部连接。' },
    { type: 'h3', text: '持续学习' },
    { type: 'p', text: '保持系统升级能力。这些模块之间相互支持，但不完全绑定。' },

    // 08 · 为什么40岁之后，更需要重新设计依赖关系？
    { type: 'h2', kicker: 'REDESIGN AT 40', text: '06 · 为什么40岁之后，更需要重新设计依赖关系？' },
    { type: 'p', text: '因为人生进入了另一个阶段。年轻的时候，我们更多依靠环境：好的公司、好的机会、好的领导，这些外部因素很重要。但是到了中后期，真正稳定的东西，应该逐渐转移到自己身上。' },
    { type: 'p', text: '不是说不需要平台，而是不能只有平台。不是说不需要组织，而是不能失去离开组织之后的能力。' },

    // 09 · 我现在理解的"依赖注入"
    { type: 'h2', kicker: 'WHAT I NOW KNOW', text: '07 · 我现在理解的"依赖注入"' },
    { type: 'p', text: '以前我认为：安全感来自拥有一个稳定的位置。现在我觉得：真正的安全感来自拥有可以重新连接世界的能力。' },
    { type: 'quote', text: '「你可以依靠公司，但也应该拥有自己的能力接口。你可以依靠平台，但也应该拥有自己的价值模块。」' },
    { type: 'quote', text: '真正的安全感，来自可以重新连接世界的能力' },

    // 10 · 写在最后
    { type: 'h2', kicker: 'THE END', text: '∞ · 写在最后' },
    { type: 'p', text: '回头看，很多40岁左右的技术人焦虑，其实不是因为能力不足，而是突然发现：过去运行良好的系统，依赖关系太单一。我们把很多东西交给了外部：把成长交给公司、把价值交给岗位、把未来交给行业。' },
    { type: 'p', text: '这些东西曾经帮助我们成长。但是未来十年，可能需要重新设计。不是切断所有依赖，而是让自己的系统拥有更多选择。《人生 Debug》的第六步：检查你的依赖关系，问自己几个问题：' },
    { type: 'p', text: '如果离开现在的平台，哪些能力还能运行？如果行业发生变化，哪些价值仍然有效？如果没有外部认可，你是否仍然知道自己的方向？' },
    { type: 'quote', text: '真正稳定的系统，不是永远依赖稳定环境，而是环境变化时依然能够重新连接' }
  ],

  'life-debug:007': [
    // 引言卡
    { type: 'callout', text: '有些问题，不是努力程度的问题，而是系统设计的问题。—— 语霖' },

    // 前言
    { type: 'p', text: '有一段时间，我经常陷入一种矛盾。我知道自己正在面对一些问题，但又说不上来，这些问题到底严重到什么程度。' },
    { type: 'p', text: '工作越来越忙，但是成长感越来越弱。每天解决很多事情，但是回头看，却发现没有留下多少属于自己的东西。' },
    { type: 'p', text: '我也会想：是不是应该学习新的技术？是不是应该换一个方向？是不是应该彻底改变现在的状态？' },
    { type: 'p', text: '可是另一方面，现在的一切，也没有糟糕到需要马上推翻。工作还在继续，经验还在积累，很多能力依然有价值。' },
    { type: 'p', text: '于是我经常问自己：到底什么时候应该改变？什么时候只是需要调整？' },
    { type: 'p', text: '后来我想到程序开发中的一个问题：一个系统出现问题的时候，到底应该修复一个 Bug，还是重新设计整个架构？这个问题，其实和人生非常像。' },

    // 01 · TECH DEBT
    { type: 'h2', kicker: 'TECH DEBT', text: '01 · 很多年的代码，为什么最后会变成「技术债」' },
    { type: 'p', text: '程序员都经历过维护老系统。刚开始的时候，代码通常很简单。需求明确，架构清晰，每个人都知道系统怎么运行。' },
    { type: 'p', text: '但是随着时间过去，需求不断增加，业务不断变化。为了快速交付，我们开始增加一些临时方案。这里加一个判断，那里增加一个特殊逻辑，先解决问题再说。' },
    { type: 'p', text: '这些选择在当时没有错。因为当时的目标是让系统快速运行。' },
    { type: 'p', text: '但是几年之后，问题开始出现。新人不敢修改，老员工不敢重构，一个小需求改动，可能影响整个系统。' },
    { type: 'p', text: '这些过去为了快速解决问题的方法，最后变成了：技术债。' },

    // 02 · TEMP CODE
    { type: 'h2', kicker: 'TEMP CODE', text: '02 · 我发现，人生里也有很多「临时代码」' },
    { type: 'p', text: '后来我开始检查自己的人生系统，发现其实很多选择，和软件系统非常相似。' },
    { type: 'p', text: '年轻的时候，我们也写了很多临时代码。为了进入更好的公司，接受高强度工作；为了证明自己的价值，不断承担更多责任；为了完成目标，牺牲自己的时间。' },
    { type: 'p', text: '这些选择，当时都有合理性。它们帮助我获得经验、积累能力、走到今天。所以我并不认为过去的选择错了。' },
    { type: 'p', text: '但是问题是：有些临时代码，运行了十几年，却从来没有重新审视。' },

    // 03 · ARCHITECTURE
    { type: 'h2', kicker: 'ARCHITECTURE', text: '03 · 最大的问题：把架构问题，当成普通 Bug 修' },
    { type: 'p', text: '这是我后来意识到比较深的一件事情。很多时候，我们一直在解决表面问题。' },
    { type: 'p', text: '感觉职业发展停滞，于是学习更多技术；感觉竞争压力增加，于是投入更多时间；感觉未来不确定，于是继续努力工作。' },
    { type: 'p', text: '这些动作有没有价值？有。但是它们可能只是增加系统资源，而没有改变系统设计。' },
    { type: 'quote', text: '「就像一个程序，运行越来越慢，你不断给服务器加内存，短期有效。但如果根本问题是架构设计不合理，那么增加资源，只是在延缓问题。」' },
    { type: 'p', text: '人生也是一样。有些问题，不是努力程度的问题，而是系统设计的问题。' },

    // 04 · CLASSIFY
    { type: 'h2', kicker: 'CLASSIFY', text: '04 · 我开始区分：哪些问题应该修复，哪些问题需要重构' },
    { type: 'h3', text: '第一类：局部 Bug，可以修复' },
    { type: 'p', text: '比如表达能力不足，可以练习；某项技能落后，可以学习；管理经验不足，可以积累。' },
    { type: 'p', text: '这些问题影响系统，但不会改变整体方向。像软件里的一个功能缺陷，修复即可。' },
    { type: 'h3', text: '第二类：架构问题，需要重构' },
    { type: 'p', text: '比如所有价值都绑定在一个岗位上；比如十几年经验，没有形成自己的方法论；比如每天很忙，但没有产生长期资产。' },
    { type: 'p', text: '这些问题不是靠增加努力解决的。因为底层结构已经限制了上层发展。这时候继续打补丁，只会让系统越来越复杂。' },

    // 05 · PERSISTENCE
    { type: 'h2', kicker: 'PERSISTENCE', text: '05 · 我最大的误区：以为「坚持」可以解决所有问题' },
    { type: 'p', text: '过去很多年，我其实非常相信坚持。遇到困难，继续努力；遇到问题，继续优化。这个习惯帮助我解决了很多问题。' },
    { type: 'p', text: '但是后来我发现：坚持是一种优秀品质，但坚持不一定等于正确方向。' },
    { type: 'p', text: '如果系统方向错了，运行时间越长，可能离目标越远。' },
    { type: 'quote', text: '「一个错误的架构，维护十年，并不会自动变成正确架构。」' },

    // 06 · REFRAME
    { type: 'h2', kicker: 'REFRAME', text: '06 · 但是，重构也不是逃避现实' },
    { type: 'p', text: '后来我又发现另外一个问题。很多人喜欢把「重构人生」理解成：离开现在，推翻过去，重新开始。其实这也是一种误区。' },
    { type: 'p', text: '优秀工程师不会轻易重写系统。因为旧系统里有大量已经验证过的能力。' },
    { type: 'p', text: '人生也是一样。过去十几年的经历，不是废代码。项目经验、行业理解、解决问题的能力，这些都是已经存在的资产。' },
    { type: 'p', text: '真正的重构，不是删除过去，而是重新组织过去。' },

    // 07 · UPGRADE
    { type: 'h2', kicker: 'UPGRADE', text: '07 · 我现在更相信：人生重构，是一次架构升级' },
    { type: 'p', text: '以前我认为，改变人生，意味着成为另一个人。现在我觉得，不是。更像软件版本升级。' },
    { type: 'p', text: '保留已经验证有效的模块，优化影响未来发展的部分，增加适应新环境的新能力。' },
    { type: 'p', text: '比如：过去我靠技术解决问题，未来我希望增加系统设计能力。过去经验主要服务于公司，未来希望把经验沉淀成自己的资产。过去解决别人定义的问题，未来尝试参与定义问题。' },
    { type: 'p', text: '这不是推翻过去，而是升级架构。' },

    // 08 · ITERATE
    { type: 'h2', kicker: 'ITERATE', text: '08 · 我开始接受：人生需要持续重构，而不是一次完成' },
    { type: 'p', text: '以前做项目，总希望有一个最终版本。但是后来发现，软件没有最终版本，只有持续迭代。' },
    { type: 'p', text: '人生也是。不同阶段，面对的问题不同。' },
    { type: 'p', text: '20 岁：建立能力；30 岁：扩大边界；40 岁：重新设计系统。' },
    { type: 'p', text: '每个阶段，都需要重新理解：什么应该保留，什么应该删除，什么应该新增。' },

    // 写在最后
    { type: 'h2', kicker: 'THE END', text: '∞ · 写在最后' },
    { type: 'p', text: '最近重新回看自己的经历，我发现：很多问题，并不是突然出现的。它们只是长期积累之后，终于暴露出来。' },
    { type: 'p', text: '就像一个运行多年的系统，真正的问题，往往隐藏在那些没人关注的地方。' },
    { type: 'p', text: '所以现在，我不再急着问：「我要不要彻底改变？」我更愿意先问：这个问题，到底是一个 Bug，还是一个架构问题？' },
    { type: 'p', text: '如果只是 Bug，修复它。如果是架构问题，重新设计。' },
    { type: 'p', text: '重要的不是永远不犯错，而是保持检查自己系统的能力。' },
    { type: 'quote', text: '一个真正成熟的系统，不是从来没有问题，而是知道什么时候修复，什么时候重构。' }
  ],

