---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SERIES, STATUS_CLASS } from '../../../data/series';
import AdUnit from '../../../components/AdUnit.astro';
import SocialShare from '../../../components/SocialShare.astro';
import AuthorProfileCard from '../../../components/AuthorProfileCard.astro';
import { ARTICLE_BODY_MAP, createFallbackBody, type Block } from '../../../data/series-articles';

export function getStaticPaths() {
  const paths: Array<{
    params: { id: string; no: string };
    props: { series: typeof SERIES[number]; article: typeof SERIES[number]['articles'][number]; index: number; total: number };
  }> = [];
  SERIES.forEach((s) => {
    s.articles.forEach((a, i) => {
      paths.push({
        params: { id: s.id, no: a.no },
        props: { series: s, article: a, index: i, total: s.articles.length }
      });
    });
  });
  return paths;
}

interface Props {
  series: typeof SERIES[number];
  article: typeof SERIES[number]['articles'][number];
  index: number;
  total: number;
}
const { series, article, index, total } = Astro.props;

const stampClass = STATUS_CLASS[series.status] || 'run';
const statusEn = series.status === '连载中' ? 'ONGOING'
  : series.status === '已完结' ? 'COMPLETED'
  : 'IRREGULAR';

// 上一篇 / 下一篇
const prev = index > 0 ? series.articles[index - 1] : null;
const next = index < total - 1 ? series.articles[index + 1] : null;
const otherSeries = SERIES.filter((s) => s.id !== series.id);

const pageTitle = `${article.title} · ${series.title}`;
const pageDesc = `${series.desc} — ${article.title}（发表于 ${article.date}）`;

const siteBase = Astro.site ?? new URL('https://www.wangjianchao.cn');
const canonicalURL = new URL(Astro.url.pathname, siteBase).href;
const pageOGImage = new URL(`/og/series/${series.id}/${article.no}.svg`, siteBase).href;

// 面包屑结构化数据
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "首页", "item": siteBase.href },
    { "@type": "ListItem", "position": 2, "name": series.title, "item": new URL(`/series/${series.id}`, siteBase).href },
    { "@type": "ListItem", "position": 3, "name": article.title, "item": canonicalURL },
  ],
};

// 文章 BlogPosting 结构化数据
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": article.title,
  "description": pageDesc,
  "datePublished": new Date(article.date.replace(/\./g, '-')).toISOString(),
  "author": { "@type": "Person", "name": "语霖", "url": siteBase.href },
  "publisher": { "@type": "Person", "name": "语霖", "url": siteBase.href },
  "image": pageOGImage,
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalURL },
  "articleSection": series.title,
  "inLanguage": "zh-CN",
};

// 文章正文：按 series.id + article.no 查找真实内容，未命中则 fallback 到占位
const articleBody = ARTICLE_BODY_MAP[`${series.id}:${article.no}`] ?? createFallbackBody(series.desc, article.no, article.date);
---

<BaseLayout title={pageTitle} description={pageDesc} ogType="article" ogImage={pageOGImage} bodyClass="dossier dossier-home dossier-article">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>

  <!-- 阅读进度线 -->
  <div id="pb"></div>

  <!-- 页眉 -->
  <header class="topbar-home">
    <div class="wrap bar">
      <a class="brand" href="/" aria-label="返回首页">
        <span class="seal-s">语</span>
        <span class="brand-name">语霖</span>
      </a>
      <nav>
        <a href="/#research">研究</a>
        <a href="/#system">系统</a>
        <a href="/#projects">项目</a>
        <a href="/tools">工具</a>
        <a href="/#about">关于</a>
      </nav>
    </div>
  </header>

  <main>
    <!-- ============ 文章封面 ============ -->
    <section class="article-hero-sec">
      <div class="wrap art-wrap">
        <nav class="breadcrumb-nav-dossier" aria-label="面包屑导航">
          <ol class="breadcrumb-list-dossier">
            <li><a href="/">首页</a></li>
            <li class="sep">/</li>
            <li><a href={`/series/${series.id}`}>{series.title}</a></li>
            <li class="sep">/</li>
            <li class="active" aria-current="page">#{article.no} {article.title}</li>
          </ol>
        </nav>

        <div class="ch-head art-ch-head">
          <span class="ch-no">{series.tab} · NO.{article.no}</span>
          <h1 class="art-h1">{article.title}</h1>
          <span class="ch-en">{statusEn}</span>
          <i class="ch-line"></i>
        </div>

        <div class="art-meta rv">
          <a class="art-series-link" href={`/series/${series.id}`}>{series.title}</a>
          <span class={`r-stamp ${stampClass}`}>{series.status}</span>
          <span class="art-date">{article.date}</span>
          <span class="art-index">NO.{article.no} / {String(total).padStart(3, '0')}</span>
        </div>
      </div>
    </section>

    <!-- ============ 文章正文 ============ -->
    <section id="body">
      <div class="wrap art-wrap">
        <!-- 专栏顶部导览与快速目录大纲 -->
        <div class="series-top-quicknav rv">
          <div class="stq-bar">
            <div class="stq-left">
              {prev ? (
                <a href={`/series/${series.id}/${prev.no}`} class="stq-nav-btn" title={`上一篇: ${prev.title}`}>
                  <span class="stq-arrow">←</span> 上一篇
                </a>
              ) : (
                <span class="stq-nav-btn disabled">已是首篇</span>
              )}
            </div>

            <div class="stq-center">
              <span class="stq-meta">《{series.title}》 第 {article.no} / {String(total).padStart(3, '0')} 篇</span>
              <button id="toc-toggle-btn" class="stq-toc-btn" aria-expanded="false" aria-controls="toc-drawer">
                <span class="stq-toc-icon">☰</span> 专栏大纲 <span class="stq-caret">▾</span>
              </button>
            </div>

            <div class="stq-right">
              {next ? (
                <a href={`/series/${series.id}/${next.no}`} class="stq-nav-btn" title={`下一篇: ${next.title}`}>
                  下一篇 <span class="stq-arrow">→</span>
                </a>
              ) : (
                <span class="stq-nav-btn disabled">已是末篇</span>
              )}
            </div>
          </div>

          <!-- 折叠的专栏目录大纲面板 -->
          <div id="toc-drawer" class="stq-drawer" hidden>
            <div class="stq-drawer-inner">
              <div class="stq-drawer-head">
                <span class="stq-dh-title">【专栏全表】{series.title} ({total} 篇)</span>
                <span class="stq-dh-status">{series.status}</span>
              </div>
              <ol class="stq-drawer-list">
                {series.articles.map((art) => {
                  const isActive = art.no === article.no;
                  return (
                    <li class={`stq-drawer-item ${isActive ? 'is-active' : ''}`}>
                      <a href={`/series/${series.id}/${art.no}`} class="stq-drawer-link">
                        <span class="stq-di-no">NO.{art.no}</span>
                        <span class="stq-di-title">{art.title}</span>
                        <span class="stq-di-date">{art.date}</span>
                        {isActive && <span class="stq-di-tag">当前阅读</span>}
                      </a>
                    </li>
                  );
                })}
              </ol>
            </div>
          </div>
        </div>

        <article class="article-body rv">
            {articleBody.map((block) => {
              if (block.type === 'h2') {
                return (
                  <h2 class="prose-h2">
                    {block.kicker && <span class="prose-kicker">{block.kicker}</span>}
                    <span class="prose-h2-text">{block.text}</span>
                  </h2>
                );
              } else if (block.type === 'h3') {
                return <h3 class="prose-h3">{block.text}</h3>;
              } else if (block.type === 'quote') {
                return <blockquote class="prose-quote">{block.text}</blockquote>;
              } else if (block.type === 'hr') {
                return <hr class="prose-hr" />;
              } else if (block.type === 'list') {
                return (
                  <ul class="prose-list">
                    {block.items.map((it) => <li>{it}</li>)}
                  </ul>
                );
              } else if (block.type === 'callout') {
                return (
                  <aside class="prose-callout">
                    <span class="prose-callout-mark">"</span>
                    <p class="prose-callout-text">{block.text}</p>
                  </aside>
                );
              } else if (block.type === 'code') {
                return (
                  <pre class="prose-code">
                    <span class="prose-code-title">text</span>
                    <code>{block.lines.join('\n')}</code>
                  </pre>
                );
              } else if (block.type === 'flow') {
                const nodes = block.nodes;
                const nodeH = 56;
                const gap = 40;
                const padding = 28;
                const width = 220;
                const height = padding * 2 + nodes.length * nodeH + (nodes.length - 1) * gap;
                const cx = width / 2;
                return (
                  <div class="prose-flow">
                    <svg viewBox={`0 0 ${width} ${height}`} xmlns="http://www.w3.org/2000/svg" role="img" aria-label="单点故障链路图">
                      <rect x="0" y="0" width={width} height={height} fill="var(--paper-3)" />
                      {nodes.map((label, i) => {
                        const y = padding + i * (nodeH + gap);
                        const isLast = i === nodes.length - 1;
                        const isRisk = isLast;
                        return (
                          <g>
                            {/* 节点框 */}
                            <rect
                              x={(width - 160) / 2}
                              y={y}
                              width="160"
                              height={nodeH}
                              rx="2"
                              fill={isRisk ? 'var(--red)' : 'var(--paper)'}
                              stroke="var(--ink)"
                              stroke-width="1.5"
                            />
                            {/* 节点偏移阴影（档案卷宗风） */}
                            <rect
                              x={(width - 160) / 2 + 4}
                              y={y + 4}
                              width="160"
                              height={nodeH}
                              rx="2"
                              fill="none"
                              stroke="var(--ink)"
                              stroke-width="1.5"
                              opacity="0.5"
                            />
                            {/* 节点编号小标签 */}
                            <rect
                              x={(width - 160) / 2 + 10}
                              y={y - 6}
                              width="36"
                              height="14"
                              fill="var(--ink)"
                            />
                            <text
                              x={(width - 160) / 2 + 28}
                              y={y + 4}
                              text-anchor="middle"
                              font-family="IBM Plex Mono, monospace"
                              font-size="9"
                              font-weight="700"
                              letter-spacing="1.5"
                              fill="var(--paper)"
                            >{`0${i + 1}`}</text>
                            {/* 节点文字 */}
                            <text
                              x={cx}
                              y={y + nodeH / 2 + 5}
                              text-anchor="middle"
                              font-family="Noto Serif SC, serif"
                              font-size={label.length > 7 ? 14 : 18}
                              font-weight="900"
                              fill={isRisk ? 'var(--paper)' : 'var(--ink)'}
                            >{label}</text>
                            {/* 连接箭头 */}
                            {!isLast && (
                              <g stroke="var(--ink)" stroke-width="1.5" fill="none">
                                <line
                                  x1={cx}
                                  y1={y + nodeH}
                                  x2={cx}
                                  y2={y + nodeH + gap - 6}
                                  stroke-dasharray="4 4"
                                />
                                <polygon
                                  points={`${cx - 5},${y + nodeH + gap - 6} ${cx + 5},${y + nodeH + gap - 6} ${cx},${y + nodeH + gap}`}
                                  fill="var(--ink)"
                                  stroke="none"
                                />
                              </g>
                            )}
                          </g>
                        );
                      })}
                      {/* 底部危险标签 */}
                      <g>
                        <rect
                          x={(width - 180) / 2}
                          y={height - 22}
                          width="180"
                          height="16"
                          fill="var(--red)"
                        />
                        <text
                          x={cx}
                          y={height - 11}
                          text-anchor="middle"
                          font-family="IBM Plex Mono, monospace"
                          font-size="8"
                          font-weight="700"
                          letter-spacing="1.2"
                          fill="var(--paper)"
                        >SINGLE POINT OF FAILURE</text>
                      </g>
                    </svg>
                  </div>
                );
              } else if (block.type === 'kvlist') {
                return (
                  <div class="prose-kvlist">
                    {block.pairs.map((pair, i) => (
                      <div class="kv-row" style={`--i:${i}`}>
                        <span class="kv-k">{pair.k}</span>
                        <span class="kv-arrow">→</span>
                        <span class="kv-v">{pair.v}</span>
                      </div>
                    ))}
                  </div>
                );
              } else if (block.type === 'architecture') {
                const branches = block.branches;
                const branchW = 150;
                const branchH = 64;
                const gap = 12;
                const padding = 20;
                const width = padding * 2 + branches.length * branchW + (branches.length - 1) * gap;
                const rootW = 100;
                const rootH = 32;
                const bottomH = 32;
                const connectorH = 20;
                const height = padding + rootH + connectorH + branchH + connectorH + bottomH + padding;
                const cx = width / 2;
                const rootY = padding;
                const branchY = rootY + rootH + connectorH;
                const bottomY = branchY + branchH + connectorH;
                return (
                  <div class="prose-arch">
                    <svg viewBox={`0 0 ${width} ${height}`} xmlns="http://www.w3.org/2000/svg" role="img" aria-label="人生系统架构图">
                      {/* 根节点 */}
                      <rect x={(width - rootW) / 2} y={rootY} width={rootW} height={rootH} rx="2" fill="var(--ink)" />
                      <text x={cx} y={rootY + rootH / 2 + 5} text-anchor="middle" font-family="Noto Serif SC, serif" font-size="14" font-weight="900" fill="var(--paper)">{block.root}</text>
                      {/* 根到分支的连接线 */}
                      <line x1={cx} y1={rootY + rootH} x2={cx} y2={rootY + rootH + connectorH / 2} stroke="var(--ink)" stroke-width="1.5" />
                      <line x1={padding + branchW / 2} y1={rootY + rootH + connectorH / 2} x2={width - padding - branchW / 2} y2={rootY + rootH + connectorH / 2} stroke="var(--ink)" stroke-width="1.5" />
                      {/* 每个分支 */}
                      {branches.map((b, i) => {
                        const x = padding + i * (branchW + gap);
                        const isCenter = i === Math.floor(branches.length / 2);
                        return (
                          <g>
                            <line x1={x + branchW / 2} y1={rootY + rootH + connectorH / 2} x2={x + branchW / 2} y2={branchY} stroke="var(--ink)" stroke-width="1.5" stroke-dasharray="3 3" />
                            {/* 分支卡片 */}
                            <rect x={x} y={branchY} width={branchW} height={branchH} rx="2" fill="var(--paper-3)" stroke="var(--ink)" stroke-width="1.5" />
                            <rect x={x} y={branchY} width={branchW} height="4" fill="var(--red)" />
                            <text x={x + branchW / 2} y={branchY + 26} text-anchor="middle" font-family="Noto Serif SC, serif" font-size="14" font-weight="900" fill="var(--ink)">{b.label}</text>
                            <text x={x + branchW / 2} y={branchY + 48} text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="10" fill="var(--text-secondary)">{b.desc}</text>
                            {/* 分支到底部的连接线 */}
                            <line x1={x + branchW / 2} y1={branchY + branchH} x2={x + branchW / 2} y2={bottomY} stroke="var(--ink)" stroke-width="1.5" stroke-dasharray="3 3" />
                          </g>
                        );
                      })}
                      {/* 汇聚线 */}
                      <line x1={padding + branchW / 2} y1={bottomY} x2={width - padding - branchW / 2} y2={bottomY} stroke="var(--ink)" stroke-width="1.5" />
                      <line x1={cx} y1={bottomY} x2={cx} y2={bottomY} stroke="var(--ink)" stroke-width="1.5" />
                      {/* 底部节点 */}
                      <rect x={(width - rootW) / 2} y={bottomY} width={rootW} height={bottomH} rx="2" fill="var(--red)" stroke="var(--ink)" stroke-width="1.5" />
                      <text x={cx} y={bottomY + bottomH / 2 + 5} text-anchor="middle" font-family="Noto Serif SC, serif" font-size="13" font-weight="900" fill="var(--paper)">{block.bottom}</text>
                    </svg>
                  </div>
                );
              } else if (block.type === 'diary') {
                return (
                  <div class="prose-diary">
                    {/* 日记头部：日期 / 天气 / 地点 */}
                    <div class="diary-meta">
                      <div class="diary-meta-row">
                        <span class="dm-k">DATE</span>
                        <span class="dm-v">{block.meta.date}</span>
                      </div>
                      <div class="diary-meta-row">
                        <span class="dm-k">WEATHER</span>
                        <span class="dm-v">{block.meta.weather}</span>
                      </div>
                      <div class="diary-meta-row">
                        <span class="dm-k">PLACE</span>
                        <span class="dm-v">{block.meta.location}</span>
                      </div>
                    </div>
                    {/* 日记各章节 */}
                    {block.sections.map((s, i) => (
                      <div class="diary-section">
                        <div class="diary-sec-head">
                          {s.kicker && <span class="diary-kicker">{s.kicker}</span>}
                          <h4 class="diary-sec-title">{s.title}</h4>
                        </div>
                        <ul class="diary-items">
                          {s.items.map((it, j) => (
                            <li class="diary-item" style={`--i:${j}`}>{it}</li>
                          ))}
                        </ul>
                        {s.footnote && (
                          <div class="diary-footnote">
                            <span class="df-mark">笺</span>
                            <span class="df-text">{s.footnote}</span>
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                );
              } else if (block.type === 'html') {
                return <div class="prose-html-wrapper" set:html={block.html} />;
              }
              return <p class="prose-p">{block.text}</p>;
            })}

            <div class="article-end-rule">
              <span>END · 完</span>
            </div>
        </article>

        <div class="ad-bottom">
          <AdUnit slot="6252683541" format="auto" minHeight="120px" label="文章底部赞助推荐" />
        </div>

        <AuthorProfileCard />

        <SocialShare
          title={pageTitle}
          url={canonicalURL}
          ogImage={pageOGImage}
          description={pageDesc}
          showWechatCopy={false}
        />

        <!-- 专栏全景目录大纲 (Series Outline) -->
        <section class="series-outline-sec rv">
          <div class="so-head">
            <span class="so-stamp">SERIES OUTLINE · 专栏目录大纲</span>
            <h3 class="so-title">《{series.title}》全系列路线图</h3>
            <p class="so-desc">{series.desc}</p>
          </div>
          <div class="so-grid">
            {series.articles.map((art) => {
              const isActive = art.no === article.no;
              return (
                <a
                  href={`/series/${series.id}/${art.no}`}
                  class={`so-card ${isActive ? 'active' : ''}`}
                >
                  <div class="so-card-top">
                    <span class="so-card-no">NO.{art.no}</span>
                    <span class="so-card-date">{art.date}</span>
                  </div>
                  <h4 class="so-card-title">{art.title}</h4>
                  <div class="so-card-foot">
                    {isActive ? (
                      <span class="so-card-badge active">正在阅读中</span>
                    ) : (
                      <span class="so-card-link">阅读本篇 →</span>
                    )}
                  </div>
                </a>
              );
            })}
          </div>
        </section>

        <!-- 推荐其他专栏 -->
        <section class="other-series-sec rv">
          <div class="os-head">
            <span class="os-stamp">RECOMMENDED SERIES · 探索更多专栏</span>
            <h3 class="os-title">其他精选系列卷宗</h3>
          </div>
          <div class="os-grid">
            {otherSeries.map((s) => (
              <a href={`/series/${s.id}`} class="os-card">
                <div class="os-card-badge">{s.tab}</div>
                <h4 class="os-card-title">{s.title}</h4>
                <p class="os-card-desc">{s.desc}</p>
                <div class="os-card-meta">
                  <span>{s.articles.length} 篇连载</span>
                  <span class="os-card-action">浏览专栏 →</span>
                </div>
              </a>
            ))}
          </div>
        </section>

        <!-- 上一篇 / 下一篇 -->
        <nav class="article-nav rv">
          {prev ? (
            <a class="nav-card prev" href={`/series/${series.id}/${prev.no}`}>
              <span class="nav-label">← 上一篇 PREVIOUS</span>
              <span class="nav-title">NO.{prev.no} · {prev.title}</span>
            </a>
          ) : (
            <span class="nav-card placeholder">已是第一篇 · AT BEGINNING</span>
          )}
          {next ? (
            <a class="nav-card next" href={`/series/${series.id}/${next.no}`}>
              <span class="nav-label">下一篇 NEXT →</span>
              <span class="nav-title">NO.{next.no} · {next.title}</span>
            </a>
          ) : (
            <span class="nav-card placeholder">已是最后一篇 · THE END</span>
          )}
        </nav>

        <div class="link-line rv">
          <a href={`/series/${series.id}`}>← 返回专辑目录</a>
        </div>
      </div>
    </section>
  </main>

  <!-- 落款 -->
  <footer class="end-footer">
    <div class="wrap end">
      <div class="seal-square seal-lg" role="img" aria-label="语霖之印">
        <span>语</span><span>霖</span><span>之</span><span>印</span>
      </div>
      <p class="f-motto">执笔为语 · 心落成霖</p>
      <div class="f-meta">
        <span>© 2026 语霖 · WANGJIANCHAO.CN</span>
        <a href="#body">回到正文 ↑</a>
      </div>
    </div>
  </footer>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('toc-toggle-btn');
      const drawer = document.getElementById('toc-drawer');
      if (btn && drawer) {
        btn.addEventListener('click', () => {
          const isHidden = drawer.hasAttribute('hidden');
          if (isHidden) {
            drawer.removeAttribute('hidden');
            btn.setAttribute('aria-expanded', 'true');
            btn.classList.add('is-open');
          } else {
