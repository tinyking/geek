---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SERIES, STATUS_CLASS } from '../../data/series';

export function getStaticPaths() {
  return SERIES.map((s) => ({
    params: { id: s.id },
    props: { series: s }
  }));
}

interface Props { series: typeof SERIES[number] }
const { series } = Astro.props;

const stampClass = STATUS_CLASS[series.status] || 'run';
const statusEn = series.status === '连载中' ? 'ONGOING'
  : series.status === '已完结' ? 'COMPLETED'
  : 'IRREGULAR';

// 顶部日期（北京时间）
const fmt = new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai',
  year: 'numeric', month: '2-digit', day: '2-digit',
  weekday: 'short'
});
const parts = fmt.formatToParts(new Date());
const get = (t: string) => parts.find(p => p.type === t)?.value ?? '';
const today = `${get('year')}.${get('month')}.${get('day')} · ${get('weekday')}`;

const pageTitle = `${series.title} · 文章专辑`;
const pageDesc = series.desc;
---

<BaseLayout title={pageTitle} description={pageDesc} bodyClass="dossier dossier-series">
  <div class="grid-bg"></div>
  <div class="noise"></div>
  <div class="wm"><span class="a">又</span><span class="b">见</span></div>

  <div class="app">

    <!-- TOPBAR -->
    <header class="topbar">
      <div class="topbar-in">
        <a class="logo" href="/" aria-label="返回首页">朝</a>
        <div class="brand">
          <b>观禾</b>
          <small>浮生观禾，静心成长</small>
        </div>
        <div class="topbar-right">
          <span class="meta"><span class="dot"></span>ONLINE</span>
          <span class="meta">{series.tab}</span>
          <span class="meta" id="today">{today}</span>
        </div>
      </div>
    </header>

    <main>
      <!-- SERIES HEAD -->
      <section class="series-cover" id="cover">
        <div class="container">
          <a class="back-link" href="/" aria-label="返回首页">
            <span class="arrow">←</span>
            <span>返回首页 RETURN HOME</span>
          </a>

          <div class="series-hero reveal">
            <div class="sec-num">04</div>
            <div class="series-meta-row">
              <span class="series-tab">{series.tab}</span>
              <span class="series-status"><b class={`stamp-dot ${stampClass}`}>●</b>{series.status} · {statusEn}</span>
              <span class="series-count">共 {series.articles.length} 篇</span>
            </div>
            <h1 class="series-title">{series.title}</h1>
            <p class="series-desc">{series.desc}</p>

            <div class="series-stamp-pad">
              <div class={`series-stamp ${stampClass}`}>
                <span class="series-stamp-cn">{series.status}</span>
                <span class="series-stamp-en">{statusEn}</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ARTICLES FOLDER -->
      <section id="articles">
        <div class="container">
          <div class="sec-head reveal">
            <div class="sec-num">·</div>
            <div class="sec-title">
              <h2>文章目录</h2>
              <small>ARTICLE INDEX</small>
            </div>
            <div class="sec-rule"></div>
            <div class="sec-sq"></div>
          </div>

          <div class="folder articles-folder reveal">
            <div class="folder-tab">{series.tab} · INDEX</div>
            <span class={`stamp ${stampClass}`}>{series.status}</span>
            <div class="pid">{series.tab.replace('SERIES ', 'SERIES-')}</div>
            <h3>{series.title}</h3>
            <div class="ptags">{series.articles.length} ENTRIES · {statusEn}</div>

            <div class="folder-details">
              <div class="inner">
                <div class="articles-list">
                  {series.articles.map((a) => (
                    <a class="article-row" href={`/series/${series.id}/${a.no}`}>
                      <span class="article-no">NO.{a.no}</span>
                      <span class="article-date">{a.date}</span>
                      <span class="article-title">{a.title}</span>
                      <span class="article-go">阅读 →</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <div class="series-foot reveal">
            <a class="btn btn-red" href="/" rel="noopener">← 返回首页</a>
          </div>
        </div>
      </section>
    </main>

    <!-- FOOT -->
    <footer class="foot">
      <div class="container">
        <div class="foot-row">
          <span class="foot-logo">观禾 · GUAN HE</span>
          <span class="foot-meta">© {new Date().getFullYear()} · 浮生观禾，静心成长</span>
        </div>
      </div>
    </footer>

  </div>
</BaseLayout>

<style is:global>
/* ============ SERIES DETAIL PAGE ============ */
body.dossier-series {
  background: var(--paper);
}

/* 背景层：网格 / 噪点 / 水印 */
.dossier-series .grid-bg,
.dossier-series .noise,
.dossier-series .wm {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}
.dossier-series .grid-bg {
  background-image:
    linear-gradient(rgba(27,39,56,.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(27,39,56,.04) 1px, transparent 1px);
  background-size: 28px 28px;
}
.dossier-series .noise {
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='180' height='180' filter='url(%23n)'/></svg>");
  opacity: .06;
  mix-blend-mode: multiply;
}
.dossier-series .wm { overflow: hidden; }
.dossier-series .wm span {
  position: absolute;
  font-family: 'Noto Serif SC', serif;
  font-weight: 900;
  font-size: 46vw;
  color: transparent;
  -webkit-text-stroke: 1.5px rgba(27,39,56,.06);
  user-select: none;
  line-height: .8;
}
.dossier-series .wm .a { top: -12%; left: -7%; animation: drift 14s ease-in-out infinite alternate; }
.dossier-series .wm .b { bottom: -22%; right: -9%; animation: drift 17s ease-in-out infinite alternate-reverse; }
@keyframes drift {
  from { transform: translate(0, 0); }
  to   { transform: translate(20px, -16px); }
}

.dossier-series .app {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
}

.dossier-series .topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  background: var(--paper);
  border-bottom: 1.5px solid var(--ink);
}
.dossier-series .topbar-in {
  width: min(1240px, 94vw);
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 11px 0;
}
.dossier-series .logo {
  width: 38px;
  height: 38px;
  background: var(--red);
  color: var(--paper);
  display: grid;
  place-items: center;
  font-family: 'Ma Shan Zheng', serif;
  font-size: 24px;
  box-shadow: var(--hard);
  flex: none;
  text-decoration: none;
  cursor: pointer;
}
.dossier-series .brand {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}
.dossier-series .brand b {
  font-family: 'Noto Serif SC', serif;
  font-weight: 700;
  font-size: 15px;
  letter-spacing: .04em;
}
.dossier-series .brand small {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 9.5px;
  letter-spacing: .22em;
  color: var(--ink-soft);
  text-transform: uppercase;
  padding-top: 4px;
}
.dossier-series .topbar-right {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 14px;
}
.dossier-series .meta {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10.5px;
  letter-spacing: .12em;
  color: var(--ink-soft);
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 8px;
}
.dossier-series .meta .dot {
  width: 7px;
  height: 7px;
  background: var(--red);
  border-radius: 50%;
  display: inline-block;
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: .35; }
}

.dossier-series main {
  flex: 1;
  padding: 0 0 80px;
}

.dossier-series .container {
  max-width: 880px;
  margin: 0 auto;
  padding: 0 28px;
}

/* back link */
.back-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin: 36px 0 28px;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 11px;
  letter-spacing: .14em;
  color: var(--red-deep);
  text-decoration: none;
  text-transform: uppercase;
  transition: transform .25s ease, color .25s ease;
}
.back-link .arrow {
  display: inline-block;
  transition: transform .25s ease;
}
.back-link:hover { color: var(--red); }
.back-link:hover .arrow { transform: translateX(-4px); }

/* series cover hero */
.series-cover { padding-top: 8px; }

.series-hero {
  position: relative;
  padding: 36px 0 48px;
  border-bottom: 1.5px dashed var(--ink);
}

.series-hero .sec-num {
  position: absolute;
  top: 24px;
  right: 0;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 110px;
  font-weight: 600;
  color: var(--ink);
  opacity: .08;
  line-height: 1;
  letter-spacing: -.04em;
}

.series-meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16px;
  margin-bottom: 18px;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 11px;
  letter-spacing: .12em;
  color: var(--text-secondary);
}

.series-tab {
  color: var(--paper);
  background: var(--ink);
  padding: 4px 12px;
  border-radius: 1px;
  letter-spacing: .18em;
}

.series-status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  text-transform: uppercase;
}

.stamp-dot {
  font-size: 8px;
  font-weight: 600;
}
.stamp-dot.ok { color: var(--red); }
.stamp-dot.run { color: var(--blue); }
.stamp-dot.maint { color: var(--ink); }

.series-count { letter-spacing: .14em; }

.series-title {
  font-family: 'Noto Serif SC', serif;
  font-weight: 900;
  font-size: clamp(40px, 6vw, 64px);
  line-height: 1.1;
  margin: 12px 0 20px;
  color: var(--ink);
  letter-spacing: -.01em;
}

.series-desc {
  max-width: 680px;
  font-family: 'Noto Serif SC', serif;
  font-size: 16px;
  line-height: 1.85;
  color: #3a3320;
  margin: 0;
}

/* stamp pad (decorative seal) */
.series-stamp-pad {
  position: absolute;
  top: 28px;
  right: 0;
  display: flex;
  justify-content: flex-end;
}
.series-stamp {
  width: 110px;
  height: 110px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  border: 3px double currentColor;
  border-radius: 50%;
  font-family: 'Ma Shan Zheng', 'Noto Serif SC', serif;
  font-size: 18px;
  font-weight: 700;
  transform: rotate(-8deg);
  opacity: .85;
}
.series-stamp .series-stamp-en {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 9px;
  letter-spacing: .14em;
  font-weight: 600;
}
.series-stamp.ok { color: var(--red); }
.series-stamp.run { color: var(--blue); }
.series-stamp.maint { color: var(--ink); }

/* section head */
.dossier-series .sec-head {
  display: flex;
  align-items: center;
  gap: 18px;
  margin: 56px 0 28px;
}
.dossier-series .sec-num {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 14px;
  font-weight: 600;
  color: var(--paper);
  background: var(--ink);
  padding: 6px 12px;
  border-radius: 1px;
  letter-spacing: .14em;
}
.dossier-series .sec-title h2 {
  font-family: 'Noto Serif SC', serif;
  font-weight: 900;
  font-size: 26px;
  color: var(--ink);
  margin: 0;
}
.dossier-series .sec-title small {
  display: block;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10px;
  letter-spacing: .18em;
  color: var(--text-secondary);
  margin-top: 2px;
}
.dossier-series .sec-rule {
  flex: 1;
  height: 1.5px;
  background: repeating-linear-gradient(90deg, var(--ink) 0 4px, transparent 4px 8px);
  opacity: .3;
}
.dossier-series .sec-sq {
  width: 10px;
  height: 10px;
  background: var(--ink);
}

/* articles folder — 复用档案首页 folder 卡片样式 */
.dossier-series .folder {
  position: relative;
  background: var(--manila);
  border: 2px solid var(--ink);
  box-shadow: 6px 6px 0 var(--ink);
  padding: 34px 22px 22px;
  transition: transform .3s cubic-bezier(.22,1,.36,1), box-shadow .3s cubic-bezier(.22,1,.36,1);
}
.dossier-series .folder.reveal:hover {
  transform: translateY(-6px) rotate(-.4deg);
  box-shadow: 10px 10px 0 var(--ink);
}
.dossier-series .folder-tab {
  position: absolute;
  top: -15px;
  left: 18px;
  background: var(--manila-d);
  border: 2px solid var(--ink);
  border-bottom: 0;
  border-radius: 7px 7px 0 0;
  padding: 3px 16px;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10px;
  letter-spacing: .12em;
  color: var(--ink);
}
.dossier-series .folder .pid {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 11px;
  letter-spacing: .14em;
  color: var(--red-deep);
}
.dossier-series .folder h3 {
  font-family: 'Noto Serif SC', serif;
  font-weight: 900;
  font-size: 24px;
  margin: 6px 0 4px;
  color: var(--ink);
}
.dossier-series .folder .ptags {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10.5px;
  color: var(--ink-soft);
  letter-spacing: .04em;
}
.dossier-series .folder .stamp {
  position: absolute;
  top: 14px;
  right: 14px;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10px;
  letter-spacing: .1em;
  text-transform: uppercase;
  border: 2.5px double currentColor;
  padding: 4px 8px;
  transform: rotate(7deg);
}
.dossier-series .folder .stamp.ok   { color: var(--red); }
.dossier-series .folder .stamp.run  { color: var(--blue); }
.dossier-series .folder .stamp.maint{ color: var(--ink); }
.dossier-series .folder-details {
  max-height: none;
  overflow: visible;
}
.dossier-series .folder-details .inner {
  border-top: 1.5px dashed var(--ink);
  margin-top: 16px;
  padding-top: 14px;
  font-size: 13.5px;
  color: #3a3320;
}

.articles-folder { margin-top: 8px; }

.articles-list {
  display: flex;
  flex-direction: column;
}

.article-row {
  display: flex;
  align-items: baseline;
  gap: 16px;
  padding: 16px 4px;
  border-bottom: 1.5px dashed var(--border);
  text-decoration: none;
  color: var(--ink);
  transition: padding-left .25s ease, background .25s ease;
}
.article-row:last-child { border-bottom: none; }
.article-row:hover {
  padding-left: 12px;
  background: rgba(229, 112, 53, .04);
}

.article-no {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 11px;
  letter-spacing: .14em;
  color: var(--red-deep);
  min-width: 56px;
  flex-shrink: 0;
}

.article-date {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 12px;
  color: var(--text-secondary);
  letter-spacing: .04em;
  min-width: 90px;
  flex-shrink: 0;
}

.article-title {
  flex: 1;
  font-family: 'Noto Serif SC', serif;
  font-weight: 700;
  font-size: 16px;
  line-height: 1.5;
  color: var(--ink);
}

.article-go {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 11px;
  letter-spacing: .12em;
  color: var(--red-deep);
  opacity: 0;
  transform: translateX(-6px);
  transition: opacity .25s ease, transform .25s ease;
  flex-shrink: 0;
}
.article-row:hover .article-go {
  opacity: 1;
  transform: translateX(0);
}

/* foot button */
.series-foot {
  text-align: center;
  margin-top: 48px;
}
.dossier-series .btn {
  display: inline-block;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 12px;
  letter-spacing: .14em;
  padding: 12px 28px;
  text-decoration: none;
  text-transform: uppercase;
  transition: transform .25s ease, box-shadow .25s ease;
  cursor: pointer;
  border-radius: 1px;
}
.dossier-series .btn-red {
  background: var(--red);
  color: var(--paper);
  border: 1.5px solid var(--ink);
  box-shadow: 4px 4px 0 var(--ink);
}
.dossier-series .btn-red:hover {
  transform: translate(-2px, -2px);
  box-shadow: 6px 6px 0 var(--ink);
}

/* footer */
.dossier-series .foot {
  border-top: 1.5px solid var(--ink);
  background: var(--paper-2);
  padding: 22px 0;
  margin-top: auto;
}
.foot-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10px;
  letter-spacing: .14em;
  color: var(--text-secondary);
}
.foot-logo {
  font-family: 'Noto Serif SC', serif;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: .04em;
  font-size: 12px;
}

/* reveal animation */
.reveal {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity .7s cubic-bezier(.22,1,.36,1), transform .7s cubic-bezier(.22,1,.36,1);
}
.reveal.in {
  opacity: 1;
  transform: none;
}

/* responsive */
@media (max-width: 720px) {
  .dossier-series .container { padding: 0 20px; }
  .series-hero { padding: 24px 0 36px; }
  .series-title { font-size: 36px; }
  .series-desc { font-size: 15px; }
  .series-hero .sec-num { font-size: 72px; }
  .series-stamp-pad { display: none; }

  .article-row {
    flex-wrap: wrap;
    gap: 8px;
    padding: 14px 4px;
  }
  .article-no { min-width: 0; }
  .article-date { min-width: 0; }
  .article-title { width: 100%; font-size: 15px; }
  .article-go { opacity: 1; transform: none; }

  .foot-row { justify-content: center; text-align: center; }
}

@media (prefers-reduced-motion: reduce) {
  .reveal { opacity: 1 !important; transform: none !important; }
}
</style>

<script>
  // reveal on scroll
  (function() {
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(en) {
        if (en.isIntersecting) {
          en.target.classList.add('in');
          io.unobserve(en.target);
        }
      });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach(function(el) { io.observe(el); });
  })();
</script>
