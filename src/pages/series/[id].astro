---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SERIES, STATUS_CLASS } from '../../data/series';

export async function getStaticPaths() {
  return SERIES.map((s) => ({
    params: { id: s.id },
    props: { series: s }
  }));
}

interface Props { series: typeof SERIES[number] }
const { series } = Astro.props;

const stampClass = STATUS_CLASS[series.status] || 'run';
const STATUS_EN: Record<string, string> = {
  '连载中': 'ONGOING',
  '已完结': 'COMPLETED',
  '不定期更新': 'IRREGULAR'
};
const statusEn = STATUS_EN[series.status] || 'ONGOING';

// 系列在首页的位置编号（按 SERIES 数组顺序）
const seriesIndex = SERIES.findIndex((s) => s.id === series.id) + 1;

// 从 Content Collections 获取本系列文章列表
const allArticles = await getCollection('seriesArticles');
const articles = allArticles
  .filter((a) => a.data.series === series.id)
  .map((a) => ({
    no: a.data.no,
    date: a.data.date,
    title: a.data.title,
  }))
  .sort((a, b) => a.no.localeCompare(b.no));

const latest = articles[articles.length - 1];

const pageTitle = `${series.title} · 文章专辑`;
const pageDesc = series.desc;

const siteBase = Astro.site ?? new URL('https://www.wangjianchao.cn');
const canonicalURL = new URL(Astro.url.pathname, siteBase).href;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "首页", "item": siteBase.href },
    { "@type": "ListItem", "position": 2, "name": series.title, "item": canonicalURL },
  ],
};

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": series.title,
  "description": series.desc,
  "url": canonicalURL,
  "inLanguage": "zh-CN",
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": articles.length,
    "itemListElement": articles.map((art, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": art.title,
      "url": new URL(`/series/${series.id}/${art.no}`, siteBase).href,
    })),
  },
};
---

<BaseLayout title={pageTitle} description={pageDesc} bodyClass="dossier dossier-home dossier-series">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  </Fragment>

  <!-- 阅读进度线 -->
  <div id="pb"></div>

  <!-- 页眉 -->
  <header class="topbar-home">
    <div class="wrap bar">
      <a class="brand" href="/" aria-label="返回首页">
        <span class="seal-s">语</span>
        <span class="brand-name">语霖</span>
      </a>
      <nav>
        <a href="/#research">研究</a>
        <a href="/#system">系统</a>
        <a href="/#projects">项目</a>
        <a href="/tools">工具</a>
        <a href="/#about">关于</a>
      </nav>
    </div>
  </header>

  <main>
    <!-- ============ 系列封面 ============ -->
    <section class="series-hero-sec">
      <div class="wrap">
        <nav class="breadcrumb-nav-dossier" aria-label="面包屑导航">
          <ol class="breadcrumb-list-dossier">
            <li><a href="/">首页</a></li>
            <li class="sep">/</li>
            <li class="active" aria-current="page">专辑: {series.title}</li>
          </ol>
        </nav>

        <div class="ch-head series-ch-head">
          <span class="ch-no">{series.tab}</span>
          <h1 class="series-h1">{series.title}</h1>
          <span class="ch-en">{statusEn}</span>
          <i class="ch-line"></i>
        </div>

        <div class="series-hero-grid rv">
          <div class="series-left">
            <p class="series-desc">{series.desc}</p>
            <div class="series-meta">
              <span class="m-stat">
                <b>{articles.length}</b><small>篇</small>
              </span>
              <span class={`r-stamp ${stampClass}`}>{series.status}</span>
              <span class="m-latest">
                <i>最新</i>
                <b>#{latest.no}</b>
                <em>{latest.date}</em>
              </span>
            </div>
          </div>
          <div class="series-right">
            <div class="seal-square seal-lg" role="img" aria-label={`${series.title}之印`}>
              <span>{series.title.slice(0,1)}</span>
              <span>{series.title.slice(1,2) || '·'}</span>
              <span>之</span>
              <span>印</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 文章目录 ============ -->
    <section id="articles">
      <div class="wrap">
        <div class="ch-head">
          <span class="ch-no">·</span>
          <h2>文章目录</h2>
          <span class="ch-en">INDEX · {articles.length} ENTRIES</span>
          <i class="ch-line"></i>
        </div>

        <div class="articles-list rv">
          {articles.map((a) => (
            <a class="art-row" href={`/series/${series.id}/${a.no}`}>
              <span class="a-no">NO.{a.no}</span>
              <span class="a-date">{a.date}</span>
              <span class="a-title">{a.title}</span>
              <span class="a-go">阅读 →</span>
            </a>
          ))}
        </div>

        <div class="link-line rv">
          <a href="/#research">← 返回所有专栏</a>
        </div>
      </div>
    </section>
  </main>

  <!-- 落款 -->
  <footer class="end-footer">
    <div class="wrap end">
      <div class="seal-square seal-lg" role="img" aria-label="语霖之印">
        <span>语</span><span>霖</span><span>之</span><span>印</span>
      </div>
      <p class="f-motto">执笔为语 · 心落成霖</p>
      <div class="f-meta">
        <span>© 2026 语霖 · WANGJIANCHAO.CN</span>
        <a href="#articles">回到目录 ↑</a>
      </div>
    </div>
  </footer>
</BaseLayout>

<style is:global>
/* ============ SERIES DETAIL PAGE — Life OS 风格 ============ */
body.dossier-series .breadcrumb-nav-dossier {
  margin: 28px 0 0;
  font-family: var(--los-mono);
  font-size: 12px;
  letter-spacing: .12em;
}
body.dossier-series .breadcrumb-list-dossier {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  list-style: none;
  padding: 0;
  margin: 0;
  color: var(--los-ink2);
}
body.dossier-series .breadcrumb-list-dossier a {
  color: var(--los-ink);
  text-decoration: none;
  transition: color .25s;
}
body.dossier-series .breadcrumb-list-dossier a:hover {
  color: var(--los-seal);
  text-decoration: underline;
}
body.dossier-series .breadcrumb-list-dossier .sep {
  color: var(--los-line);
}
body.dossier-series .breadcrumb-list-dossier .active {
  color: var(--los-seal);
  font-weight: 700;
}

body.dossier-series {
  font-family: var(--los-serif);
  background: var(--los-paper);
  color: var(--los-ink);
  line-height: 1.9;
}
body.dossier-series ::selection { background: var(--los-seal); color: var(--los-paper); }
body.dossier-series main { display: block; }
body.dossier-series section { scroll-margin-top: 90px; }

/* 返回链接 */
body.dossier-series .back-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin: 28px 0 0;
  font-family: var(--los-mono);
  font-size: 11px;
  letter-spacing: .18em;
  color: var(--los-ink2);
  text-decoration: none;
  text-transform: uppercase;
  transition: color .25s;
}
body.dossier-series .back-link .arrow {
  display: inline-block;
  transition: transform .25s;
}
body.dossier-series .back-link:hover { color: var(--los-seal); }
body.dossier-series .back-link:hover .arrow { transform: translateX(-4px); }

/* 系列封面 hero */
body.dossier-series .series-hero-sec {
  padding: 24px 0 56px;
  border-bottom: 1px solid var(--los-line);
}
body.dossier-series .series-ch-head { margin: 40px 0 36px; }
body.dossier-series .series-h1 {
  font-family: var(--los-serif);
  font-size: clamp(34px, 5vw, 54px);
  font-weight: 900;
  letter-spacing: .02em;
  color: var(--los-ink);
  margin: 0;
}

/* 系列封面：左信息 + 右印章 */
body.dossier-series .series-hero-grid {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 48px;
  align-items: center;
}
body.dossier-series .series-left { min-width: 0; }
body.dossier-series .series-desc {
  font-family: var(--los-serif);
  font-size: 17px;
  line-height: 1.95;
  color: var(--los-ink);
  max-width: 620px;
  margin: 0 0 28px;
}
body.dossier-series .series-meta {
  display: flex;
  align-items: baseline;
  gap: 24px;
  flex-wrap: wrap;
}
body.dossier-series .m-stat {
  font-family: var(--los-mono);
  font-size: 32px;
  color: var(--los-ink);
  font-weight: 500;
  display: inline-flex;
  align-items: baseline;
  gap: 4px;
}
body.dossier-series .m-stat small {
  font-size: 12px;
  color: var(--los-ink2);
  letter-spacing: .12em;
}
/* 复用首页 .r-stamp 样式（border + currentColor） */
body.dossier-series .series-right { display: flex; justify-content: flex-end; }
body.dossier-series .m-latest {
  display: inline-flex;
  align-items: baseline;
  gap: 10px;
  font-family: var(--los-mono);
  font-size: 12px;
  color: var(--los-ink2);
}
body.dossier-series .m-latest i {
  font-style: normal;
  letter-spacing: .2em;
}
body.dossier-series .m-latest b {
  color: var(--los-seal);
  font-weight: 500;
}
body.dossier-series .m-latest em {
  font-style: normal;
  letter-spacing: .1em;
}

/* ============ 文章目录 ============ */
body.dossier-series #articles {
  padding: 96px 0 40px;
}
body.dossier-series .articles-list {
  display: flex;
  flex-direction: column;
}
body.dossier-series .art-row {
  display: grid;
  grid-template-columns: 80px 110px 1fr auto;
  gap: 24px;
  align-items: baseline;
  padding: 28px 0;
  border-top: 1px solid var(--los-line);
  text-decoration: none;
  color: inherit;
  transition: padding-left .3s;
}
body.dossier-series .art-row:last-child {
  border-bottom: 1px solid var(--los-line);
}
body.dossier-series .art-row:hover { padding-left: 14px; }
body.dossier-series .a-no {
  font-family: var(--los-mono);
  font-size: 12px;
  letter-spacing: .15em;
  color: var(--los-seal);
}
body.dossier-series .a-date {
  font-family: var(--los-mono);
  font-size: 12px;
  letter-spacing: .06em;
  color: var(--los-ink2);
}
body.dossier-series .a-title {
  font-family: var(--los-serif);
  font-size: 17px;
  font-weight: 700;
  line-height: 1.5;
  color: var(--los-ink);
  transition: color .25s;
}
body.dossier-series .art-row:hover .a-title { color: var(--los-seal); }
body.dossier-series .a-go {
  font-family: var(--los-mono);
  font-size: 11px;
  letter-spacing: .15em;
  color: var(--los-seal);
  opacity: 0;
  transform: translateX(-6px);
  transition: opacity .25s, transform .25s;
}
body.dossier-series .art-row:hover .a-go {
  opacity: 1;
  transform: translateX(0);
}

/* 链接行 */
body.dossier-series .link-line {
  margin-top: 48px;
  text-align: center;
}
body.dossier-series .link-line a {
  font-family: var(--los-mono);
  font-size: 12px;
  letter-spacing: .18em;
  color: var(--los-ink2);
  text-decoration: none;
  transition: color .25s;
}
body.dossier-series .link-line a:hover { color: var(--los-seal); }

/* 响应式 */
@media (max-width: 760px) {
  body.dossier-series .series-hero-grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }
  body.dossier-series .series-right { justify-content: flex-start; }
  body.dossier-series .series-h1 { font-size: 32px; }
  body.dossier-series .series-desc { font-size: 15px; }
  body.dossier-series .art-row {
    grid-template-columns: 1fr auto;
    gap: 6px 16px;
    padding: 22px 0;
  }
  body.dossier-series .a-no { grid-column: 1; }
  body.dossier-series .a-date { grid-column: 1; }
  body.dossier-series .a-title {
    grid-column: 1 / -1;
    font-size: 15px;
  }
  body.dossier-series .a-go {
    grid-column: 2;
    grid-row: 1;
    opacity: 1;
    transform: none;
  }
}
</style>

<script>
  // 阅读进度线
  (function() {
    var pb = document.getElementById('pb');
    if (!pb) return;
    function onScroll() {
      var h = document.documentElement;
      var max = h.scrollHeight - h.clientHeight;
      var p = max > 0 ? (h.scrollTop / max) * 100 : 0;
      pb.style.width = p + '%';
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();

  // 显现动画
  (function() {
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(en) {
        if (en.isIntersecting) {
          en.target.classList.add('in');
          io.unobserve(en.target);
        }
      });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
    document.querySelectorAll('.rv').forEach(function(el) { io.observe(el); });
  })();
</script>
