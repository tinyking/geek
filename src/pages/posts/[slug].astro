---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const pageTitle = `${post.data.title} | 观禾·浮生观禾，静心成长`;
const pageDescription = post.data.description ?? post.data.excerpt;
const pageOGImage = post.data.ogImage
  ? new URL(post.data.ogImage, Astro.site ?? new URL('https://www.wangjianchao.cn')).href
  : undefined;
const canonicalURL = post.data.canonicalURL
  ?? new URL(Astro.url.pathname, Astro.site ?? new URL('https://www.wangjianchao.cn')).href;

// 文章 BlogPosting 结构化数据
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": pageDescription,
  "datePublished": post.data.date.toISOString(),
  "dateModified": (post.data.updatedDate ?? post.data.date).toISOString(),
  "author": { "@type": "Person", "name": post.data.author },
  "image": pageOGImage ?? new URL('/images/og-default.png', Astro.site ?? new URL('https://www.wangjianchao.cn')).href,
  "publisher": { "@type": "Person", "name": "语霖" },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalURL },
  "keywords": post.data.tags.join(', '),
};

const postNo = `POS-${String(post.slug).slice(0, 6).toUpperCase()}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogType="article"
  ogImage={pageOGImage}
  bodyClass="dossier"
>
  <div class="grid-bg"></div>
  <div class="noise"></div>
  <div class="wm"><span class="a">又</span><span class="b">见</span></div>

  <header class="topbar">
    <div class="topbar-in">
      <div class="logo">朝</div>
      <div class="brand">
        <b>观禾</b>
        <small>浮生观禾，静心成长</small>
      </div>
      <div class="topbar-right">
        <span class="meta"><span class="dot"></span>在册</span>
        <span class="meta">NO. {postNo}</span>
        <span class="meta" id="today">——</span>
      </div>
    </div>
  </header>

  <main class="dossier-main">
    <div class="container">
      <a class="back-link" href="/posts">← 返回文章列表</a>

      <article class="article">
        <header class="article-head">
          <div class="stamp">ARTICLE · 档案</div>
          <div class="article-meta">
            <time>{post.data.date.toLocaleDateString('zh-CN')}</time>
            <span class="sep">·</span>
            <span>{post.data.readingTime} 分钟阅读</span>
            <span class="sep">·</span>
            <span class="no">{postNo}</span>
          </div>
          <h1 class="article-title">{post.data.title}</h1>
          <div class="rule"></div>
          {post.data.tags.length > 0 && (
            <div class="article-tags">
              {post.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
        </header>

        <div class="prose">
          <Content />
        </div>

        <footer class="article-foot">
          <div class="article-foot-in">
            <button id="copy-wechat" class="btn btn-red" title="复制到公众号" aria-label="复制文章内容到微信公众号格式">
              复制到公众号
            </button>
            <button id="share-x" class="btn btn-ghost" title="分享到 X" aria-label="分享到 X">
              分享到 X
            </button>
            <button id="share-weibo" class="btn btn-ghost" title="分享到微博" aria-label="分享到微博">
              分享到微博
            </button>
          </div>
          <div class="article-foot-back">
            <a class="btn btn-red" href="/">← 返回首页</a>
            <a class="btn btn-ghost" href="/posts">返回文章列表</a>
          </div>
        </footer>
      </article>
    </div>
  </main>

  <style is:global>
    /* === dossier 主题 token（与 404.astro 一致） === */
    body.dossier {
      --paper: #f0e4cd;
      --paper-2: #e6dcc4;
      --paper-3: #fbfaf4;
      --ink: #171310;
      --ink-2: #2c241c;
      --red: #c13a2b;
      --red-deep: #8b2a1f;
      --manila: #d9a441;
      --manila-d: #b8862e;
      --border: #c9bea3;
      --text-primary: #1a1a1a;
      --text-secondary: #6b6b6b;
      background: var(--paper);
      color: var(--text-primary);
      font-family: 'Noto Serif SC', serif;
    }

    /* 背景三层 */
    .grid-bg {
      background-image:
        linear-gradient(to right, rgba(27,19,16,.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(27,19,16,.04) 1px, transparent 1px);
      background-size: 48px 48px;
    }
    .noise {
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='180' height='180' filter='url(%23n)'/></svg>");
      opacity: .06;
      mix-blend-mode: multiply;
    }
    .grid-bg, .noise, .wm { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
    .wm { overflow: hidden; }
    .wm span {
      position: absolute;
      font-family: 'Noto Serif SC', serif;
      font-weight: 900;
      font-size: 46vw;
      color: transparent;
      -webkit-text-stroke: 1.5px rgba(27,19,16,.06);
      user-select: none;
      line-height: .8;
    }
    .wm .a { top: -12%; left: -7%; }
    .wm .b { bottom: -22%; right: -9%; }

    /* topbar */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 40;
      background: var(--paper);
      border-bottom: 2px solid var(--ink);
    }
    .topbar-in {
      width: min(1240px, 94vw);
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 11px 0;
    }
    .logo {
      width: 38px;
      height: 38px;
      background: var(--red);
      color: var(--paper);
      display: grid;
      place-items: center;
      font-family: 'Ma Shan Zheng', serif;
      font-size: 24px;
      box-shadow: 3px 3px 0 var(--ink);
      flex: none;
    }
    .brand {
      display: flex;
      flex-direction: column;
      line-height: 1.1;
    }
    .brand b {
      font-family: 'Noto Serif SC', serif;
      font-weight: 700;
      font-size: 15px;
      letter-spacing: .04em;
    }
    .brand small {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 9.5px;
      letter-spacing: .22em;
      color: var(--text-secondary);
      text-transform: uppercase;
      padding-top: 4px;
    }
    .topbar-right {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .meta {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10.5px;
      letter-spacing: .12em;
      color: var(--text-secondary);
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--red);
      box-shadow: 0 0 0 0 rgba(197,61,35,.6);
      animation: pulse 2.2s infinite;
    }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(197,61,35,.55); }
      70% { box-shadow: 0 0 0 8px rgba(197,61,35,0); }
      100% { box-shadow: 0 0 0 0 rgba(197,61,35,0); }
    }

    /* main */
    .dossier-main {
      position: relative;
      z-index: 1;
      padding: 56px 24px 100px;
    }
    .container {
      width: min(820px, 94vw);
      margin: 0 auto;
    }

    /* 返回链接 */
    .back-link {
      display: inline-flex;
      align-items: center;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      letter-spacing: .15em;
      text-transform: uppercase;
      color: var(--text-secondary);
      text-decoration: none;
      padding: 8px 14px;
      border: 1px solid var(--border);
      background: var(--paper-2);
      transition: all .2s;
      margin-bottom: 32px;
    }
    .back-link:hover {
      color: var(--paper);
      background: var(--ink);
      border-color: var(--ink);
    }

    /* 文章卷宗 */
    .article {
      background: var(--paper-3);
      border: 1.5px solid var(--ink);
      box-shadow: 8px 8px 0 var(--ink);
      padding: 48px 56px 40px;
      position: relative;
    }
    .article::before {
      content: '';
      position: absolute;
      top: -1.5px;
      left: 32px;
      width: 120px;
      height: 4px;
      background: var(--red);
    }

    .stamp {
      display: inline-block;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      letter-spacing: 3px;
      padding: 5px 12px;
      background: var(--ink);
      color: var(--paper);
      border-radius: 2px;
      margin-bottom: 20px;
      transform: rotate(-1deg);
    }

    .article-meta {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      letter-spacing: .1em;
      color: var(--text-secondary);
      text-transform: uppercase;
      margin-bottom: 18px;
    }
    .article-meta .sep { color: var(--border); }
    .article-meta .no { color: var(--manila-d); }

    .article-title {
      font-family: 'Noto Serif SC', serif;
      font-weight: 900;
      font-size: clamp(26px, 4vw, 36px);
      letter-spacing: 1px;
      color: var(--ink);
      line-height: 1.4;
      margin-bottom: 16px;
    }
    .rule {
      width: 60px;
      height: 3px;
      background: var(--red);
      margin-bottom: 18px;
    }
    .article-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 36px;
    }
    .tag {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      letter-spacing: .1em;
      color: var(--ink-2);
      background: var(--paper-2);
      border: 1px solid var(--border);
      padding: 3px 8px;
      text-transform: uppercase;
    }

    /* prose 正文：衬线字体 + 行高 1.9 + 段落缩进 */
    .prose {
      font-family: 'Noto Serif SC', serif;
      color: var(--ink-2);
      font-size: 16px;
      line-height: 1.9;
    }
    .prose > p {
      margin: 0 0 1.2em;
      text-indent: 2em;
    }
    .prose > p:first-child {
      margin-top: 0;
    }
    .prose h1, .prose h2, .prose h3, .prose h4 {
      font-family: 'Noto Serif SC', serif;
      color: var(--ink);
      font-weight: 700;
      line-height: 1.4;
      margin: 1.6em 0 0.8em;
      text-indent: 0;
    }
    .prose h1 { font-size: 1.6em; }
    .prose h2 {
      font-size: 1.4em;
      border-bottom: 1.5px solid var(--ink);
      padding-bottom: 6px;
    }
    .prose h3 { font-size: 1.2em; }
    .prose h4 { font-size: 1.05em; }
    .prose a {
      color: var(--red);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .prose strong {
      color: var(--red-deep);
      font-weight: 700;
    }
    .prose em {
      color: var(--text-secondary);
      font-style: italic;
    }
    .prose blockquote {
      margin: 1.4em 0;
      padding: 12px 20px;
      background: var(--paper-2);
      border-left: 4px solid var(--red);
      color: var(--text-secondary);
      font-size: 0.95em;
      text-indent: 0;
    }
    .prose blockquote p {
      text-indent: 0;
      margin: 0;
    }
    .prose ul, .prose ol {
      margin: 1em 0;
      padding-left: 2em;
    }
    .prose li {
      margin-bottom: 0.4em;
      line-height: 1.9;
    }
    .prose code {
      font-family: 'IBM Plex Mono', monospace;
      background: var(--paper-2);
      color: var(--red-deep);
      padding: 1px 6px;
      font-size: 0.9em;
      border-radius: 2px;
    }
    .prose pre {
      background: var(--ink);
      color: var(--paper);
      padding: 16px 18px;
      border-radius: 2px;
      overflow-x: auto;
      font-size: 13px;
      font-family: 'IBM Plex Mono', monospace;
      line-height: 1.6;
      margin: 1.4em 0;
    }
    .prose pre code {
      background: transparent;
      color: inherit;
      padding: 0;
      font-size: inherit;
    }
    .prose img {
      display: block;
      max-width: 100%;
      height: auto;
      margin: 1.6em auto;
      border: 1.5px solid var(--border);
    }
    .prose hr {
      border: none;
      border-top: 1px dashed var(--border);
      margin: 2em 0;
    }
    .prose table {
      width: 100%;
      border-collapse: collapse;
      margin: 1.4em 0;
      font-size: 0.95em;
    }
    .prose th, .prose td {
      border: 1px solid var(--border);
      padding: 8px 12px;
      text-align: left;
    }
    .prose th {
      background: var(--paper-2);
      font-weight: 700;
      color: var(--ink);
    }

    /* 文章底部 */
    .article-foot {
      margin-top: 48px;
      padding-top: 28px;
      border-top: 1.5px dashed var(--border);
    }
    .article-foot-in {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 20px;
    }
    .article-foot-back {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 11px 22px;
      font-family: 'Noto Serif SC', serif;
      font-weight: 700;
      font-size: 13px;
      letter-spacing: 2px;
      text-decoration: none;
      border: 1.5px solid var(--ink);
      border-radius: 2px;
      cursor: pointer;
      background: transparent;
      color: var(--ink);
      transition: transform .2s, box-shadow .2s, background .2s, color .2s;
    }
    .btn-red {
      background: var(--red);
      color: var(--paper);
      box-shadow: 4px 4px 0 var(--ink);
    }
    .btn-red:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 var(--ink);
    }
    .btn-ghost {
      background: transparent;
      color: var(--ink);
    }
    .btn-ghost:hover {
      background: var(--ink);
      color: var(--paper);
    }

    @media (max-width: 640px) {
      .dossier-main { padding: 40px 16px 80px; }
      .article { padding: 32px 24px 28px; box-shadow: 5px 5px 0 var(--ink); }
      .brand small { display: none; }
      .article-foot-in, .article-foot-back { flex-direction: column; align-items: stretch; }
    }
  </style>

  <script is:client>
    (function() {
      const el = document.getElementById('today');
      if (!el) return;
      try {
        const now = new Date();
        const fmt = new Intl.DateTimeFormat('zh-CN', {
          timeZone: 'Asia/Shanghai',
          year: 'numeric', month: '2-digit', day: '2-digit',
          hour: '2-digit', minute: '2-digit', hour12: false
        });
        el.textContent = fmt.format(now).replace(/\//g, '.');
      } catch (e) {
        el.textContent = '——';
      }
    })();
  </script>
</BaseLayout>

<!-- JSON-LD: BlogPosting -->
<script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} is:inline />

<script define:vars={{ title: post.data.title }}>
  const pageUrl = window.location.origin + window.location.pathname;
  const shareTitle = title;

  document.getElementById('share-x')?.addEventListener('click', () => {
    const xUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareTitle)}&url=${encodeURIComponent(pageUrl)}`;
    window.open(xUrl, '_blank', 'width=550,height=420');
  });

  document.getElementById('share-weibo')?.addEventListener('click', () => {
    const weiboUrl = `https://service.weibo.com/share/share.php?title=${encodeURIComponent(shareTitle)}&url=${encodeURIComponent(pageUrl)}`;
    window.open(weiboUrl, '_blank', 'width=550,height=420');
  });

  // ==========================================
  // 复制到公众号 — 完整迁移自 Obsidian 插件
  // ==========================================

  const WECHAT_CSS = `
    .wechat-content {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif;
      font-size: 16px;
      color: #333;
      line-height: 1.75;
      text-align: left;
      padding: 20px 15px;
      max-width: 100%;
    }
    h1 {
      font-size: 28px;
      font-weight: 700;
      color: #1a1a1a;
      text-align: left;
      margin: 0 0 16px 0;
      line-height: 1.4;
    }
    h2 {
      font-size: 20px;
      font-weight: 600;
      color: #e8913c;
      margin: 32px 0 16px 0;
      padding-bottom: 8px;
      border-bottom: 2px solid #e8913c;
      line-height: 1.4;
    }
    h3 {
      font-size: 18px;
      font-weight: 600;
      color: #2eaadc;
      margin: 24px 0 12px 0;
      padding-bottom: 6px;
      border-bottom: 1px solid #2eaadc;
      line-height: 1.4;
    }
    p {
      text-align: justify;
      font-size: 16px;
      font-weight: 400;
      color: #333;
      margin: 0 0 20px 0;
      line-height: 1.9;
      text-indent: 0;
    }
    blockquote {
      margin: 20px 0;
      padding: 12px 16px;
      background: linear-gradient(135deg, #fff8f0 0%, #fff 100%);
      border-left: 4px solid #e8913c;
      color: #e8913c;
      font-size: 15px;
      font-weight: 500;
      line-height: 1.7;
    }
    blockquote p {
      margin: 0;
      color: #e8913c;
      font-weight: 500;
    }
    strong {
      color: #8b5cf6;
      font-weight: 600;
    }
    em {
      font-style: italic;
      color: #666;
    }
    a {
      color: #2eaadc;
      text-decoration: none;
      border-bottom: 1px solid #2eaadc;
    }
    ul, ol {
      margin: 16px 0;
      padding-left: 24px;
    }
    li {
      font-size: 16px;
      color: #333;
      line-height: 1.9;
      margin-bottom: 8px;
      word-break: normal;
      overflow-wrap: normal;
    }
    li > * {
      display: inline;
    }
    img {
      display: block;
      margin: 24px auto;
      max-width: 100%;
      height: auto;
      border-radius: 8px;
    }
    pre {
      background: #f8f9fa;
      padding: 16px;
      border-radius: 6px;
      overflow-x: auto;
      font-size: 14px;
      font-family: "SF Mono", Monaco, Consolas, monospace;
      line-height: 1.6;
      margin: 20px 0;
    }
    code {
      background: #f0f0f0;
      padding: 2px 6px;
      border-radius: 3px;
      font-size: 14px;
      font-family: "SF Mono", Monaco, Consolas, monospace;
      color: #d73a49;
    }
    pre code {
      background: transparent;
      padding: 0;
    }
    hr {
      border: none;
      border-top: 1px solid #eee;
      margin: 32px 0;
    }
    .wechat-callout {
      margin: 20px 0;
      border-left: 4px solid #773098;
      border-radius: 8px;
      overflow: hidden;
      background: #faf7fd;
    }
    .wechat-callout-title {
      padding: 10px 14px;
      font-size: 15px;
      font-weight: 700;
      line-height: 1.6;
      color: #5a3382;
      background: #f1e7fb;
    }
    .wechat-callout-body {
      padding: 12px 14px;
    }
    .wechat-callout-body p {
      margin: 0 0 12px 0;
      color: #333;
      font-weight: 400;
    }
    .wechat-callout-body p:last-child {
      margin-bottom: 0;
    }
    .wechat-callout-note     { border-left-color: #773098; background: #faf7fd; }
    .wechat-callout-note     .wechat-callout-title { color: #5a3382; background: #f1e7fb; }
    .wechat-callout-info     { border-left-color: #2eaadc; background: #f3fbff; }
    .wechat-callout-info     .wechat-callout-title { color: #1f7599; background: #dff4fd; }
    .wechat-callout-tip      { border-left-color: #2f9e44; background: #f3fcf5; }
    .wechat-callout-tip      .wechat-callout-title { color: #1f6d2f; background: #dff5e4; }
    .wechat-callout-question { border-left-color: #b7791f; background: #fffaf2; }
    .wechat-callout-question .wechat-callout-title { color: #8a5b17; background: #fcefd9; }
    .wechat-callout-warning  { border-left-color: #e8913c; background: #fff8f0; }
    .wechat-callout-warning  .wechat-callout-title { color: #b96f22; background: #fde9d4; }
    .wechat-callout-danger   { border-left-color: #e03131; background: #fff5f5; }
    .wechat-callout-danger   .wechat-callout-title { color: #b42323; background: #fde3e3; }
    .wechat-callout-example  { border-left-color: #0ca678; background: #f2fffb; }
    .wechat-callout-example  .wechat-callout-title { color: #087f5b; background: #d9f7ee; }
    .wechat-callout-quote    { border-left-color: #868e96; background: #f8f9fa; }
    .wechat-callout-quote    .wechat-callout-title { color: #495057; background: #e9ecef; }
  `;

  const CALLOUT_THEMES = {
    note:     { borderColor: '#773098', background: '#faf7fd', titleColor: '#5a3382' },
    info:     { borderColor: '#2eaadc', background: '#f3fbff', titleColor: '#1f7599' },
    tip:      { borderColor: '#2f9e44', background: '#f3fcf5', titleColor: '#1f6d2f' },
    question: { borderColor: '#b7791f', background: '#fffaf2', titleColor: '#8a5b17' },
    warning:  { borderColor: '#e8913c', background: '#fff8f0', titleColor: '#b96f22' },
    danger:   { borderColor: '#e03131', background: '#fff5f5', titleColor: '#b42323' },
    example:  { borderColor: '#0ca678', background: '#f2fffb', titleColor: '#087f5b' },
    quote:    { borderColor: '#868e96', background: '#f8f9fa', titleColor: '#495057' },
  };

  const CALLOUT_DEFAULT_TITLES = {
    note: 'Note', info: 'Info', tip: 'Tip', question: 'Question',
    warning: 'Warning', danger: 'Danger', example: 'Example', quote: 'Quote',
  };

  const CALLOUT_TYPE_MAP = {
    note: 'note', abstract: 'note', summary: 'note', tldr: 'note',
    info: 'info', todo: 'info',
    tip: 'tip', hint: 'tip', important: 'tip', success: 'tip', check: 'tip', done: 'tip',
    question: 'question', help: 'question', faq: 'question',
    warning: 'warning', caution: 'warning', attention: 'warning',
    failure: 'danger', fail: 'danger', missing: 'danger', danger: 'danger', error: 'danger', bug: 'danger',
    example: 'example', quote: 'quote',
  };

  function preventBreakAfterStrong(html) {
    let result = html;
    result = result.replace(/(<\/strong>)(<)/g, '$1﻿$2');
    result = result.replace(/(<\/b>)(<)/g, '$1﻿$2');
    result = result.replace(/(<\/span>)(<)/g, '$1﻿$2');
    result = result.replace(/(<\/strong>)(\s*)([：:])/g, '$1﻿$2$3');
    result = result.replace(/(<\/b>)(\s*)([：:])/g, '$1﻿$2$3');
    result = result.replace(/(<\/span>)(\s*)([：:])/g, '$1﻿$2$3');
    return result;
  }

  function transformCallouts(html) {
    const parser = new DOMParser();
    const doc = parser.parseFromString(html, 'text/html');
    const blockquotes = Array.from(doc.querySelectorAll('blockquote'));
    const headerRegex = /^\[!([a-zA-Z0-9_-]+)\]([+-])?\s*(.*)$/;

    for (const blockquote of blockquotes) {
      const firstParagraph = blockquote.querySelector('p');
      if (!firstParagraph) continue;

      const firstLineText = getFirstLineText(firstParagraph).trim();
      const match = firstLineText.match(headerRegex);
      if (!match) continue;

      const rawType = (match[1] || 'note').toLowerCase();
      const customTitle = (match[3] || '').trim();
      const calloutType = CALLOUT_TYPE_MAP[rawType] || 'note';
      const calloutTitle = customTitle || CALLOUT_DEFAULT_TITLES[calloutType] || 'Note';
      const theme = CALLOUT_THEMES[calloutType] || CALLOUT_THEMES.note;

      const firstBreak = getFirstBreakElement(firstParagraph);
      if (firstBreak) {
        while (firstParagraph.firstChild && firstParagraph.firstChild !== firstBreak) {
          firstParagraph.removeChild(firstParagraph.firstChild);
        }
        firstParagraph.removeChild(firstBreak);
      } else {
        firstParagraph.remove();
      }
      if (firstParagraph.isConnected && !firstParagraph.textContent?.trim()) {
        firstParagraph.remove();
      }

      const tableEl = doc.createElement('table');
      tableEl.style.cssText = 'width:100%;margin:20px 0;border-collapse:collapse;border-spacing:0';
      const tbodyEl = doc.createElement('tbody');
      const trEl = doc.createElement('tr');
      const tdEl = doc.createElement('td');
      tdEl.style.cssText = `border-left:4px solid ${theme.borderColor};background:${theme.background};padding:12px 16px;border-radius:8px`;

      const titleEl = doc.createElement('p');
      titleEl.style.cssText = 'margin:0 0 10px 0;color:' + theme.titleColor + ';font-size:15px;font-weight:700;line-height:1.6';
      titleEl.textContent = calloutTitle;
      tdEl.appendChild(titleEl);

      const bodyParagraphs = Array.from(blockquote.querySelectorAll('p'));
      for (let i = 0; i < bodyParagraphs.length; i++) {
        const p = bodyParagraphs[i];
        p.style.cssText = i < bodyParagraphs.length - 1
          ? 'margin:0 0 12px 0;color:#333;font-size:16px;font-weight:400;line-height:1.9'
          : 'margin:0;color:#333;font-size:16px;font-weight:400;line-height:1.9';
        tdEl.appendChild(p);
      }

      trEl.appendChild(tdEl);
      tbodyEl.appendChild(trEl);
      tableEl.appendChild(tbodyEl);
      blockquote.replaceWith(tableEl);
    }
    return doc.body.innerHTML;
  }

  function getFirstLineText(paragraph) {
    let firstLine = '';
    for (const node of Array.from(paragraph.childNodes)) {
      if (node.nodeType === Node.ELEMENT_NODE && node.tagName === 'BR') break;
      firstLine += node.textContent || '';
    }
    return firstLine;
  }

  function getFirstBreakElement(paragraph) {
    for (const node of Array.from(paragraph.childNodes)) {
      if (node.nodeType === Node.ELEMENT_NODE && node.tagName === 'BR') {
        return node;
      }
    }
    return null;
  }

  function inlineCSS(html) {
    const cssRules = WECHAT_CSS.match(/[^\{\}]+\{[^\}]*\}/g) || [];
    const styleMap = {};
    for (const rule of cssRules) {
      const colonIdx = rule.indexOf('{');
      const selector = rule.slice(0, colonIdx).trim();
      const declarations = rule.slice(colonIdx + 1, rule.length - 1);
      styleMap[selector] = declarations;
    }
    const parser = new DOMParser();
    const doc = parser.parseFromString(`<div>${html}</div>`, 'text/html');
    const container = doc.firstChild;
    for (const [selector, declarations] of Object.entries(styleMap)) {
      try {
        const elements = container.querySelectorAll(selector);
        for (const el of Array.from(elements)) {
          (el).style.cssText = declarations;
        }
      } catch {}
    }
    return container.innerHTML;
  }

  document.getElementById('copy-wechat')?.addEventListener('click', async () => {
    const btn = document.getElementById('copy-wechat');
    if (!btn) return;
    const originalHTML = btn.innerHTML;
    btn.textContent = '正在处理…';
    btn.disabled = true;
    try {
      const proseEl = document.querySelector('.prose');
      if (!proseEl) throw new Error('未找到文章内容');
      let html = proseEl.innerHTML;
      html = preventBreakAfterStrong(html);
      html = transformCallouts(html);
      html = inlineCSS(html);
      const fullHtml = `<div class="wechat-content" style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'PingFang SC','Microsoft YaHei',sans-serif;font-size:16px;color:#333;line-height:1.75;text-align:left;padding:20px 15px;max-width:100%"><h1 style="font-size:28px;font-weight:700;color:#1a1a1a;text-align:left;margin:0 0 16px 0;line-height:1.4">${shareTitle}</h1>${html}</div>`;
      if (navigator.clipboard && navigator.clipboard.write) {
        const blob = new Blob([fullHtml], { type: 'text/html' });
        await navigator.clipboard.write([new ClipboardItem({ 'text/html': blob })]);
      } else {
        const container = document.createElement('div');
        container.innerHTML = fullHtml;
        container.style.cssText = 'position:fixed;left:-9999px;top:0';
        document.body.appendChild(container);
        const range = document.createRange();
        range.selectNodeContents(container);
        window.getSelection()?.removeAllRanges();
        window.getSelection()?.addRange(range);
        document.execCommand('copy');
        document.body.removeChild(container);
      }
      btn.textContent = '✅ 已复制';
      setTimeout(() => { btn.innerHTML = originalHTML; btn.disabled = false; }, 2000);
    } catch (err) {
      console.error(err);
      btn.textContent = '❌ 失败';
      setTimeout(() => { btn.innerHTML = originalHTML; btn.disabled = false; }, 2000);
    }
  });
</script>
