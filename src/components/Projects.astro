---
const projects = [
  {
    title: "tk-obsidian-flomo",
    desc: "Obsidian 轻量级笔记捕获与回顾插件，灵感来自 Flomo 工作流：快速捕获、自然打标签、在清晰的时间线上回顾思考。",
    tag: "开源项目",
    icon: "📦",
    href: "https://github.com/tinyking/tk-obsidian-flomo",
  },
];
---

<section id="projects" class="section-padding">
  <div class="text-center mb-16">
    <span class="text-accent text-xs font-medium tracking-widest uppercase">
      精选作品
    </span>
    <h2 class="text-4xl font-medium mt-3">最近的项目</h2>
  </div>
  <div class="grid gap-6 md:grid-cols-2">
    {projects.map((p, i) => (
      <a
        key={i}
        href={p.href}
        target="_blank"
        rel="noopener noreferrer"
        class="group card-interactive p-8 flex flex-col gap-6"
      >
        <div class="w-full h-36 bg-gradient-to-br from-accent-light to-accent-lighter rounded-lg flex items-center justify-center text-4xl" aria-hidden="true">
          {p.icon}
        </div>
        <div class="flex-1">
          <h3 class="text-xl font-medium mb-2 group-hover:text-accent transition-colors">{p.title}</h3>
          <p class="text-ink-secondary mb-4">{p.desc}</p>
          <div class="flex gap-4 text-xs text-ink-tertiary">
            <span class="tag">{p.tag}</span>
            {p.href !== "#" && <span class="flex items-center gap-1">🔗 GitHub</span>}
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
